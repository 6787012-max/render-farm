ְלהעְמו׀–מד׀זילÞװױגךצױגּֽץטצזױטףג׀גßצןו־ך־םßעֽיףךסבדךÞקצגÊיףטףגßע־בזװײלֿעױזפָדךÞצֶןְסדÞנגאקֿעקוצזוזזד•ְהוˆ‘מזוצזץצזֻעזזךיועְדזז—ױטצזױךףזףמÝעÝיףטוְסִײˆ׃ָײְֹזזזצזזˆ׃זֱֹ־זזעזהצדס׀זגדצזױטףג׀גÞךֹיÝךןֹף׃־‏ףßֿˆ׃ּÿ–זזצזזˆׂצז׳ˆֿזזְזבּזיסזמדדעְאו׀ּאפזעזדפׁגל׀זױךףזÿבהך–ךֽעֹךßֶֹ׳”ָדכזפ‏ֿה׃Þמדגזזזמזזק‘זטׁˆÊצזםזוךזא—זטז׀ִבהֿםמד׀ָיהגְבזז—ױßהׁגגץמ’טצזßךוִעוÞִ•יףצֹךß‏ןבזִֹיֽע—םÝךנ‘——ֱק־װ”מֹ’טןÝ“ױיÞקדץףֳָכףךײיה—ׁץדװֳכףךײיה“זזזגזזקזזמÝˆְָזםזד‎זמבצמו׀ּמסזּאדצועז׀מלז׀ץעזצציוזִםהזעדזזֿכז׀ְילßדגגךצץטףּ’זהװצßהׁגלצױךףזףד׀ג–יÞִˆזץעןֽהי׳ףע—ֶֽעו“פלְ–ןֿמ׳דְזזזצזזז׳ּזֵזי—זזּזהצהפזעזדפׁגזדג׀גßצןמÝ‏–יהִ”בÊ׀ּי־װןעהףגױךפ׀Þכß—’זזמזזזל‎זצךדֹצזקזוװזלּז‎זּֿגסוךלדסצ‎וזָקאצזקדצםמגז—יפזִנדפװױßומ’זדˆגלÞװץגּֽßךזגןם׀‏ֽמ־‏–יד‏Ýךֿ‏סבזִֹיה‏ֽמְ‏סבו‏Ýךֽ‏וזßֿגאÞךׂטÝ—װכד—עגהְֳןפְָןץ—ָזױזÿץץעכ־׀ק־׀ֽאÝ“ֳםÞֳִןפְָזזזוזזד׃׀הˆ‘מזבצזֹצו׳נוזיבץבמזוצלפזְלהעְמדצ–מוצמיפוגזדפװױלÞװױגּֽזלÝג׀בßצןבפך–כְגזףךעוֿעעךÝמ–יה‏–ך–לל־ז׳לְמßקזמײ׳—ָףץעעםךÞבםוץלף—ָםמְְזזזגזזזל‎זם—דÿצזבזזׂ—ז–ִזוז—זלÝּßךוךֽםÝִÝו’—‏Êג‏צל‎‏Êם־זזגזזזל‎זמגד‏ְזבזובזהסצזז׀—בפזךזדפװ’זהװßךוךֽיףך–ך“אוסÞָהÊפײֱזזזוזלˆ’זבסˆ‘מזה׀ז‏צז’עזזװיפזעגהְעןפזמןדפװצßהװזלÝג׀זפמ–ידִÝוֿעעבß‏ÝזסנÊז־װהמÞז“ˆׂפײהז׀םאףֳִןזזזזֱֲזײצזזזך”זוזי—זֱןֿךֳהז“דסזְףדצע‏סזך‏דצ—ֳדֿ“ֵדְ׃מגזװיפוװזדפװױגךצצßוג’טצזױגךצױגךצצßומ’ךףזץבז‏ֽמ־ִׂזפך־וֿעעב׀ִÊיףצ•ךÝמÿןְגÝךֽ‏–יהִ”ב־װֱמßָפלוְפאו“כך־ֱָמßָףלוִפאו“כך׀כ׃ןÞֲָאÝָ‏גֿ—כןßִ׀ןÞװֲןדָ‏גֿ׀ךןßְזזְזזזײצזצטסזזװזב׀ז‎צוועד׀ּיסזךסדעְאגְ–מדזזילÞװזלÞװßךוךעו־ך־םֽע—יֽךÞבְִ—ם־ך־וֿעעבֽךÞיׁבאךÝםאץףךÝץ־גÝםפעÞךÞצֻך׀ךִך—סאךֽיאץֽךֻיÝִֻםדִ•זזמזזק‘Ýזבףˆְָזכזוִזא—זץסְסדס‏דהצ–לגְ׀םגָּאזז—ױßהװזלÞװßךוִעו־ך־םֽע—יֽךÞבֿעעו־ך־םֽע—יֽךÞבֻצ‏גֿמ‏אומפאוְפגְֿ‎גץמ‏ֿßמ‏אומץאוֲׂגְֿ‏גֿג‎אזזבזזדß׀בָˆ‘מזה׀זÿזהךזכ׀זזלא“זדְױְׂז‏זו“זטÞׂ“זוְצׂזזז—כְזזהווצדֶזו“ז‘ְזֲזזםֳצץװזהצזֲזוּזןְז׳זו“זטצזֲזגּזןְו‎זו“זֶצזֲזןּזןְהםזו“זÊצזֲזלּזןְה’זו“זÞצזֲזז–ֳׂזזֲגכְזו׃ה“זוְצׂזז”זה“זוװְׁׂזםזזךזטÞׂ“זזּצׂזזדגכְזדה“זזּצׂזזס—כְזזßה“זהֱצׂזזםגכְזכֳז׀ךצעעו־ך־םֽע—יֽךÞבְִעו־ך־םֽע—יֽךÞבִֿעו־ך־םֽע—יֽךÞב־עעו־ך־םֽע—יֽךÞבִֿעו־ך־םֽע—יֽךÞבְבָאומפאץּפגץÊהאומץאץְפגֿ־ואומפאוּץגֽֿץְפגְֿ‏גֿמ‏פץְפגֶּֿגץמ‏ֿßמ‏אומפבßְץגְֿ‎גץג‏אםּפאוְפגץּ‏ֳֿמ‏אומץאוֲאגְֿ‏גֿגֶאצזדזזדß׀בֵˆ‘מזה׀זÿזוװזךעזֱאצךֶסוװ‏הֿװםסְסדס‏דהצ—ֵפßּ‏דעָפדזּפפְ‏זדפׁגלÞװ’זהװױגךצױטץג’ךףזבבז‏ֽמ־‏–יד‏Ýךֿ‏ןבז‏ֽמ־‏–יד‏Ýךֿ‏ֹמÝעÝזסװ‏גֿמ‎אץמץאצג‏גֿמ‏אץגפאם•ׁ‏ִפאוְפגִֿ‏Êץמ‏אומץאץֿֿיצזזז׀זזˆװִונˆ־זזװזב׀זײזגֳזכפזסדÞֻעל־ְלסהָ‏ה־ָםסְסדס‏דהצ—‏ןפָפאעְÊאְּÊפהִ‎דעָפדזּפפְ‏זדפׁגלÞׁגלßגפטףּ’זהװױגךצױלÝּץגּֽßךזעעו־ך־םֽע—יֽךÞבְִעו־ך־םֽע—יֽךÞב־ִֽוßצנבץצאמÞמÊיףצ•יפִֽיףךונßְפגּֿ‎גֿג‎זץְפגְֿ‎גץמ‏ֹע—דאßְפגץְֵז—•ֿßמ‏אומפבß־‎גְֿ‏גֿג‎אאג׃הÞִלגְֿ‏גְ׀ֻהÞ—–זזזוזזדˆף׀ועˆ‘מזה׀זט׃–‏דהצ–לוְזיל׀זױךףזÿבז‏ֽמ־‏–יד‏Ýךֿ‎עאומפאוְפגֿ־ןגְֿ‏גֿג‏ב׀זזזְזזˆ—ז”ק־זזװזב׀זֳצוםנבצלבצֻנז׀ּיפֿמךדעָאזז—ױל׀זױגךצױךףזÿבז‏ֽמ־‏–יד‏Ýךֿ‏ןבז‏ֽמ־‏–יד‏Ýךִֵֿאומץאץְפגֿ־מאומפאוְפגֿ־ןגְֿ‎גץג‏אוגפאוְפגץְÿזזזדזזד•׀דÊˆ‘מזה׀זÿזהךזמּזנסֿװֿדס‏סד׀ָסהס‏דהצ–זןְ׀טצז‏‏ד־װױזהװצßהװױךףזÿבז‏ֽמ־‏–יד‏Ýךֿ‏ןבז‏ֽמ־‏–יד‏Ýךֿ‏ÿבז‏ֽמ־‏–יד‏ÝךֵֿÊאומץאץְפגֿ־פאומפאוְפגֿֿםאומפאץָץגֿ־ןגְֿ‎גץג‏אוגפאוְפגץְÿֿֿמ‏אומץאּֿזזזגזזקּזכ”ˆÊצזדזויזהְםעזזךיז—װוזז—ױטצזױטףג׀בÞך–ך•ׁ‎׀–זזגזזקץזכ”ˆÊצזפזו–זגֿבעגֿזלסזזפדעְטזְּטפזודפׁגל׀זױלÝּßךוִֽוßצנבץצאמÞמÊיףצ•יפִֽיףטףצךֵאומץאוװדףֵ•ִכצװֹהֿמ‏אומךםצװ׃יצזוˆ‘׀הֿ׀זזז׃װזה׀זט׃–‏דהצ–לוְזיל׀זױךףזץבז‏ֽמ־‏–יד‏Ýךֿ‏‏גֿמ‏אץגפאזלßגְֿ‏גֿג‎אזזזז׀זזˆּׁוןק־זזװזב׀זֽזז“זגמױזכְזאÞ“זזּׁךדגÿבז‏ֽמ־‏–יד‏Ýךֿ‏ÿבז‏ֽמ־‏–יד‏Ýךֿ‏ÿבז‏ֽמ־‏–יד‏Ýךֿ‎עאומפאוְפגֿֿÊאֿמץאוִפגֿ׳־אֿגפאוְפגֿÊןגְֿ‏גֿג‏בÝ—פאוְפגְֿ‏קץג‎אומפאץּזזצזזזיזְֵביזזװזדױֳנז׀ּיפְ‏זדפװזלÝג׀גßצאמÞמÊיףצ•ךÝמנֵ־זÿבÞזְבßְִזץ‏ÿמהזÿבÞזְזזגזזקֶזהױˆְָזדזויזהְםזזזךטז—ְוזז—ױטצזױטףג׀גÞך–ךÞָײלׁֶÞזזזזצזיזֵ“וע׀םוזזךזהצדס׀גזדצזױטףג׀זצִֿי׀בףיקׂטצםוְ“ךזזזגזזזלּזצצה•ְזדזויזהְםעזזךיז—זוזז“ױטצזױטףג׀זפג–מצגגˆׁ׀ווזלּיְזוזאףˆÊצהצז׳גזז׀זט׃ְמץז—ְוזז—ױטצזˆךףזÿמßגÝּה׀װ‎׀כ“זזגזױ׀לןזצךה•׀זכזז‘”סְךםדעָאזז—ױזהװßךזגעו־ך־םֽע—יֽךÞבְגדאומפאוּץגְֿהװץמ‏אומץאץְזזזןˆױזלןזזזה•׀זכזז‘”סְךםדעָאזז—ױזהװßךוגעו־ך־םֽע—יֽךÞבְֿפגְֿ‎גץמ‏זױגפאוְפגץּ‏זזזהזז”ˆ‘צדלזֱָזז׀זןזזךזךףזףוÞִ”ג׀ִֹי׳ְנֻ׳ְ‏ב–ֳז‎׃־‏אןעÊיֿ‏זזזזצזזזִָזסזכֵזזװזדױֳנז׀ּיפְ‏זדפװזלÝג׀גßצאמÞמÊיףצ•ךÝמנסוְפגְֿ‎גץמ‏זױגפאוְפגץּ‏זזגזדֱˆ׳זֲ‏דכְז“זבßזיזעאד׀“דכדךײם־‏ָס׀“Ýדפְצז׀ְבהצָÞןפזּמֿגײךזָÞבְּײםזָײאֿ׳למו‏םפהזץדעְלזז—ױלÞׁגגךצױגךצץטץגפטץגפטץגפטףּזקÝױגךצצßוג’גץמ’טףּßךזגעוְִÊיץצ”יֽ—ויהִÊל׀גאבץצֱזץ‏סבזִאוÞמÊיף‏–גÝצ”םֽע—יÝ‏ÝךִֿנבÝ‏”בִֿאוÝךÞבß‏ÿבְןÊְִּֽול—ׂבודׂז׀צÿוְ‏‎ך׀ּכד׀גÿקץ“ןוְװבוÞבד‏דג‏ֳֻÿנךÞג‏ה׀ְוכ—כÿן׀‏ֱווֶֿֿץßֹכץצ’וועֳֹהֱּאצ“מזְםןִֿוץֿ“ױוÝ‏ֽÿְעאמץלעעְָװכָּ–לדװ׃זזגזדֱˆÊז‎הְְזׁזד׃זםבִִם׀–ÿדזָלדז’ÿהז“יבßָּלצזפפוּדפִֶפה׀ֶה־׀עפץמזדפׁגßהװצßהװץגּֽץגּֽזלßדגלÞװßךהעעד׀גטזצִאמÞמֹיִֽנךÝמ”יֽע—כ׀גÊיףצ•יףצױזפמ–ידהבß‏זףמסבז‏סבוִנז‎ׁצץגָטףזֽךפ׀ךןְּלנדÝודּצמÝßנְעÿדֿזיק׳ֿטךד׀ץ’—ג—פץמֳה׀ּלפדךדאוצ‎הְֳ־ןו‏יי׀ֱּקץמעÿְךדקְֽנסזל‏ֿ׀זזצזכˆ׀ויְםזהמזאגזיוֻצגאז—ךז׀ְ־פזךזדפװ’זדˆגלÝּßךהעעו־ך–ם־ך־ד׀גאו׀‏ׁזפ‏ˆזף‏ˆזף‏ÝךִֿÊםÞ“וםÝ‏”ןְגסזף‏ֿהßגטדצצ׳הְ“פהÊװןזצצ‏וה“ףל׀ֿײהצגכט•“ץךסֻקדְָצְִֻם‎ץּטגזמנו׀ךכהְ׃ׂכֿ׳’הּ’נךגִ׃מ”‎ְזזגזדקˆ׳ז‏׀הְֳזֳזהסזבץּסס׀“ִדץעÿגזְךפוך‎דצמזפְ׀זדפװצßהװץטצזˆßהװצßדג׀זץצןז׀‏ֽמ־‏–יוך•יףצױזפמֹםֽע—יÝ‏Ýךִֿעט׀גÞז‏׀ןּוְׂגֿ־־ה־Þױםֿגÿאְצלהְ‏ß•דהדßזסˆּֿםאץמאזסגסבפּםדפצױעזךדךְזזזְזםˆּו”צם’זוָזכְוהצהְֽהÞװ׃ווצפס׀װÿדסצגכצ—פגז‏ֵהץץמםפגלםעְֹן׀ָֹבגְטבז–מהצזילÞװצßהׁגלßגפטףּזקÞװױגךצץגּֽץטףג׀זץצןוְִ־יףִ•יףצױזפמ–ידִ•ךÝמÿבֽװוךִֿנזץצןםֽע—יÝ‏”ךִֿאבץצÿבֽך•יß‏ו”צװץיֽמהףמֲ—עßּבו׀ָגדףֽׂÿÞ“‎ˆׁֱ׃וךגדזּכז־צֹפזצאזצבסÿÞככהָךפףׂ—ץÞֿםז׀ך–‎דֽװף—׀בִז•פְמהווצקפ־ָ׃זצג־זזזוזז”ˆ’׀דֽזֹװזדצזץצזֻÿו׀ּידעּהזז—ױטצזױךףז”וְִ–יהִÊםÝצ”בִֿנבֲךִכזֶֶָֽיֻםץּסם׀ֲ’Ê־סֽא–ֳןן•םדְזזזזצזךˆˆזז’ְלכזהגזבעזלמוץא׀עטפומבדפׁגגךצזקצßךוךאד׀גאבץובֿעעוְִאמÞִ•קצג—םÞ‏ֹםֽע—ק׀ג•יÝ‏ÝבßֵÊהוץצאז“ֶדָֿעהֿךףהֿמכהßזֵף׀ָבהזִצכצמודִֿ’גץצׂסה—ֹםÊךֱגזצÊצןֻלקהמֿךץמÊבדװןלְ‏ביזזוזז”ˆ‘צןÊזָגזכ׀זÞצו—ֽםסִכלְ—ֻגזצאוßךֱב׀׀טב—ֳָג׀ֻמןצ“יפזִזדפװױלצצßומ’גץמ’טצזˆלßדגךףזובזִÊיף‏זףצֹם־װווֿעען׀גנבץצןוְִ־םֽע•יץך—יÞ‏–ידִ•ךÝמÿבֽװוךִֿנבß‏ו’׳ךß־פ“עגט“דווִאוּֿÝהצװקזץִןְִאה׀עקט׃‏Ýמץְכהזגֳִׁךיכָץגןא‏ׂבדּגבץ•ִלץ‎דֽװְהזֲּב׀באן־װןי־יֲוצ‏‘יפְכצזזזצזיˆ‏הטצםֵזדצזץּזױכהֶָכÝבÿלֽגיס׀‏ֲהסִמאְּםהßךמהז‏מבÞ—Êאֿעיפזֶהצמדצּיפה‏זדפװױßהװצßוגפטףּזקÝˆßהװױלßדגגץמ’ךףזובזִאו׀‏ֽמ־ִןו־ך־םÝ‏–יהִÊםÝ‏”בֿעןוֿעÞבß‏Ýךֽ‏”קְג”יֽע—םÞ‏ֽמְִֹיִֽ•ךÝמÿבְמ’לÞ’דפאְכךְָןדצװםהוךִפֿבטÿזְגהֿ—‎דֿס־גו‏Ýדוִ׀אף‏׃לזִֽלץעְסו“ּז‏ßÝ‏ÊֹּלְסאוְסײֲÊßזÿ־ֳÿידל׳ּדָ׀ז׀ךטוְְׁבפ׳בץוִךגצ–ִךְ‏ßטְזזזצזךזל׀ז’זלבזועזכגז‏גץוזוץזטוץגךהץךףגוזץפצ׀ץדצםםו׀זילצױגךצצßודגגץמ’זהװצßדג׀גßצןו־ךֹיֽע—כ׀גÊיףצˆזץִןבוובׂץףגßִעצוִֻגֽמקד׀מצÿו“וֹÞֲדְפ‏גץףץצ—ֳכב׀דז׀װֳדע׀‎זזגזדׁְזÿװהֲצזײזדֿזמהצֻמ–ֲִלז—ֽגוזֲםץ׀בבהצֲפהגֻדץ“ÿפֿצלהץץםב׀עילצױגךצױגףּץגּֽץגּֽזקÞװצßדּßךזגעד׀גאבץצֱזץ‏סבזִאמÞמ–בדִ•יףצÊיףצˆזף‏–יהװומֽע—יÝךןבדװוךֿ‏וֲ׀װÿדְצפו־׀‏דצ—בוְּךדְְ־׳ִֻֿא׀ג—׀וֻּזְ“טלֻּ—ךצֹֽדצ‏סÞ‏ד׀צׂט־עװװפ׀׀םפ‏‏דß׃ןבאזןךץװזזצזםˆ׀וֹצלזזהצזןעזץדזָבסßמֿדסִבהְ—ִגגְצזז—ױזדױלßגפטףג׀זץצאו׀‏ֽיה‏–ידִנךÝמ”יֽע—ל׀ג־םÞ‏–יֽויֽךÞבß‏זףמÿבְאֳֿÿבהנזצÿמצײזסעוװֳ־ךֵמְגואְמםה׀‏סלאסÿלÞךונןֲ‘םץ‏ןןזִ“ךזבאיעלגדֿגְהז‎ױהְִ“ףף“זזצזךˆָוְֱיךזהְזך—זְסßעֻדס‏ֶןצ–ÿוצּםוסִדה׀—‎מßְֿדÞעֽפוְֽדעְקזז—ױלßדגגףּץגּֽזלצױלÞװßךזגעו־ך־םÞ‏–ידִנךÝמ”יֽע—םÞ‏ֹם־ִÊק׀ג•כ׀ג—יß‏ÿבֿעאבץצÿבִֿנזÿ‘ְְצװהֿז׃ןסּץÞזֳצפֳןםצמעזֽצדאףצעא־גוֳעֳנזעטָװצצָןו—ההמײע—גֽן׀מג׀“פ“ßְטגÞע־וֿזעךדבלוץ—ֳקעָזזזמזבˆˆ•זְ׀הְֿזֵזהְזץעזײמ־בÿוהִםסß‏ֿהֿךץס׀װנדץגצוזְיד׀ֵּזו׀ֳה—ְקג׀—כםגּםםז–מןצזילÞװצßהװץגּֽץטץגפטצזˆקÞװצßהװױגףּßךזגעו׀‏ױזפמֹםֽע—יÞמ–ידִ•ךÝמÿבו‏זףמÿבֿעןיףצֹם־װווֿעעבֽךÞזְ׀צÿצÿִּזנְֻÿהזּמוÞְ‎’במִלףװֶמדֲסאֲֳ׳ְגכֲג׃פףעֿÝִבודגאאוּֿÊץÊסֱיצגכÝָװף––׃זזגזדֱˆֳזְ׀הֳזזװזהסזב־‏םסßג׳דס‏אהצ—ןדץךּפפזףדעְיזז—ױלצץגּֽזלÞװפטףג׀זץצןוְִאמÞִ—יÝ‏”יֽע—םÞ‏ֽמְִעו׀‏ױזפִ—יÝ“ויÝ‏–יהִ•יß‏סיÝ‏Ýךִֿנזְ׀ךאגוןף׀גֶץÝז•קדמׁצעצצמÊְךזßָפםזּפֶÞבקך—‏־טÞעֱֳצגקלה׳פק—‏ּכוװכלה–גְÞְֿצ‘‎ץײֿ—”אוזֽאה’ק‎ן׳לט–׃•ֲֽ׀‎ÿְזוזזֹˆֵ׀דלז׳ִזמ׀ז׃צוֱּןץגךאְ“פד—ֱּאְֱָד׀ָספצמהצמבצצילצױגךצצßהװפטףּפטצזˆßדג׀גßצןוֿעֱזץ‏סבזִ־םÝ‏זפִÊבףצ•יףצÊםÞ‏–ידוךִֿען׀גנÞֿװÿזß‏היץ׀ךגְ—דםףִָןֿך־גצִץץוהגצֳֿעÞֳ—ßעֹעףװקקד‏פ׀Þ—םץנדגפזקבץ׀ÿלגִלםְּֽגזזזזצזיˆװוג׀םזוװזא—זצהצ׃ÿאוצלס׀צכדץְצפוזזדפװזקÞװױגףּßךזגעו׀‏ױזפ‏–ידִנךÝמ”קְג–יהִÊמÞ‏–ידִנבß‏וגÝגְֱךדÞךקןוִÊקו—ּ‎ְעÿִפ׀ָזפׂמעÊ‏Ýןהע׀הצװצעהֳױלÝעץמדִ׀הֻבלזזזהזזˆׂ׀מדזָ‏זמזזׂזג׳זכצ‏גמÞץÿוה׀םסÞצֲדץִֵאßּצהץךגהזִֿוֿמָפוִֵהעְצלזּצבßֳמדצ‏יפהגזדפװױßודגלÞװץטץגפטצזˆקÝˆגגךצױלßג’גףּßךזגעו׀‏ֽמ־ִÿו־ך־םÝ‏–יה‏–ידִÊיףצˆזף‏Ýךִֿעבֽװוךְך—ל׀ג־ו׀‏סבוִנךÝמ•זְךˆץנהוצֿמנגֿגקדְ׀ּקְִפוְָםופְ‏’׳ְֲ’׀ßאומ’יסװ–ֳזגכ‎בסִען—טגדצßןÿךֳֹּךעכצְ־ס׀‏אאהֱ׀ֵ׀ÝםÝֳ‎ךפ–ִזזזוזזÝˆ“זמֵזֹךזםצזװצוָ‏דסִֽמצָףמ׀—כס׀ִכדפךצמץ–םדץְיפץ—זדפװױגףּזקÞװצßודגלßג’ךףזובז‏ןוְִאופ‏–ידִÞיÞ‏ֹם־ִ•יßִנןצגףיÝ‏”יֽע—םÞ‏ֽידֲִזצמֵטו‏ֳלסÿץִֶטבמקבֿ–גהףִ׳ק־בטצהִ׃מ־סִיבסֿזֶ׳ײÊהצÞאÝֲּםֿ“ֽלוא׀צס‏‏סגזץאּ’ֽˆׁךטדהִׂךֻ—ֹלּ’כה•ְזזצזיˆ•גוײְםֲזדצזףגזׂסÝזֱהֳִֻךז–נןדךידßצֿגָֿףבִֻֿבהגױפפּֿדףךֶפֿךםהץךעפצ‏עהְ‏גפוָגדפװצßהװצßהװצßהׁגגץמ’טףּץגּֽץגּֽזלÞװױךףזובזִאבץצֱזץ‏סבזִאמÞמ–ידִ•כ׀ג—םÝע—יֽע—כ׀גÊמÞמסבוִנב׀‏ןםֽע—ק׀ג•יÝ‏Ýבֿובְאײופִגב׀מ—דז׀ץוְ‏והצגֻצֹךץהּך׀ן—‏םם‘ּףצֿ׀צןפמצה‏ְזְצפג’צ–דפה’ג־ֳ‏ךְ׀ֶג־ּÊמׁצדהז׀ֲ‏׀—Êדßװגֵףװָאֿ–זםÝ־פץוß־לץזִזְג־ד׀זוזזֹˆ‘׀א–זֹּזךזוכצה—פאץגמל־ֿÿגפ“יס׀עמהסִדהְּדופְצוצְÿדֿצֱאעְֽלְּֽןוּעפץ׀עדעְטזז—ױלßדגגךצױגףּץגּֽזקÝצßהװױלßדגגץמ’טףג׀זץצאמÞמׁזףצ”בֽךÞיÝ‏–יה‏ױזצ‏סבוווְִֹםֽע—ק׀ג־םÞ‏–ידויִֽÞבß“וט׀גÞבְא–ׁ’מָכְעֲטְÿד׳זל”װֹג־“ףטפֶָהֽצִאו—וןזצמהְעןןו’ßסא‏וץ‎ןםהה‏ßלְֻ‎טגָװףה‏ץדץך׀עצָײאֿ—צגֻךדָֿגון׀הזצךֱבָ‏זזזגזדקװז‏ךהֻ׀ז־זדיזןÞמֵס׀ךְדץװץדץםםאו׀יהֿ‎םהזלהזימוץמלועְנז׀—ױßהװצßהװצßהװץטצזˆלßג’ךףזוו׀‏ֽוֿעעבֿעעד׀ג־םÝ‏–יה‏–ידִ•יÞ‏–ידובßצÿבֽךÞי׀אדךפבװאß׀–ד׀םדזִכוץÊךהוֱִלהמ׀פ–“הÿÊבהִּֿ—Ýףץֶך׀מךץָֽײ׳־ּ–ךץץצגעְךן–ְוכּֿניְזזזצזלˆִוץ׀ךֽזהךזםּזסהזצףגצִÿאִֻץאְ–ÿוזִיןְומדְזילßדגזהװױגךצץגּֽפטףג׀זץצןו־ךֹידִÿךִֽ•יÝ‏–יה‏ֽמְִÊיףצ”יֽךÿיִֽÞב׀‏ןבִֿנזעֳ‏ÿ‏מהאץוןטÞג‏א•בךםה׀אבִֿטא—בץיֻֿװעא׃םְגֳֳ––־גע“Þז־ְנמÞִּףבָץםוזßצְעוֳּװ־ץאעּעּ‏זזְזיˆ•׀ו•זם’זוָזךזוסצדמעגßִ׳דְְּובִטב׀–סוזְםגßזגהז‏כאÞמֹגÞֵָכזםםÞ“םם—ּּא׀ּּדßץמגßציפצװזדפװױגךףגלצױגףּץטץגפטץגפטצזˆקÞװױגךצץגּֽץגּֽßךזגעו׀‏ןםֽע—יÝ“ויףצÊל׀ג־יףצ”ךßצזףמÿבְגעו׀“ומÞמֹיֽע—םֽע—יßִאבץצֱזץ‏ו•אע“ץְצצף—ע׀ןׂכאß׀—ףּ־לׁ‘׀ןְצפגֿגןדצִׂגְְןבְךוצ•Êטףְְכגץָסג“צ”עבˆדÊ““לףקדÝְ—וßעךנÞצָָפֿעךצּ‎מז—‘׃ֿ—זזצזטˆˆךוֹצם’זוּזן—זפגֿבÿדו‏יגץזאהְּץגְ–מהְזילÞװץטצזˆלßג’ךףזובזִאוÞ‏–ידִ•יףצױזפמ–ידִÝבו‏זףמÿבְאֳלֽב־םזאײֶ‎וְאץ—‏ןֹßעכפ‏ו‎ןֳֵֻהֶם׀ךפקֵאןקץֳֹםוץבט׀זוזז”ˆְִןֱזָגזל׀וֿצדִסבוְÿמהמגלהוÿופגםאֿץÿמוִיבוזבהזצמהפְְדץגקהßזֵל־ְֿמזעÊפהְײדעְְגצְָוצ׃מגזעילצצßהװױטץגפטץגפטץגפטץמ’גץמ’זדˆקÞװצßהװץטץג’גץמ’גףּßךהעעו׀‏קזץ‏ÿבִֿאוÞ‏–יד‏ֹזÞ‏ֹיÝךעט׀גÞיßִןדְגױזץגÝךִֽ•יףצֹבִֿנזֳ’ינ•לז׀גבדוךּגזִוהְצÝסץ‎טֱגֱָאֿ“עטדÞ־ְע׀ׁיְגֵבזכ•ִד‘וְִײהץ׀עןְ—‏םז“גזבוְֳÞװטגזעעÝִֻˆװעֿםעּגן׀ִטה׀זזזצזםˆּו”׀םˆזדצזע—זßווּיםß—װכ־װֹדבִ‎ןצֻÿדדגילßז‎גְ‏םבעְׂלצָֹמה“קאפסלמועםמזמםציפזּזדפװױגךצױגךצצßודגלßגפטצזˆקÞװױגךצצßדּץגּֽפטףג׀זץ