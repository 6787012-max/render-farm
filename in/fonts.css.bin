‏סבו‏נך׀קבבוכדגצּ“ֹס’װ׳–׃”•’נ•ֳנ’דֶֽׂֵךץֲכסÊˆֹבׁעונ‏ָלָ׀ÿגלÝֲפָצם—ָפסנפנÿטְעס‎ִֽפקכּעÿסאֳֽׁ“מ‏ה–ללוֻ‏Ýסעךֱˆˆזא”ˆזקױוְזזמְןקֵצזזמְובזזזוז׀אßון׀זזזה‏צז׀׳זצ‏בו׀עדז׀זאזּ׳כװהיצנגז—זזִמוזְןון“זז׀מוזְךוְֱזוזזעאזצסÊהְגמההֳכזזמהובזוזצ׀פ׀ּווְ‏זÿ׀זזזה“זףו׃זךצָוהזִמְ׀זןוזֲדזזךהזצמדזÿ“זזצזבוְגב‎ְזהזְץֱזזצגךגװםזצ‏אזבזזזזׂזגß‎צוִÝךÞ‏ÊךÝ‏Ýיֽע—םֽמÊךפּֽגÞךÊלצװמםפׁˆˆ׀ו׃ˆ׀ד‘׀‏זזהמוÝ•—זזהמזץצזזזצמו׃נ—זזלוזגדעוו׀ּ׳זצ‏בו׀עדז׀זאז—׳כװהיצנגז–הזװהו׀ּגהצִגְֱזדזְגהז׀בזזגזוצ‏וונעזהצֹּפ׀זהזְץֱזזצגךגװלזצ‏אזבזזזזׂזג׀ֵצדמזהצִםְ׀ְכזְִגו“ךזז׀מוזְךוְֱזוזזעאזצסֻזזמהובזוזצ׀פ׀ָווְ‏זÿ׀זזזה“זףבֻזאףצÝם־‏‘טףִ•ךÝװ—טÞ‏Þםֽג׳מßךֽם־ּךההעױזזדˆˆ׀ו׃ˆ׀ד‘׀ÿאזהמוÝ•—זזהמזץצזזזצךו׃ְהֱזזזז‏ּוֱלצגאוצִבז׀ךזוְםלזזךהזצמדזÿ“זזצזבוְגב‎צּוו׀ִמÿ׀—לדזךמהה–כזזמהובזוזצ׀פ׀װווְ‏זÿ׀זזזה“זףדˆךÝךÊםֽלק—ֻבצÝךךÝ—’יÞ‏Þםֽג׳מßךֽם־ּטההעױזזדˆˆ׀ו׃ˆ׀ד‘׀‏זזהמוÝ•—זזהמזץצזזזצךוװזץÿזזזזּ—זךלצגאוצִבז׀ךזוְםלפזֽעבֿזךצָוהזִגו׀ְגְֱזוזזעאזצסֻזזמהובזוזצ׀פ׀זדז׀ֳֳזזִןם—װםזצ‏אזבזזזזׂזג׀ֵצהלזצְןוזִמון“זו׀זדזצִד‎צזוזזעאזצסֻזזמהובזוזצ׀פ׀ּווְ‏זÿ׀זזזה“זףבֻזבÝךÝם־‏Ýיֽך•יףצÊך־‏ßלפךףמÞ‏׳ה׀ְֻל׀דˆˆ׀ו׃ˆ׀ד‘׀‎ֵזהמוÝ•—זזהמזץצזזזצִוׂצד–זזװז‎ּוֽלצגאוצִבז׀ךזוְםלזזךהזצמדזÿ“ךזצְזהצָמהנִיזצָזו׀צלו•ִזזצזבוְגב‎צזהזְץֱזזצגךגװכזצ‏אזבזזזזׂזגßדצÝךÝם־‎דף—יטפעִÝצֽיוטÝּÊך־‏ßלפךףמÞ‏׳דְְֻל׀זזˆˆזֱֵˆװזװבזז־זִ׃זזז־זגעזזזגןזֵמגנ׀זגזכיזגפּווְעןוצךדזז‏הפּ’יזְ׳מפזֽעבֿזטצזדזְגהז׀בזזװםזצִגה׀ֳֹזזגזוצ‏וונעזהזְלÿ׀זלה־ֳכזזמהובזוזצ׀פ׀׀ווְ‏זÿ׀זזזה“זףו׃זצזזםו׀צןהצץזזךהזצמדזÿ“זה׀זןהצװן‎׀זוזזעאזצסֻזזְמהֻזהְָֹפ׀זהזְץֱזזצגךגװךזצ‏אזבזזזזׂזגß‎צוּÊםּ׃םץעיזקÝ—יÝעÊך־‏ßלפךףמÞ‏׳דצְֻל׀זזז׀וטˆװאֱצץקזדמזט׀וןזגזףהװּמ׀ךגוף“צהצךוזזָוזְגדפְּווזָוזזגגזאעמזצעבוֻןזצ‏אךגװךה׀מוזצםֱז׀גהז־“הףד׀קגִץּגˆטÝָÊםהִֽםפצÊמßזיהו—ױזפגֲזֽךÞיֽ‏”ב׀‏אמÞמÊם׀‏אמÞמÊםֽע—יֽךÝיףצÊמÞמאוֿעֹיד‏•ךÝמנבÝ‏•בÝמנבֿעֹיה‏ֽמְ‏אוÞגזיִֽ–מÞמאוֿעעבֽךאֱֱ—׳ז—Êץֵגֻ—ףףבויײכְ׳וט׃ִֵׂלוף’׃ֳֵׁÊ‎מֵÝ•‘ֵךץֳכז׀קבÊֽװֳÊׂ”Þגףֹ‎םה׀מ‏ˆבÞֳךֳ׃עֳÝ–ָ‎צןÝֶ‘‎ְמהָֿֿÞ–טÿֻ‎ךֶבהפ‏’װסנ–יבְ—גֻ•ףסבץץף–ִוֳ׃ײני”Þֳעמ–ֵˆְבךיקז•נֽסךÿ׀זזזְהךˆ׀גמצ‏זזוגזן׀הװפז‎עבֿזד׀ווזך‎אזמבוזָוזזעדפֿ׃זד׀ווזך‎אזמבוזָוזצעדפֻֻכװוֻצנגזִזזמהם—װזוזצדÿ׀‏וז׀ך׀פ׀זבוצוֱזצגזזה“זףו׃כװהיצנגזְזזמהם—װזוזצדÿ׀‏וז׀ך׀פ׀זוזפ‎כזזעבזבזזזזׂזג׀ֵצהזזוזצדÿ׀‏וז׀ך׀פ׀זהזְבֳזזגוםּװזוצעזÿ׀זזזה“זףבֻ‎צוזזזו—ֵבֿצזגצזצגץמֹו׀ְÿל׀זנבֿעסבז‏אמÞמֹוÞךץךßג•ךßך—ם־ך־וְִץבֿ‏Ýךֽ‏–ז׀ה‏•טְ–׀הֶׂֵÿױֿ’יְֱפעÊְ–‘י־׀ץט־ֱÊÊב‎ˆ’ֽ‏וְדßָֽ•ככֵנ—ם—–ִ•‘“זזזזזזצוִˆ׀דְץטזהמזיּזÝזזמדוצךהוÿ“אזצעגז׀עגֱזזדז׀בֱזזגוךגװזוזצזÿ׀זזזה“זףזזזזהמזמ־‏ֽגÞִֽו׀ְ‎ל׀גטז־ך־ם־‏–יףצ•יֽךÞבֿ‏ÿמÞ“המÞמאוֿעסבו‏Ýךֽ‏•י׀קׂוÿֽדִם”‎ֵאÝ‎ֹÿÝוְֵנßועם׀פאׂגטמÊֲצÿבמוצבנÿ‘ֱֳּּננל׳ֵ–ּנֶÝֵ—יׁצאֶׁהײÊ“דֳֿקזזזזזגזÿק’דז“גףְזÞזג–זפְֿוזצִÿהצמדזצםלזזעאזז‏בזן“זזזִאזזֳזז‏אובזוזצ׀פ׀ְוו׀ִוÿ׀זוזפ’כזזךדזֻזזְמÞזּ׀זזזזÞזדגֽגÞץבֿךףהצְֵלÞצ•יִֽÝדְמןוß‏נבץצאמÞִÞיֽע—ם־‏ֹיÞ“היףע—יֽ‏Ýךֿ‏נבÞךׂז־ך־וְ‏סבץצנך׀םˆִעְבװצסׁ׃נָלצ–ְֲֳֶּלÿהבגקוײֻסװ•‎–׀נ“בװצסהִגֿױֿד־םָֹמ”‏ףßֵָÊ‏אכז׃פעאוßֶֽגÞמ־‏פו‏‏ÿÊטהגל׳ֵ–ּנֶÝֵ—יׁצאֶׁהײÊ“זזזזְוֱˆ׀דצ‏זזוגזמזהֵצזצזצצהבוךהוצצדזצזבז—׳כװוֻצנגזֳוְגדזÞֳכזזצגזֻזזְמ׀פ׀ִווצעזÿ׀גוזזזÊזג׀ֵפזֽעבֿזמצ‏וז׀ךֹפ׀זגוזםֱזזמהךגװזזזזÊפ׀ִווצעוÿ׀זוזפ“וףו׃זמצזגוזםֱזזמהךגװאזצךדזב—זזזזÊפ׀ִווצעוÿ׀זוזפ“וףבֻ‎צוצפגְזזג־זפןßְנזוגזגפִ־גצְמבÞװוגפךֹו־ך־ם־‏–יףצ•יֽךÞבßגהיßגÊם־ך־וְ‏סבץצנבֽךדֶװםֵװ‎׀Ê׃ײ׀ָהˆֵבםפםֹ–ֶ‏‏גק‏וְוְד‘זןטןֽׁײֳבֶף‘־ֹהךֱײמֹצן–ץ–ם׳׃ןזסִכבָזזזהזןˆזצׂו־—זן׀זßזדםזכßמוזְגופֿֲןץ׀ֶאץִנבץצלזעְזזצזהז׀גה‎׀זדז׀וֱזזזזכְוךכ־׀Êםה‏Êוזְנל׀זפבץעעוְ‏ֽמ־‏Êיףצ•יֽךÞבִֿÊם׀ִֹיÞ‏ֹיß‏ÿיßִןגÝצֹם־‏ֽמְ‏אבץצנבֽךÞיֽ‏–ז‘•וֲיֶא־׃ֻ’ֳךÞזע‎מ“ךָׁ‎פװאב׃Ýױׁױ–םײדוממֳֿ‏מֻמץָסֶסן–גוםֱױִ׃־ָׁ•ךְ׃ןֻֿˆקףףן־םיְֻֽ׀׀ֹÝֲלְאיÞˆנצֹגֽ׳יס‘םׂס‎׃ֳֵֶֿ—זזזהזב”ˆזק—וג“זאצזֿזדוזכצּמזְגזזעָזוצזזזצעז‎צזגוזיֱזזךדךגװזזצגהÿ׀זהז־“הףומÊםÞעֽגז‏מא־װומץ“הךÝמ•יßִאו־ך־ם־‏–יףצ•יֽךÞבֿ‏סםÞ‏ÊמÞמאוÞגדק—ּז—‘ק‏ב‘םיֹגÞםפע“ֹׂג•ÿÞÿß•ההןÊהִםעףזֿװו‘Êנּÿ—ßןנבß–ֿׂ‘ÿל‘ֹֱָֹֿׂבבˆײ‘טסזקˆˆזב”ˆזק—וְזזמְןקÿצזזמְופזזזוז׀אßואװזזזו’׃ְָםזְגזזע׳כװהיצנגזױזז‏ןז׀ִאז”“זוצזזזצעז‎צְוו׀ִֹפ׀זגוזיֱזזךדךגװזזצגהÿ׀זהז־“הףו׃זלזְוו׀‏ןְ׀זאז׀ֶדזזעזזזגבזאעזוזצדÿ׀זדזÝוכזזגוזֻזזְמׂזּß‎צוזֽמÞךÊמÞ‏פג־‏ֹםפךץהצְÊל׀זזזקˆˆזב”ˆזק—וְזזמְןקÿצזזמְופזזזוזְא–ÿצזזְ—זכםצגאהזָםזְגזזּ׳כװהיצנגזװו׀ּהוְְדהז‏דְֱזבזזזווצוֻזזְמם—װזוזצדÿ׀זדזÝוכזזגוזֻזזְמׂזּ׀ֵצהּזהז‏מְ׀ִםזְ‏דוָךזוצזזזצעז‎צזגוזיֱזזךדךגװזזצגהÿ׀זהז־“הףבֻזגÞצֽל־ֹּם־ךױםהװפם־ִֻמßגלההעױזזזזˆˆזÿֱˆװזˆצבßְז־זִֳזזז־זבמזזזגדזֵ‏זְֽזזזג–זפְָםזְגזזעָזוצזזזצעז‎צְווְ‏ןÿ׀װםהְךןוÞ–כזזצגז–זז׀ך׀פ׀זוזצםֱזזמהכְםךכÞֽמÞ‘כÝּ–ךÞךׂמÞ—ֻג־‏ֹםפךץדזְÊל׀זזזקˆˆזב”ˆזק—וְזזמְןקÿצזזמְופזזזוז׀א׀וגִזזזו’׃ְָםזְגזזע׳כװהיצנגזױהזגןוְךאו׀יזזעזזזגבזאעזוְ‏ֹפ׀זגוזיֱזזךדךגװזזצגהÿ׀זהז־“הףו׃זלזזאו׀ֶדהזגןז׀ֲדזזעזזזגבזאעזוזצדÿ׀זדזÝוכזזגוזֻזזְמׂזּß‎צוזֽמÞךÊמÞ‏פג־‏ֹםפךץהצְÊל׀זזזזזוזד—זזזככוֿעזבצז”צדצפזצ‏בג׀גזוְםלזזעןזצ‏זוצ‎ֹז׀גוזצוֳוזגזזהֿכזזמהםְםךזזזזבצזעמßגץגץגףהזְֶל׀זאבץעÝבפךץמßגֽיףך–יד‏Ýךִֿןם־ךהואכÊ’ױׂײײױ•ָקעמלכףִבֲאֻ־ִ“”ע׀ט׃ֽÿט׃ׂßהסהזזזזְוְˆֻעד׀ץטזו“זכצאְפז‎עבֿזבו—ווצךֿמזמאוץזוזְ‏להצמוזְץלא—זעןצגבוהגְזְ‏בגזגהוְָםזְגהוג׳‎פזלעבֿזמְזבוציֱו׀צהז׀ך׀פ׀ְווְ‏הÿ׀זהז־’כזזגוזבזזזזײזג׀ֵפזךעבֿזמְזבוציֱו׀צהז׀ך׀פ׀ְווְ‏הÿ׀זהז־’כזזגוזבזזזזÞזג׀ֵפזצעבֿזמְזבוציֱו׀צהז׀ך׀פ׀ְווְ‏הÿ׀זהז־’כזזגוזבזזזזײזג׀ֵפזפעבֿזמְזבוציֱו׀צהז׀ך׀פ׀ְווְ‏הÿ׀זהז־’כזזגוזבזזזזÞזג׀ֵפזעעבֿזמְזבוציֱו׀צהז׀ך׀פ׀ְווְ‏הÿ׀זהז־’כזזגוזבזזזזײזג׀ֵפזÿעבֿזמְזבוציֱו׀צהז׀ך׀פ׀ְווְ‏הÿ׀זהז־’כזזגוזבזזזזÞזג׀ֵפז‎עבֿזמְזבוציֱו׀צהז׀ך׀פ׀ְווְ‏הÿ׀זהז־’כזזגוזבזזזזײזג׀ֵצה‏ןזצצגלגװזוצעדÿ׀זדזÝוכהזגאוְםֱזזמהכּװזזצגזÿ׀זזזדמזףבֻ‎נסֻ‎נסֻזבץֱזזזֱכץװםפךזןְזֲםÞצֻםזּמאהװוגץצאו־ך־ם־‏ֹיß‏Ýךֽ‏–יצ‏ֽמ־‏Êיףע—יֽ‏Ýךִֿ”זִֽץם־‏ֽמְ‏אבץעעבֿ‏Ýזˆי—Ý“ְˆָֻ׃‏ÿ־ײֿ‎ֻׂ׀מדוֶנֽהְװ‎ׁהאיפםֹ’ֶ‏‏גק‏וְודױ”‏”כֶ־‎עצÊ•ףֻ“ßֱֳ“’ֹֿנּָײכֳˆßטֹ׀ןßפבי׳׃ןזסִכבָזזזזזזגזֽזזזזזאזזזפזבסזהְוזצצלזצזוזּ׳כװהיצנגזÿזזךדם—װזזצגגÿ׀עווזצ׀פ׀מוזזזÊזג׀ֵצוִזזצגגÿ׀עווזצ׀פ׀זדז׀וֳזְגזזה‏זףבֻזדצזזזומזגץגףמßמאהוְױזוגץמßג—ם־ך־וְִץמßגÝגף‏•ך׀קְׂ•׃װסָָּׂװָÊגגףׁ’”ˆףװהß”ß׀ÿּˆְ‏זˆֵ׳ןףצזזזְהטזזזוְֶÿגזזװזד׀זװצהּזזזזוÿ׀צוזצג׃פ׀זהז־ֿכוצגדזÞ‏דףז׀ךזזזךד׀׀קדְ—זה׀זלםז‏מבפװזבֿעעו־ך־םֽע—יֽךדגףךץזפטÝצ—טףּ—ÿװבßד׀ׂכףװכפ“ֽ׀גטׁׁאזזזוזם׀זזזבנודָזז׀ז‎צו‏זזזזָפ׀מוזצגÊזע׀זזזזדזזךץז׀ְסלÝךץךßאְִׂצ‘‏זזזדˆˆ׀הִזזזהצ׀ÿזהךוÝ׀הִזזזזמְוֵזזזוו׀אßזÝקˆˆְוץפזּעבֿזאְזהז׀זדזְווצגדזÞֳכזזזזלגװגזצגוםְבךא—זÿוצגדזְטדזזמזזָךזזזזָפ׀צוזצגÊזעß‎צומבוצגווצְבהזִאזצצווומאההזױזקˆˆˆזזזמ׃וֱ“זמְןקזזזזמְוֵזזזוו׀א–ˆÞÿˆˆְוִ׃צִוזְצופּׂ׀םבו‏צוװדוְמהוזזגזְוזזצגם—װזזזזָפ׀עוזצגÊזע׀ֵצוְזוזמגְ׀ךאזְמזזָךזזזזָפ׀עוזצגÊזעß‎צוצאוצגודזװםהזעיוְ—ווזגגגְ