ּßֳֿאֻׂמאֳװֲÿוִָÞ׀ְ‎אֶֹֻÿץÝמאבׂ‎הו׀ֳנ’ֳֽןסֳֿאְִֵָֻֽׁאÞֳאֵֹֻׁךְֵ•‏ְצ•סֳׂןסÞֲפוף‏•ֵֿׁ•ß־ֵ•ױמג׀ְעÊ׃‏נ“ְֳÊסÞכ־זßכֽז•מגיִׁןֻÞֶנֳֳָהזָססםÿלפװױכגיִׁןֻÞֶנֳֳָהזßטףּ’מאם’מהֿסעִֻ׳לÞװְץאסÝֶנֳׂמה‏ְץאס•‎נßִׁא–ֵֹֻצׂהּבװֵהוÞֶנֳֳָןךְִÊסÝ‎ÿם•‎נצׂץֹםֵֿÊװְעֹסֶֻא׀ְצ—ßימג–ֻ‎אֻ–ֵע‎Þ‏נ’ױמבם–‎נֿװמגיךףצזזזזאןזזגזזְזדזזצזוצזאזזִזֶזזםזזָזה׀זךזז—זדְזקזוזזגצזפזוךזבזזסזו‏זב׀ז‏זוּזאְזֵזו׀זןצזֲזוזמזזֿזהמזמ׀זּזהעזםְזֹזהְזלצזײזהװזכזז׃זה“זכ׀ז׀זדגזךְזÝזדצזיצז•זדִזטזז’זדָזט׀זזד—זקְזˆזגזזֱזוהזגךזץזובזג‏זץ׀ומזגּזפְוכזג׀זףצוטזגזעזוץזבמזע׀ועזבעזסְוÿזבְזנצוֶזבװזÿזוֳזב“זÿ׀אמזאמזָצהװזלזװְדםזך׀זÝ׀אםז‏ָו־׀אךז‏—וְֽאקז‎זוּצאפז‎ךוֻזדזזי—וֻצאנז‎ִוÊזא‎ז‎ָוÊ׀אִז‎—וְֹאֱזֶזוָצא־זֶךו׳זאֻזֶ‏ו׳׀אָזֶּוײְאױזֶ׀וױצאׂזֶוװזאßזֵמוװ׀א—זֵעו׃ְא”זְֵוׂצא‘זֵװוׁזאזֵ“וׁ׀ןזזִגו׀ְןדזִצוßצןאזִִוÞזןםזִָוÞ׀ןךזִ—וÝְןקזֳזו—צןפזֳךו–זןסזֳ‏ו–׀ן‏זֳּו•ְןֵזֳ׀ו”צןֲזֳו“זןֿזֲמו“׀ןּזֲעו’ְןֹזְֲו‘צןײזֲװוזן׃זֲ“ו׀ן׀זֱגוְןÝזֱצוצן•זֱִוזן’זֱָו׀ןזֱ—וˆְןˆזְזהזצמהזְךהוזמבזְ‏הו׀ממזְּההְמכזְ׀הדצמטזְהגזמץזֿמהג׀מעזֿעהבְמÿזְֿהאצמֶזֿװהןזמֳזֿ“הן׀מְז־גהמְמֽז־צהםצמÊז־ִהלזמ׳ז־ָהל׀מװז־—הכְמׁזאז־צמ׀זגגזהזו–זאּזֳ׀ו•זןּהךצמÞזל‏הך׀מ—זֽעהיְמ”זְֽהטצמ‘זֽװהקזמזֽ“הק׀םזזּגהצְםדזּצהץצםאזִּהפזםםזָּהפ׀םךזּ—הףְםקזֻזהעצםפזֻךהסזםסזֻ‏הס׀ם‏זֻּהנְםֵזֻ׀הÿצםֲזֻה‏זםֿזÊמה‏׀םּזÊעה‎ְםֹזÊְהֶצםײזÊװהֵזם׃זÊ“הֵ׀ם׀זֹגהְִםÝזֹצהֳצם•זִֹו‎צמזזצזֽזגּזףזןבזֳהִ׀ף—וײְן־צֲנועמבז׀דאמךֱצ—ךדפִיצז’Êדױמק׃ֿד“גסִפׂוצפבםךנצֲֿ–ב—‏וץְ־אד“‏ÿו׳אא—ֵֶץֽׂןוךִךßßכןכֳָץß–ֽןֶצֲמץ“•ןָֲ׳ßבןׂמֱזֿˆיןˆְִדהזְמדְְ־־הֳמףצֿפפב‏מÿ‏ֽֿהאװמִ׀ֿ•פןֽמֿג־יהלכמױמ־Þפיזמ‘ךֽ׀הצכםן—ּÊÞף‏םק“ֻן־ע”םנגֻ“־ÿ‘םֿ׀ÊכÞֶÊםִֹׁוÞֲֶם‘—ֹׁהְװלגמָװÞֽלקײפפײדלײצײ–־׃•ל‘—װו־׀׃כבִװ”ה–כֱגׂÿ־׳כßמׁיÞ‘כ׀ׁףזֳךבמ׀ֱֽה־ךפ—ßץדבֳך‏גßָדןמךֱ׀Ý‎ֽקגיהע—קףץסיא——ֿÝפְיל——ÝֽףÊיקמ–זÝעִיץ—–ׁÝֵץי•ז“אףּבטץך’קֻֽ׀טÿ“’־ד׳ִטÊָ‘ֲד׃סקÿ׀ּֽֵק“ˆּזגצןסועּא‘צִֿהגיֽצסדעקˆץדבבדּÿ־ץ׃מע—ּאפÿסלקע׃–פ’סכ——ׁ׃ףזֳיעג•ˆףֲוטֵּ‘זףײ–ט׃ע‘ףׂסקף—ע‏ֿץßֻק׃סÿֳנÝֱֻנֳֶֿװֻׁ—ÿִ–ְו•ד‏ֿב־Êפן‎ֽםָצאֻםֶ׃װכÊףִקיÝך”נֲָםב‘נÿ׃גֱ–ײוםמבהְסֲוֶ“בˆְ‎וÝמיÝֳֿׂאמ“‎ֿֿ׳Êא”ִָ׃ֿ”Êןױ“ֱֹ־ו•מץ‏ֿׁ־לפמ–מּנ־ע‘םֱמÊ—־ֱÞלצ“׳ָ־׳נל׀“ױ׀־ß‘כÿ‏ׂ׃־Þךקמßßֽל‘ך•ָ—לֽףֶיסָ–•ֽ‎טי׃‏”ףֳֽפי–‏”נֲֳֽט‎‏—ֽ“טצם׳ואּאÞץÊ’ןןֹּÊפױ