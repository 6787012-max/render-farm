בךזע—וףְבקזסזועצבפזסךוסזהֳזם“וסצבנזסִונזב‎זסָונ׀בִזס—וÿְבֱזנזו‏צב־זנךו‎זבֻזנ‏ו‎׀בָזנּוְֶבױזנ׀וֵצבׂזנוִזבßזÿמוִ׀ב—זÿעוְֳב”זÿְוֲצב‘זÿװוֱזבזÿ“וֱ׀אזז‏גוְְאדז‏צוֿצאאז‏ִו־זאםז‏ָו־׀אךז‏—וְֽאקז‎זוּצאפז‎ךוֻזאסז‎‏וֻ׀א‏ז‎ּוÊְאֵז‎׀וֹצאֲז‎וָזאֿזֶמוָ׀אּזוךזבזזסזו‏זב׀ז‏זוּזאְזֵזו׀ו׳צאÊזִֶוײזא׳זֶָוײ׀אװזֶ—וױְאׁזֵזוװצאÞזֵךו׃זא–זֵ‏ו׃׀א“זֵּוְׂאזֵ׀וׁצאזֵזׁזןזזִגו׀ְןדזִצוßצןאזִִוÞזןםזִָוÞ׀ןךזִ—וÝְןקזֳזו—צןפזֳךו–זןסזֳ‏ו–׀ן‏זֳּו•ְןֵזֳ׀ו”צזיזדז׀׀הןזו—זד׀הױזזצזָ׀זאזוגזמְה־זזעזהְזֲזומזצְוֲזאזזקְוזזזװזדזהÝזכמזגזןֲזלּזײְהזכזßצה—זכעז׃ְה”זךצו”׀ןְזֲגו“ְןֽזֲצו’צןÊזמצזׁצזןזמעזְֻוֿזכְזמזזֿזוז׳זדׁזקזזהזזטזםךזÿ׀דָזהךזהצהמזמװז־ְהאזמךזצצןֹזְֲו‘צןײזֲװוזן׃זֲ“ו׀היזי“ז•זהטזגךז•ְדֳזיּוזןßזֱמו׀ן—זֱעוְן”זְֱוצן‘זֱװוˆזןזֱ“וˆ׀מזזְגהזְמדזְצןֳנ’׳ךעע’ץצסככÊבװֳזספכÊבװֳז‎ככÊבװֳדמאצÞ’ÝִÝז•וּצִׂ”ך׀יְ‎ןכֹיÝךד‏אףÞ’ÝִÝז•וֻגִׂ”ך׀יְסװֵ•’ִֹ׀סֹכÊבװֳזסױכÊבװֳז‎ױכÊבװֳדמא‏־’ÝִÝז•וÊךִׂ”ך׀יְ‎ּכֹיÝךד‏א‎Þ’ÝִÝז•וÊִׂ”ך׀יְ‎׀כֹיÝךד‏אִפ’ÝִÝז•וÊעִׂ”ך׀י׀‎ֹכֹיÝךדִד‎ֻÊונ‎ֱ‎ֻ׳ונ‎ֱ‎ֻװז•‎ֱֵז‎וכֹי׃‏”זכצנבֳֽÿץֻכֹי׃‏”זצצני׳ִÊי–ֵנ‎װ‎ÿְִׂ•–ִֽז’ו‎אִֻֻÊסÝֶÿךִׂ•–ִֽז׃ו‎”םֳֿÊעִׂ•–ִֽז׳וִÊֻׂ‎Þ’Ýֵני׀ה—ב—ֶנßּ‎פ’Ýֵני׀ו—בבכֹי׃‏”זאצ־’Ýֵני׀וּךִׂ•–ִֽז–ד‏•סֶּנßװ‏פ’Ýֵני׀וּצִׂ•–ִֽזֿבֳאְִׂ•–ִֽז‎בכֹי׃‏”זכץנבֳֽÿץֻכֹי׃‏”זצץני׳ִÊי–ֵנ‎װ‎ÿְִׂ•–ִֽז’ב‎אִֻֻÊסÝֶÿךִׂ•–ִֽז׃ב‎”םֳֿÊעִׂ•–ִֽז‎אכֹי׃‏”זאץÞ’Ýֵני׀וְִּׂ•–ִֽז‎םכֹי׃‏”זכפנבֳֽÿץֻכֹי׃‏”זצפני׳ִÊי–ֵנ‎װ‎ÿְִׂ•–ִֽז’ם‎אִֻֻÊסÝֶÿךִׂ•–ִֽז׃ם‎”םֳֿÊעִׂ•–ִֽז‎לכֹי׃‏”זאפÞ’Ýֵני׀וּ׀ִׂ•–ִֽז‎יכֹי׃‏”זאף־’Ýֵני׀ה—’—ֶנßּ‎פ’Ýֵני׀וּִׂ•–ִֽז׃ק‏ני–ֳאעִׂ•–ִֽווק‏•ֻÞ‏”ס׃‎Êßֲֻה’Ýֵני׀דּֶּנסÞ‎ÿי׳ִÞ’Ýֵני׀ה—ִֹÊב•‎פ’Ýֵני׀ה—ÝֵאבÝֶה’Ýֵני׀ה——ֶנßּ‎פ’Ýֵני׀וֻזִׂ•–ִֽז׳עֶאÞֵ־’Ýֵני׀וֻגִׂ•–ִֽז‎פכֹי׃‏”זאעÞ’Ýֵני׀דןסֶׂףבבטעעִׂ•–ִֽז‎עכֹי׃‏”זאספ’Ýֵני׀ה–סֿ‏”ס—‎פ’Ýֵני׀גבסֶֽÿםֳֽנ–Êֵאס“כֹי׃‏”זטסנץ׳‎ÿםִֻ•ֻÝכֹי׃‏”זכסנֳÞ‏ÿ‎ֻכֹי׃‏”זאס־’Ýֵני׀וִִֻׂ•–ִֽז‎‏כֹי׃‏”זאנפ’Ýֵני׀ה–ֻֿ‏”ס—‎פ’Ýֵני׀וִָֻׂ•–ִֽזסֵֿןוָ‏צֵֻֿןוָ‏פ’ֵֿןצןֳנ’׳ךדסאךזֳ–ֵÊּ׀יע‏ßו”סֶׂףז–ץֽמןֳנ’׳ץּמ—ץְֳ–ֵÊּ׀יעצ׀ו”סֶׂףז–ץדגןֳנ’׳ךדסגךְֳ–ֵÊּ׀יעצÝו”סֶׂףז–ץדצןֳנ’׳ךדסגיצֳ–ֵÊּ׀יעצ•ו”סֶׂףז–ץדִןֳנ’׳ךדסגטזֳ–ֵÊּ׀יעצ’ו”סֶׂףז–ץגגןֳנ’׳ךדסגצְֳ–ֵÊּ׀יעץדו”סֶׂףז–ץגצןֳנ’׳ךדסגץצֳ–ֵÊּ׀יעץאו”סֶׂףז–ץףזןֳנ’׳ךדסבךצֳ–ֵÊּ׀יעעÞו”סֶׂף