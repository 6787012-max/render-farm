ÿםÝֶנׂמדמֶָןץ—ִדָׁכ”ֳ”ֳÞ’ֵֹֹעֵׂ”םֹכ•ß׳‏•סִׂ•סÝכ•ֳ׀ֵה’ֳָא–װלפ“ְהּßֳֿאֻׂמאֳװֲÿוִָÞ׀ְ‎אֶֹֻÿץÝמאבׂ‎הו׀ֳנ’ֳֽןסֳֿאְִֵָֻֽׁאÞֳאֵֹֻׁךְֵ•‏ְצ•סֳׂןסÞֲפוף‏•ֵֿׁ•ß־ֵ•ױמג׀ְעÊ׃‏נ“ְֳÊסÞכ־זßכֽז•מגיִׁןֻÞֶנֳֳָהזָססםÿלפװױכגיִׁןֻÞֶנֳֳָהזßטףּ’מאם’מהֿסעִֻ׳לÞװְץאסÝֶנֳׂמה‏ְץאס•‎נßִׁא–ֵֹֻצׂהּבװֵהוÞֶנֳֳָןךְִÊסÝ‎ÿם•‎נצׂזזואזןמז‏צוׂזאװזמזופזןעז‎צוָזא׀זמזודזג׀זףצזזץֹםֵֿÊװְעֹסֶֻא׀ְצ—ßיזזויזאעז‎זו׳זןעזֵצזזףנסֶּÿס׃זזואזאזְֵו—זג‏זֵ׀וÞזאִז‎צזְזדמזכְז׀זהזזטְזְזג‏זְִוֿזא“זֶ׀זְזבמזֳצוֻזאְזֵזזְזגךזףזויזהזזףצוֻזאצזֶצו–זא—זמזז‘זהזזךְז’זה—זי׀ז׃זדמזךזזÞזדצזזג‎ֵֹׁץאֵ”םֹ‎פזÞכֽזְט־ואִÊבֶׂÞופֳנסֵָהודףג—ְףנסֶּÿס׃מדְָךּֽ׃יÞ—Þךדמ—זזואזןמז‏צוׂזאװזמזופזןעז‎צוָזא׀זמזודזג׀זףצזְזג—ז‎צוּזאּזֳצו׃זזואִÊבֶׂÞופֳנסֵָהודףג—ְףנסֶּÿס׃זזונזאעזְִוÝזאּזֵ׀וׂזהזזךזזׂזדגזיזז׀זזונ‎ÿםÝֶנׂמדזׂךףצ׀זזואזןמז‏צוׂזאװזעְו–זאעזֶזוװזגךזףזויזה—זףצוֻזאצזֶצו–זא—זזג‎Þ‏נ’ױעֹסֶֻאßדףג—׃ףנסֶּÿס׃זזזםזזּזמזזְזהזזמזוןזג“זסצזְזגִזץצוטזגעזעְווזג׀זמזוצזבעזצְוךזגּזצ׀זְזג׀זפצודזגעזףְוףזגעזהְזםזזּזמזזְזהזזמזזְזהזזמזונזאעזְִוÝזאּזֵ׀וׂזהזזךְזװזהזזפְו–זא“ז‎צזְזדגזטצז’זדגזהְזלזהזזצ׀וׁזןזזֲצוÞזאּז‎׀וָזןצזמזזָזגךזלצזְזדגזטצז“זדּזכזזְזדגזטצז’זדגזמזואזןמז‎צוֻזהזזע׀וׁזא‏זֳזו”זאגזְִוֻזהזזץְוׁזןעזְֵוּזאגזֳזו׳זאזְֵזװזהזזפצוׂזאךזכְזלזהזזמזזְזהזזמזזְזהזזמזזְזהזזמזזְזהזזמזזְזהזזמזזְזהזזמזזְזהזזמזז–זדּזמזועזאעזֵצו׀זא׀ז‎צזְזבזזֵזוֿזאךז‎צזװזהזזע׀ו–זאּזֳזוֻזהזזך׀זÝזדזזכזזְזגמזֵ׀וÝזןצזֵ׀וׂזה׀זמזויזגגזמזזְזדזזךְזßזדגזךצז׃זדגזך׀ז׀זדִזמזזְזבעזע׀ווזזָזמזובזן‏ז‎צוÞזןּזֵ׀וׂזאעזמזו׳זןךזמזו׀זאעזְִו׃זאּזֳזו—זאעז‎זזְזןצזֵ׀זְזאךזֵ׀ו׀זןּזמזוֿזא“ז‎זזְזאצזֶצוÝזןצזְִו׳זאמזֳצו—זאעזמזו•זאעזְִו־זאגזֳזו׳זא—זמזוֽזאזִזו׳זאעזִ׀זלזהזזֵ׀וÊזהזזֳזוָזאּזִ׀זְזא׀זֶצוֽזאעזְֵוÝזאעזמזוּזאז‏׀ו–זא—ז‎צוׂזןצזכזזְזאמזֳצו—זהזז‏׀וָזאגזְֵוֹזאּזְֵוֹזהזזֶצו—זהזזֶצוÝזהזזְֵוׁזןצזמזוֿזא׀זֵזוׁזןִז‎צוּזה“זהְזלזזּזהצזםזהזזמזזְזהזזעזוÞזאעז‏צו׃זאמזֵזוֻזזָזהְזְזהזזסזוָזאעזמזוװזאּז‏׀וֻזא“זִ׀וֻזןךזמזוÊזאזְִזְזא—זֵ׀וÝזןצזמזוÝזאז‎ְו—זןִז‏צוÞזאעזמזוֿזןמז‎צזְזאצז‎צוÝזאּז‎׀וׂזאעז‎זזְזןצזֵ׀זְזןצז‏צוױזאעזמזוֿזןִז‏צו’זהזזֲצוׁזןעזְִזלזא‏זְִוֻזאעז‎זוׁזא—זמזו—זאזמזוÝזאְז‏צוÞזאעזמזוֿזא“ז‎זזְזאךזֶזוֿזא“ז‎׀וֻזהזזֶצו—זה“זמזזְזגמזֲצזְזאךזֵ׀וׂזןצזְִוֿזןךזֳזזװזהזזֳזוָזאעזמזוןזג“זסצזְזגִז‎צוׂזאעזְִוֿזא׀זמזוצזןעז‏ְוװזאּז‏׀זלזג׀זֶצוֽזאעזְֵוÝזאעזמזו׳זןךזמזו׳זא“זֳזוֻזא“ז‎זוֻזאצזמזו—זאזמזוֹזןעז‏צוÞזאגזְֵו—זאעז‎צזְזןּזֵ׀ו–זןמזמזוÊזןמז‎צוֻזאצזֵ׀ו׃זהזזֳזוׁזהזזִ׀וָזאגזְִוֻזהזז‏צוׂזאצזמזוֽזאְז‏צוׂזאִז‎צזְזא‏זְִוֻזאעזהְוÝזאז‎ְו—זןִז‏צוÞזאעזכצז׃זןצזֵ׀זְזא—ז‏צוױזאעזמזוÝזןעזְִוֻזהזזֳזוָזאעזמזוÝזאז‎ְו—זןִז‏צוÞזאעזמזו׳זןךזמזוÊזןמז‎צוֻזהזז‎ְוׁזןמזמזוֿזא׀זֵזזְזאּזֳזוÝזהזזֳצוÝזאעזְִוÝזה“זמזזְזבצזֶזו׳זןךזהְוןזאעזְֵוֻזןמז‏צוװזהזזעזו–זאמזֵזו׳זאךזמזוךזאּז‏׀וֻזא“זִ׀וֻזהזז‏צו׀זןזזֵזו׳זאעזִ׀זְזןצזֵ׀זְזא—זֵ׀וÝזןצזמזוׁזא‏זמזו—זאְז‎צזְזג‏זְִוֻזאעזמזוףזאז‎ְו—זןִז‏צוÞזאעזהְואזאזֳצוׂזאצז‏צו—זאּזֵ׀וׂזהִזִ׀זְזןךזֵ׀וÊזןצזֳ׀וֿזןמז‎צזְזאגזְֵוּזהזזֳזוׁזהזז‏צוׂזןּזמזוׁזןצזֶזוֻזןמזמזו׀זןמזֵ׀וֹזןמז‏צו׃זהזזֳ׀וָזאזִ׀וֻזהזז‏צו–זןצזֶזוׁזןמזִ׀זְזאךזֵ׀ו׃זא—זֶצו—זהזזֳזוׁזזָזֳצוÝזאּזְֵוֹזהזזֶצו—זה“זמזזְזהְזע׀וׁזא—ז‎צזְזאזֳזוָזאעזְִזְזג‏זְִוֻזאעזמזוףזאז‎ְו—זןִז‏צוÞזאעזמזואזאזֳצוׂזאצז‏צו—זאּזֵ׀וׂזהזזִ׀וׁזא‏זֳזו”זאגזְִוֻזהזזֶצוÝזהזז‏׀וׁזן‏ז‎צוÞזאעז‎זזְזאמזֲצזלזןצזֶזוֻזהזזץ׀וטזבעזמזוךזאּז‏ְוÞזאגזְִו’זהזזץ׀וֻזא“ז‎צוÞזאגזֵזזְזבזזֳצו־זא׀זֶצוֽזהזזףזו׳זאךז‎צוׂזןךז‎צזְזאּזְֵוÝזןצז‎צוֿזאצזכְז׳זהזזמזו‎זאזֳצזְזאךז‏צוׂזהזז‏צו׀זןזזֵזו’זהזזֶצו—זהזזֳזוׁזזָזֲצוׁזןעזְִזְזןזזְִוׁזאִזְִוֿזא—זִ׀זװזהזזֳזוׁזאזכְזלזזָזמזזְזבִזֶזוֻזא“זמזו”זאעזמזוÝזןזז‎צוֿזאװזמזוׁזא‏זמזוÊזןמז‎צוֻזהזזִ׀וׁזא‏זֳזו”זאגזְִוֻזה׀זמזו”זאעזמזוֿזןמז‎צזְזןמז‎צוÊזאעזְִוÞזאּזְֵוֹזהזזֳזוׁזהזז‎ְוÞזאעז‎צוּזאזֵצזװזהזזְֵוׁזןצזהְו׀זןמזֶצוֽזאעזכְזְזהזזף׀ו–זןמזמזוןזאעזְֵוֻזןמז‏צוװזהזזעזו–זאמזֵזו׳זאךזמזוךזאּז‏׀וֻזא“זִ׀וֻזןךזמזוֿזןמז‎צזְזאצז‎צוÝזאּז‎׀וׂזאעז‎זזְזןצזֵ׀זְזא—ז‏צוױזאעזמזוÝזןעזְִוֻזהזזֳזוָזאגזֳזזְזןּזֵ׀ו–זזָזֶזוֿזן‏ז‎צזְזןצזֶזוֻזהזז‎ְוÞזאעז‎צוּזאזֵצזְזןצזֵ׀זְזאצזֶצוÝזןצזְִו׳זאמזֳצו—זאעזמזוֽזאזִזו׳זאעזִ׀זְזאז‎ְזְזא‏זְִוֻזאעזמזוÝזאז‎ְו—זןִז‏צוÞזאעזמזזָזאגזְֵוּזהזז‏׀וָזאגזְִוֹזאעזמזוÊזאזְִזלזןצזֶזו׳זןךזמזוÝזאעזְִו•זאּז‏׀וֻזהזזֶצוÊזהזזֲצוׁזןעזמזו”זאּזִ׀וָזהּזכזזְזןצזֶזוֿזןצזמזו’זאזֳצזְזןמז‎צוֽזאעזֶצו•זאעזמזוÝזאזֳצוÞזאךז‎צזְזאךזֵ׀וּזאעזמזוׁזןמזמזוֽזאגזְֵזְזאִז‎צו—זהזזֶצו—זזָזֶצוÊזהזזֲצוׁזןעזמזו”זאגזְֵו—זהזזֶצו—זה׀זמזו—זאְז‏צו—זהזזֲצוׁזןעזמזוֽזאגזְֵזְזאךזֶזוֿזא“ז‎׀וֻזהזזֳזוָזאעזמזוÝזאז‎ְו—זןִז‏צוÞזאעזמזוׁזןמזמזו–זןךז‎צזְזןזזֶצוֻזאךז‎צוÝזהזזֵ׀וÊזהזזֶצו—זזָזֶצוׂזהזזְֵוֻזןִזמזוÊזןמז‎צוֻזהזזִזוÞזאז‎׀וÞזאגזֵצוÝזדװזמזוֿזא“ז‎זזְזןצזֶזוֿזןצזמזו’זאזֳצזְזאװזְֵוׁזןִזמזו’זאזֳצזְזאךז‏צוׂזהזז‎זוׁזהזזֳזוָזאעזִ׀וֻזהזזֳזוָזאּזְֵוֹזןךזכְזלזזָזמזזְזבצזֵ׀זְזןזזְִוׁזןצז‎צוֽזןצזמזו’זאזֳצוÞזהזזְִו׳זאִזֶזו—זןךזכזזְזןִז‎צזְזא“ז‎צוֻזאצזמזו—זאזמזו׃זאגזֶ׀וֻזהזזְִוֻזןךזֳזוÞזאּז‏׀ו—זאּזֵ׀וׂזןךזמזו—זאְז‏צו—זהזז‎ְוׁזןמז‏ְו׳זאצזהְוֿזא“זֲצוׁזא“ז‎צזְזןצזֵ׀זְזאצז‎צוׂזןּזמזו’זאזֳצזְזןצזֶזוֻזןךז‎צזְזןמזֶצוֹזאְזֳזוÝזהזזֵ׀וÞזהזזֳזוׁזהזז‏צוÝזאװזמזו’זאזֳצזְזןצזֵ׀זְזןךזֳצוÞזןמז‎צוׂזאצז‎צוÞזהזזֳזוָזאעזמזוÞזאּז‎׀וָזןצזִ׀זׂזזָזסזוָזאעזִ׀וֻזהזזְִוֻזןךזֳזוÞזאּז‏׀ו—זאּזֵ׀וׂזןךזמזו—זןמז‏צוׂזןךזֵזוֿזןצז‎צזְזןצזֵ׀זְזאךז‎צוÞזןצז‏צו׳זא“זמזוÞזאעזִ׀ו׀זאזְֵוÝזאּז‏ְו׳זא׀זֶצו—זאּז‎צוÝזהזז‎ְוׁזןמזמזו’זאזֳצזְזאּז‎ְזְזןּזֵ׀ו–זזָז‎זו׳זןךזֳזוÞזאּז‏ְו–זןצז‎צזְזאךזֵ׀ו׀זאּז‎צוÝזהזזֵ׀וÊזהזזֳזוָזאעזמזוÝזאז‎ְו—זןִז‏צוÞזאעזכזזְזאזְִזְזאּז‎ְזְזןּזֵ׀ו–זהזזֵצוׁזאצזֶצוÊזןּזמזו׳זןצזכְזלזזָזמזזְזג‏זֵ׀וÞזהזז‎צו“זאגזֵצו׀זא׀ז‎צזװזהזזֶצוÊזהזזֲצוׁזןעזמזוּזאּזִ׀ו—זןמזֶצו־זןעזֳזוֻזהזז‏׀וׁזןזזֶצוֻזןךזמזוׁזא‏זמזוÝזןעז‏׀וָזהזז‏צזְזןזזְִוׁזאִזְִוֿזא—זכזזְזןִזֶזוֻזןצזֶזוֻזןמזהְוֹזןמז‏צו—זאּזִ׀זְזאזְִזְזא‏זֵ׀וÞזהזז‏צזְזא‏ז‎צוֻזה׀זמזו’זאזֳצזְזא—זֳצוÝזןצזמזוֹזאּזְֳוֻזהזזֳזוָזאעזמזוÞזאעז‏׀ו׳זןזזֶצוֻזא“זֳזוÝזהזז‏צוװזא׀זמזו—זאְז‎צזְזןמזֶצוֹזאְזֳזוÝזהזזֳזוָזאגזֳזזלזןּזֵ׀ו–זהזזֶזוֿזן‏ז‎צזׂזהזזמזו‎זאזֳצזְזא—זֳצוÝזןצזמזו׃זאגזֶ׀וֻזהזזִ׀ו–זןמז‎צזְזןצזֶזוֿזןצזמזו—זאְז‎צו’זה׀זמזו—זאזֵ׀זװזהזזְִוֻזאךז‎צו׳זן‏ז‎צזְזאזְִזְזאךז‏צוׂזהזז‎׀וֻזןצזמזו—זאְז‎צזלזןךזֵ׀ו–זןמז‏׀וֻזהזז‏׀וׁזאצז‎צזׂזהזזמזווזא“ז‎זזְזןּזֵ׀ו–זהזזֵצו–זןךזֳזזְזןךזֶזוׁזןִזמזו—זאְז‎צו׃זהזזֳזוָזאעזִ׀וֻזהזזֳזוֻזןמזֵצוÝזהזזִ׀וׁזהזזֳזוָזאעזֲצזְזאװזְֵוׁזןִזמזו—זאְז‎צו׳זןמזהְוÞזאּז‎׀וָזןצזִ׀זׂזזָזהְזְזהזזס׀וֻזהזזִזוÞזאזֳזוֻזאךזֳזזְזןּזֵ׀ו–זןמזמזוÞזאּז‎׀וָזןצזִ׀זְזןִזֶצו—זאְזמזו—זןִזֵ׀זְזןךזֳזוֻזןזזִ׀ז‘זהזזלזזßזהּזמזוֽזאזִזו’זןמזֶצוֹזאְזֳזזְזןצזֶזוֻזהזזִ׀וׁזא‏זֳזו”זאגזְִוֻזה׀זמזוֿזא“ז‎זזלזהְזךְז׳זהזזֵ׀וÊזא‏ז‎צוÞזהזזֲצוׁזןעזמזו—זאְזֶצוÝזהזזֵזו׳זאךז‎צוׂזןךז‎צזְזןִזֶזו׳זאךזֶזזְזאִזֶצו•זאעזִ׀זְזןּזֵ׀ו–זהזזֵזוֻזאִז‏צוװזהזזִזוֻזןמזֵצו׳זןךזִ׀ו׳זאזְֵזְזןצזֵ׀זְזאךזֵ׀ו׀זןּזכזזלזאצזֶצוÝזןצזְִו׳זאמזֳצו—זאעזמזוֿזא“ז‎זזׁזאזְִזְזא—זֵ׀וּזאּז‎ְו’זהזזֳזוָזאעזמזוÝזאז‎ְו—זןִז‏צוÞזאעזכְזלזזָזמזזְזגגזֵזוÝזאזכזזְזא‏זֵ׀וÞזהזז‎צוֿזאךזֶזזְזאגזֳצו—זאְזֵ׀וÞזהִזִ׀זְזןזזְִוׁזןצז‎צוֽזןצזֶצוׁזא“זמזוֿזא“ז‎זזְזאזֳצוÞזןךזכזזְזןִז‎צזְזןִז‏צוׂזןצזמזו—זאזמזו׃זאגזֶ׀וֻזהזז‏׀וֻזןמזֳזוֿזאּזְֵזלזןצזֶזוֿזןצזמזוֻזן‏ז‎צוÞזןּזֵ׀וׂזאעזמזו–זא“ז‎זוֻזןמזִ׀ו—זאגזְֵוּזןךזמזו—זאְז‏צו—זהזזֳזוָזאעזְִוֻזהזזֶצוÝזהזזְֵוׁזהזזֳ׀וֿזןמזְִוֿזא“זֳזו’זהזז‎ְוׁזןמזמזו—זאְזֶצוÝזהזז‎ְוÞזאעז‎צזלזןךזֵ׀וÊזןצזֳ׀וֿזןמז‎צזׂזהזזמזוםזא‏זמזו—זאְז‎צזְזןךזֵ׀וÊזןצזֳ׀וֿזןמז‎צזְזאּזִ׀זְזא—זֵ׀וּזאּז‎ְו׳זאעז‎זזְזאמזֲצזְזןךזֵ׀ו׃זאעזֵ׀וׂזאעזמזוֻזא׀זִ׀וֻזהזז‏צוׂזאצזמזו׀זאגזִ׀וÝזאעז‎זזְזאזְֵזװזהזזֳ׀וֻזזָזֳ׀וֿזא“זֳזזְזאּזֳזוÝזהזזְִוֻזאךזֶצו׀זאּז‎צוׂזןצזִ׀זְזןצזֵ׀זְזאװזְֵוׁזןִזמזו—זאְז‏צו—זהזזֳ׀וָזאגזֳזזְזןצזֶזוֻזןּזמזוָזאגזְֳוֻזהזזֶצוÝזהזזְֵוׁזןצזמזו—זאְז‎צזְזאזְִו׳זאִזֶצוׂזאגזֵזזװזהזזִ׀וׁזזָזֳזוָזאגזֳזזְזאגזְֵו’זהזזִזוÞזאז‏ְוװזאעזֵצוÝזהזזֶצוׂזןצזְִוׁזאצזֳצוֽזאעז‎זזְזאמזֲצזְזאזֳזוָזאעזְִוÝזהזזֳ׀ו׳זא׀זֵזזְזא“זֵ׀ו—זהזזְִוֻזא‏זֵזוֻזאךזֳזזְזאזְֵזְזןצזֶזוֻזהזזֵ׀וÞזאּז‎׀ו׳זא“ז‏צוװזזָז‏צו–זןצזֶזוׁזןמזִ׀זֹזהזזְִוֻזןזזֳצו—זאגזֳזו׳זאזְֵוÝזה“זהְזלזהזזמזואזאּזְֵוֿזא׀זֵזו’זה׀זמזוֿזא“זֲצזְזא‏זְִוֻזאעזמזו׀זןמזֵ׀וֹזןמז‏צו׃זהזזֶצוÝזהזזֳזוָזןמז‎צוֿזןצז‎צוׂזאעז‎זזְזאךזֵ׀וׂזןךזֳזוֿזא“זֳזוװזןּזמזו־זןּזמזוÝזאז‎ְו—זןִז‏צוÞזאעזהְו׀זאגזֳזוֻזא“זֳזוÝזה“זמזזְזבִז‎צזְזןִזֶצוÝזאְזמזו—זאזמזוֿזן‏זֵ׀ו׳זאצזמזו—זאְז‎צזְזאצז‏צוׂזאִז‎צוÞזהזזֳזוָזאגזֳזזְזןמז‎צוּזאּזִ׀ו—זןמזֶצו־זןעזֳזוׁזןמזִ׀זְזאז‎ְזְזאגזמזוÊזןמז‎צוֻזזָזִזוÞזאז‎׀וÞזאגזֵצזְזןִזֶצוװזא׀זמזו׳זא“ז‎זו׳זן‏זֶצוּזןעז‏צוװזא׀זֲצזְזאז‏ְו—זאגזֶצוׂזהזזִזוֿזןצז‎צוׂזןצזמזוװזאּז‏׀וֻזא“זִ׀וֻזןךזכזזְזאּזְֵזְזאעז‎ְוÊזאעז‏׀ו—זהזזֵצוֿזאװזֶצוׂזאִזמזו—זאְז‎צזלזןזזְִוׁזאִזְִוֿזא—זמזו׀זןמזֵ׀ו׀זןמזֶצוֻזןצז‏צוÞזןּזכְזְזהזזסזוׁזהזזִזוÞזאעזְֳוֻזא“זֳזזְזןצזֶזו׳זןךזכזזְזןִז‎צזְזאְז‏צו•זאעזמזו׃זאגז‎זוֻזהזזֶצו—זהזז‏׀וװזאעז‏צוÞזהזזֳזוָזאגזֳזזְזאגזְֵו’זזָזִזוֿזןצז‎צוׂזןצזמזו׃זןעזִ׀ו—זהזז‏ְוֻזהזזֵזו׳זאךז‎צוׂזןךז‎צוּזהזז‎ְוׁזןמזמזוֻזן‏ז‎צוÞזןּזֵ׀וׂזאעזם׀וÝזהזז‎ְוÞזאעז‎צזְזןעזִ׀וֻזהזזֵ׀וÞזהזזְֵוׁזןצזמזוװזאּז‏׀וֻזא“זִ׀וֻזאצזמזוֿזןצזמזוֿזא׀זֵזזׂזזָזהְזְזהזזסזוָזאעזמזו׀זןמז‎צוֽזאּזִ׀וֻזהזזֳזוֻזןמזֵצוÝזהזז‏צוׂזאצזמזוֽזאזְֵוּזאּזֳזו׳זאזְֵוÝזהזז‎ְוׁזןמזמזוֽזאזִזו’זאּזְֵוֹזה׀זמזוּזאּזִ׀ו—זןמזֶצו־זןעזֳזו׳זאזְֵזְזאגזְֵוּזזָזֵצוׁזאצזֶצוÊזאּז‏׀וֿזןצזֶצוׁזא“זמזוÊזאזֵזוװזאזֳ׀זׂזזָזדזזלזזּזהצזְזהזזמזזְזגִזףְוסזהזזץ׀ובזג“זץצופזגגזףזזְזבזזסצוהזג׀זפצודזהזזףזוםזגךזץצוטזבךזץצזלזהזזמזזְזבצזץצופזג—זע׀זְזגגזףְוגזהזזצ׀וקזג“זץזוםזבצזפצוקזג“זע׀זְזג‏זף׀ופזהזזצ׀וקזבזזנצוםזג“זץ׀זװזהזזץזוםזבךזסזופזגּזצְוסזבצזפצוקזג“זמזווזג“זץזזְזג—זף׀וגזגּזץְוםזגךזצצועזגּזף׀וטזזָזהְזְזהזזךזזׂזהזזסזוָזאּזִ׀זְזג׀זֶצוֽזאעזְֵוÝזאעזמזוֿזןזזִזוװזאּז‎צוÝזהזזֳזוׁזהזז‏צוׂזןּזמזו׀זןמזֵ׀וֹזןמז‏צו׃זהזזֵ׀וÞזהזזֵ׀ו—זאְז‎צוÞזהזזֳ׀וׁזןמזֶ׀זְזןִזֶזו׳זאךזֶזזְזאךזֵ׀וׂזןצז‏צו׳זא“זִ׀זלזאגזמזוׂזאזֳזו׳זאךז‎צזְזןזזֵזוֿזאךז‎צוּזהזז‏ְו’זהזזֳזוָזאעזמזוֽזאזִזו’זןמזֶצוֹזאְזֳזזְזאְזֵ׀וװזאצז‎צוÞזהזזִ׀וֿזןּזֶצוׂזאִזמזו׳זןצזמזו׃זאגזֲצזְזאמז‎צזְזאצזֶצוÝזןצזְִו׳זאמזֳצו—זאעז‎זזלזןעזְֵוּזאעזְִזְזןצזֶזוֻזהזזֳזוֻזןמזֵצוÝזהזזֵ׀וÊזהזזֳזוָזאּזִ׀זְזגִז‎צוׂזאעזְִוֿזא׀זמזוצזןעז‏ְוװזאּז‏׀זְזג׀זֶצוֽזאעזְֵוÝזאעזכְזְזהזזסזוָזאעזמזז־זבזזְִוׁזאִזְִוֿזא—זמְזװזהזז‏ְוֻזא׀זֵ׀ו”זה׀זהְוÞזאעז‎ְוֻזןמזִ׀זְזןצזֵ׀זְזאגזְֵו’זהזזִ׀ו–זאךזֶזזְזןזזְִוׁזאִזְִוֿזא—זמזוׁזןמזמזו”זאזְִוױזה׀זמזוֿזא“ז‎זזְזאגזמזז־זןִזֵ׀וÞזאװזמזו־זאגזִ׀וֻזאצזמזוׁזא“זמזו—זאְז‎צזְזבזזְִוׁזאִזְִוֿזא—זמְזלזא—ז‎צוֿזא“זִ׀זְזאעזֶצו—זאְז‎צוÞזהזזֳזוָזאעזמזוצזןמזֵ׀וֹזןמז‏צו׃זהזזֵ׀וÞזהזז‏צוׂזןּזמזוּזאעזְִו׳זן‏ז‏צו—זאּזְֳוֻזהזזֳ׀וׁזןמזֶ׀זְזןעזְֵוּזאעזְִזְזאךזֵ׀ו׀זןּזְִו׳זאִזֶזו—זהזזֵזוֿזןִזטְזלזןצזֶזוֿזןצזמזו׳זןךזמזו—זאזמזוÝזאגזֲצזװזהזז‏צזְזןִזֵ׀וÞזאװזמזוֽזאזְֵו—זאגזֶצוׂזאּזְֵוֹזהזזֳזוָזאעזמזוצזןמזֵ׀וֹזןמז‏צו׃זהזזֵ׀וÞזהזז‏צזְזןזזֵ׀וÞזןצזֶצוׁזא“זמזוׁזא‏זמזו׳זןצזכזזלזאעזֶצו—זאְז‎צוÞזהזזְֳוֻזןמז‏ְוֿזןצזֶצו׃זהזזֵ׀וÞזהזזֳ׀ו׳זןצזֶזזְזא—זֵ׀וּזאּז‎ְו׳זאךז‏צו—זאּזֵ׀וׂזןךזמזוֿזא“ז‎זזׁזאזְִזְזןצזְִוֿזא“זִ׀וװזאגזֳזוֻזאצזמזו׳זא“זֳזוׁזהזז‏