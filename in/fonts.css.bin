מֽמ׀זזךֽ—ÞקהךßמÝזזמְז־א־—ֽהצְÿלÞגֹוְ‏ֽמ־‏Êיףצ•יִֽÊםֽע—יֽ‏Ýךֿ‏נבץצאו׀ִויֽעÝבזִÿזז‏אבץצנבÝִ•יֽע—ם־‏ֽגֽ‏”זצִאוֿעעבֿ‏ÝווץְפִֿÊֽ‎Ýץÿֲֿע–בֶ׳נ’ָֹֻסּ‏Ê—וצ—טֲָדןבז׳קד׳ֹץף“ײףÝ‏־ֽׁֹהֲֻק—הזÿÿיהץנÊ‘ֲבטןִּםֻÊסו׀ֹ–םףֽסי־ֻּּץˆֹ•וֹˆֹְעׂיסָ•יןיםפ־‎ץ־ֿםכק׃עטÝ‏וײֿאֱÝםםֳּ‏זזצודזזזדצְנ׀זז׀זאעזנזזזזזס—זזצגֻפ׀זהז־‏הףוגÊמזךמבÞװומÞמÊםֽע—יֽ‏Ýמץגֽזָ‎ÿÊ’Ýִ‘ֵזץטזְֿ“–מ־ן–ןֹ‘עזזזזזךזנˆˆױוֲ‏בßזזקזוזקצוֽװצ‎ּץגו‏זז‏ןהצִאהÿ“זהצְןהצֿהְגוזזמבזצםֹזזעזו׀‏בו•ִזהזזגז׀ְג‎׀װוז׀זזז–ִכזצךדזאזזזזךזעוזצזזזקדָ“ךÝגׁכ־׀ײמÞגצןßזֲאו‏זד׀זטםְ׀מבפׂßוְוגזזצפבץצהוהך־םזמ–יומּךßמּגֽע—ז־צֽמְצהבץצפודךזו־ך־ם־‏–יףצ•יֽךÞבֿעֽיה‏ֽמְ‏סבץצנךÝמ•יףךד“ְבבׁˆׂןהˆױׂˆׁ׀בב׀ײגוג‎ֱˆׁה־ָׁֹׁ‘זוגלמוקײִֶ‎–סס‎–׳ֹכהפÿס–ְֶÊֻֿÿסÞפוִףבˆײױצ—ק‘׳ßִוסדצזסֵב׳‘ֹזפאׁױ׀גֱ׳ײֵ“ֶׁˆ׃ֹזסÊֱ‏ֵוÞִ”ל׀‏‎ֶ‏סÊטֳÿץ•ֽסֳֽזזזגזבױˆ‘׀ÿÊוִצזד׀זֱזדִזצצוׂװצ‎ּץגוֽיזגגההמווצצהפ־צווצבםזזעגז׀צבז”“םזצגזזְ‏וזÊִזוְזןהז‏ן‎׀װוהזזגוצְג‎צָוז׀זזז–ִלזצךדזבזזזךזףÝְ“גוזזזדֿוטגזˆקףזׂכפ׀ױלץזֱגו“‏בְזקזז“ÊדזְסלגאזגצזוומסבזמגמÞמּזֽע—ג־צÝג־צפיףצהםהך־וזמסבומגך׀געבßעֽםֽע–יה‏ֽמßגֽגפגÞבֿעעוß‏נבצמ•יףצÊם־ךֽגףךד“ְבבׁˆׂװןהˆױׂˆׁ׀בב׀ײגוג‎ֱˆׁה־ָׁֹׁ‘זוגלמוךץאפדעץקָ““וב‎־ײְעמ‘’ס—־ף—פןֹזÿגßֱ‘ײ—ידײֱִןזסֱצ—זבנßֱײֲ׳׀גֿױ‘ון‘ֶÊˆׂאׁױˆֱ׳׀בײסהװצמÊ“—פּףױְיצְÿ’צץ׳ײףזגטצדְÝטֿױˆ׀זזזזמזנׁ“ץוןָבßצזזגזטעז•ףגךןְצווזבלזזצבזצעגזÿ“זזצמבזצםזזמזזזמז‏׀זבוציֱזזךדכצסךכÞ—ײלפ‏ּמßךֻוְְÿלÞצנבץצאו־ך־ם־‏–יßצנבֽךÞיֽ‏–יה‏ÊםÞ“היףצ•יÞ‏Êיףצ•יֽךÞבֿ‏סמÝצÊם־ך־וְ‏סבו‏נבß“הבץצאו׀זנבִֿנבÝ‏•יףצÊם־ִÊם׀‏אבצצןץֳֹּֽ“ׁװֻכ׃־Êב‎ֲ־גִˆֻמÞֲÞנßְס—סבֲֳ‘ףÊֳ–•ׂ—ֲל‏אנמצֽײץּײקןֶ•בֶˆס׀ֻםיֹטּ–עצ‎ֶי‏—םיףÊÞל‏”לֻס–ÿוÊצםֱּÝְ“‏ף—ˆע—‏ײלÊְֲֶבÞילףטל‏נ‘ֻנ•ףה־ע‘זפְֻֽקגסעצפּ׃‎ם–’ÿ‏—ֹזע‎נץהֲּבץץֻץףÿפהֶָאֿםֻפזזזזזמזְ׀קוזֹ—בßצזקזוװזטכגא‎גץזכצצוזצזהז׀גה‎׀עוז׀זזז–ִבזצךדזבזזזךזףßזצזזזצאßזֶבֿצזד׀זטםְ‏מבפׂßוְוגזו‏נבץצאו־ך־ם־‏–יד‏•ךßמ•יףצÊמÞמאבץצנך׀ןאִ—ץגִ—ץבֳעסבֳּצ•פגְ•יּßךיְÿבץ”ֳאץֹ‎גץן‎אץֳֹןˆֹ׃ליÝֻךףדּ”פְזזזזזוזגזה•צךסוֵזזו׀זֹװצ‎ּץגזִזצגזזצבלזזגזז‏ךדזְמזזןצזזזזןזזִץגְצמב־ׂßוְוגזצךדמ׀גÝך׀גהֶכ•ױצגױִוזולְכ‎זֲףןזכÿˆפּזזזזדזאֱˆזפפום—זמ׀זßזדװזֻגׂ׀ן–ו‏צוךÊא׀װדזְצ—ךÞמִוזעהזצגזוצילא—זףםֿװכז׀מגידך־ןזצבזְגוז׀עדפֻֻכװוצנגז־זזגזוזמוואִזזְמזÿ׀‏דזְזזכּװןזצעבזבאז׀מזזה“זףו׃זן׀זוזזצהזצץֹזזמהז–—אזצךדםּװןזצעבזבזזזזׂזגß‎צוצÞךְזזךֽװÞט־“װזהךזמßָׂמְְמבÞװֿם׀‏ֽמ־‏Êיףצ•יÝִׂזֽע—יֽ‏Ýךֿ‏נבץצאו׀ִויֽעÝבז‏ןב׀זנבÝִ•יֽע—ם־ך־וְ‏סזדִוו׀‏אבץצנך׀טÿ‎ױֱֳלֲנֻמקּג׳ף’וֲÿ‏’טף—ונזצßדײּגßˆÝּיÝ’זלפ׃םצהְ‘ןְגסֱֶֵסדעÊֵ•׳־ִּ•אע•הבץףיוףֻ—“ףÿֳהץ”ֿאפןׁקֱִֽ׳–׃ßסןעז–’יצה“ֳפפע–ץפך“ןˆÝˆפ׀גÝקה‎טלגßֶזזגזצˆףז“בִ׀זßזדזקוִזְעדוְךהזזמהפְזגוצגבוזבזזגהוצגהֱזזדזזעגז׀סֹזזמזזזםÿזזמהזב—זזזמזףפמסן־מסבז‏מא־װּוְ‏ןבפך–כְמ–ךßצנךÝמ•יףצÊם־ִÊםֽע—יֽ‏”יףךסןְמסמÝצÊמÞמאבץצנבִֿנבֿעד”ֻÊֵּ’‎ֹׂׂאָ“ם‘ֿה–ֶˆ‎נ‘ֳֹֻׁהֽסױׂגְןֿטֹװÞִױנֻֿמל“ֲגכנ‎׃ײֵÊ׳ֶפÝץמטץָÝ׳“׳ס־ב‏ל•ֳװט‎םסÿÿÿוֳףה’בטוװÝױָװזזזגזצˆˆ׀ז’גֹצזּזביזעועווְענזצצאזְגכזצךוזזװגפְזבזז‏גוצ‎ֹו׀גגהזגדזְצד‎צּוזְָוזצװהזנעךזצװכזבזזזזׂזג׀זזזזּזהך־מפזֱגץגֻמֿגץגץמּדצְֳלÞצ•יßִאמÞמÊםÞך–ךÝעֽיףך•יֽךÞבִֿןם־‏ֽמזךֿבפגסמץעֿג־גהֻװ”א”ב——ֱִסÊ׳ֲÿÊßÿ•ÝÝ׃ָץועÞ‏Ý”ˆß“וÊק’ֽז‎”ֶו“וז“‏טד’צֱ•ך’’ֵÿֹי•׀צּ׀יˆׂ’’ֵÿֹזזוזדגזזזק׀ום—זםזזˆצד׀דזצְופצזגוצמבוזםזזךזוצצדונִאזצמןזצגמזְבֻהצגמהזוֳזזזזםְוךזזזזםזזּגץך־גÞצץבßגלהו׀ױםצִֿיףך•יֽעֹםÞך–ךÞִÊיֽ‏Ýךֿ‏נבפך—ם־ך־וִֿÿמץעֿבßִעו׀ק׀זֱÞדה־ױזצאֹֽ׀צגנ‘’–ֱײ’ÿׂ•‎ÿנ‏גוזאףˆֹזוזףטÿֻ’ִט׳•‏ְמ”ֻ‘־ךסָ‏ל’–ֲÿהף־ן׳’מÞֲׂ‎ְזזזזגזדְזזז’ךגֽצזÿזדֻזיֿעוזזּופְָוהצזםְ׀ְוזזִוזצמזזנ‏אזצמבזצךגזְיֻזזצגםְץךבß‏עגßגץגץגץגץמץגזװמןפװוךßעֿוßעֿבפגסמÝעֿיפג–מףעÝזףךףגÝךה‎ףְךוגֱׁׁׂׂזץכ׃ׁ–ִֽˆך‏האÿְמצ”ֲֽ”ֹֿכֲזם—ˆִמהקְזוזדהנצצֻוכ‏זו׀וופזּעבֿזד׀מוזזזוזזב־וזגדזßִדףו׃זאזצוז׀זדְ׀מוזזגוזבעהזצזזזס“זזצזוףֻֻזדזזזזזִזוßגץגצעןבÞװוגפגסמףעֿגצלוזֶףאְאֶוכֵק’Þִזִגזזזן׳צףֵˆְּאזזזדזוßוÊץגצוצזזזגזְ׀מוזצב—זזזזז׀זדגצךמבפׂßוְוגזצגÝגˆ•ָˆׁ”־׀צףֵזפÿ•׀זזזזזוˆנ—ג•ˆצוְזזז׀זֱװצ‎ּץגזעזְגוזזאדזזזזֳזזזזזךזזßגדהועױװצ‏זץזךומßק׀ˆׁטנ׀ְ‏זˆ׃װוםצזוˆמּג•ׁיוְֲזא׀ו‎װצ‎ּץכצֵאְמדפגׂ׀מ–ו‏צוּזוזגזובִזז׀זוזזךו‎׀זגוזוֱזְגזוזוקא—זֳזזמזזָצזוזגזובִזז׀זוזזךו‎׀זגוזוֱזזזגזג‎׃Þצֽג־צ־וצְ‎לגאזגצהוְ‏ֽמ־‏ֹם־‏ֽמְ‏סםÝצ•יֽךÞבִֿנבֽךÞיֽעÿװÝֻֽקהזםפז—מÞװ’ֱףֻ־קה‏ל־‏“מ־ָ‘ֱצנסֵֽ׀ֶאץ‏נצפןץ”זˆאוּ‏ב—ג׀דזזזזזזוזןװג•׀מֲוְזזז׀זֱװצ‎ּץגזעזְגוזזאדזזזזֳזזזזזךזזßגדהועױװצ‏זץזגומßךהןׁÝֻװמאזקֵזפעזזזזזזצו—ˆּ—וײ׀זזזוזזככגא‎גץזמצ“וזצמופְזהזצלדזזגזזזבÿזזגוזאזזזזגזעוִץבצךמבÞׂßוְוגוץ‏נבץצאמÞִÞיֽע—ם־‏ֹיÝךוגּינֹ׳מןפֻ׀ֿץד׀ֱֽֿעכעֻוְִנָßך־מÊגְנןזזזוזלָג’צךמוְזזהזז׳װצ‎ּץגזֲזְגזזְבלזזמזזָךוז׀מזזןצוזזִאוזךזהזגמוזְעלגאזגצומÞִןמÝעףךßךדהםײנֻ‎ֹ•ִקְג’ֶײײה׀גצˆׂזזזזהזאצגְכׁוִ‏זה׀זÿזדפßוÊץגצהּבז׀צדזצזזזסִבז׀צדזצגזÿ׀מוזזגזף׀׀ךזזזךב׀׀נגֿזזה׀זלםז‏מבפׂßוְוגזו‏סבז‏ֽמ־‏–יד‏Ýוו‏סבז‏ֽמ־‏–יד‏Ýזצ‏‘טֽצ—טָֽ—זֲמטÝצ—טףּ—וִ‏כ־—טÞ—ׂקזמכ־—טÞ—ׂקזזזזזזוזדְג•׀ןֵוְזזז׀זֱװצ‎ּץגזעזזזוזמךהזצגוֳזזזזזךזזßגדהועױװצ‏זץזגוךßךוטˆ“ִמג•׀גֻˆ׃װזזזזזזצהקוץְדכ׀נֻזזךזםױגא‎גץזא׀זזזצגזסצזזזזבֳזְגוזזביזזזזז׀זדגצךמבפׂßוְוגגÝעֿב‏הָזע‏ֽ‏—זזזמזֲצפ–ז־ְאעזזקזו׀זטכגא‎גץזכצצוזצזהז׀גה‎׀עוז׀זזז–ִבזצךדזבזזזךזףßזצזזזצןוזֵבֿצזד׀זטםְ‏מבפׂßוְוגזו‏נבץצאו־ך־ם־‏–יד‏•ךßמ•יףצÊמÞמאבץצנבֽךוֽנמ’טנמקנמ’טנךךּםהךֽםהןֽעֿוֻז”‏דּ’ÿףע–ÿףּ’‏דֱׁעעׂךגֳןךו“–מזזוזן׀ג•ְיזוְֲזא׀ו‎װצ‎ּץכצֵאְמדפגׂ׀מ–ו‏צוּזוזגזובִזז׀זוזזךו‎׀זגוזוֱזְגזוזוקא—זֳזזמזזָצזוזגזובִזז׀זוזזךו‎׀זגוזוֱזזזגזג‎׃Þצֽג־צ־וצְ‎לגאזגצזוְ‏ֽמ־‏ֹם־‏ֽמְ‏סםÝצ•יֽךÞבִֿנבֽךÞיֽעÿז—ז’‏Ý׀ׁצה‏ֿך־צײטÿ—“‏ֽ—ÊטÞָּט־ךײטֹ—בֻנ“אּֿנבּגׁו—ֳ׀קßְ‎בßֿוךז׀זזזזהזְֱ”צלֽˆ–‏זה׀זÿזדֲßוÊץגצה׀זזזצוזצמזזנִזזְךדזִֻזזְמדÿ׀עוז׀מדף׀׀ךזזזךב׀׀נגֿזזה׀זלםז‏ןבפׂßוְוגזה‏–יד‏Ýךֿ‏סבז‏ֽו־‏–יד‏Ýךֿ‏סבז‏ֽזֽצ׃כפג־כה׀־מפ—׃מפמװכהכßהֱָןÞָ׳מוײ’ÞֱָןÞָ׳מוײזזזבזפק”צטםˆ–‏זה׀זÿזהךזכ׀זזב‘ßוÊץגצבךגזְמזדזעכז׀ָבזצ‏זזנִזהזִםהבִזוְ—וו׀ּאו•ִזהזְםÿ׀“והצְםףÝז׀םהצ‏אז׀ךזזז׀טÝז‘יֽצּכÞצׂל־ְ‏מßְ־ןֿ׀ךב׀׀נגֿזזה׀זלםזןבפׂßוְוגזה‏–יד‏Ýךֿ‏סבז‏ֽך־‏–יד‏Ýךֿ‏סבז‏ֽך־‏–יד‏Ýךֿ‏סבז‏ֽוה‏–יד‏Ýךֿ‏סבז‏ֽוה‏–יד‏Ýךֿ‏סבז‏ֽזסז׃כפג־כה׀־׀Þ—׃מפמװכהכבכפ—־מפ׀װמֱ‘אכפ—־מפ—׃מצג•כפ—־מפ׀װמֱגלֿֱל־ְּןÞָײןßײלפזֱל־ֱָןÞָײןßײßהֱּמהָױןß׳מÞֱָןÞָײןßײזזזדזפ””צטזˆ–‏זה׀זקזוװזֻכגא‎גץכװויצנגזִזְגזז׀‏הזצצזזנִזוזעבובִזוזצבÿ׀ִווצצבףß׃כװוסצנגזֿזזךוזזיסזְגזוְגווזזו‎׀זגוצעגס׀זגוזסֱו׀גבוזסקא—ז־זזמזז׀גהז•עזזז‏וזצצזזנִזוזעבובִזוזצבÿ׀ִווצצבף–ֻ‎צו‏צגזזזגוװצאֿ‏עד׀“ידזזכזזָּהזִסלגאזגצזםֽע—יֽךÞבֿעעו־ךֻמץעֿזה‏–יד‏Ýךֿ‏סבז‏ֽזßז׃כפמֿכפ—ֿˆֱװוֵˆ‘ץזֲך׃כפמֿכפ—ֿˆװצײןßײלֿֱלֲֹֻˆׁ“ײןßײלֿֱלְזדזפÝ”צטזˆ–‏זה׀ז־זה“ז“ֵגא‎גפ–דְגבוְבלפזףעבֿזן׀ךוזזצההזךווְזו‎צזאוצעאס׀זאוְסֱהְִםז׀עאועֵפזסעבֿזםזצוזְגזזֻעדזצזמזצגאזזבֹזז‏בוצ‎ÿזז‏אוסלו׀ּדוצ‏בףß׃כװו’צנגזֻזזךגזצמוז׀םֻזזזמזצגאזזבֹזז‏בוצ‎ÿזז‏אוסלו׀ּדוצ‏בףß׃זכזּווצ‏ןוְעןְֱזדוזגהזצךה‎צזזהזגווְזו‎׀זאוצִאס׀זאוְֱֳהְגןוְֳקנסֻ‎צו“ֽמ׀׀ךזזזֽכ־ך׃לפִךמְ׀ֿאץְÿבֿעעזזװזה־צכוßעױװצ‏זץזזÊיףצ•ךÝמנבץצאמ׀צÊיףצ•יÝ‏•יÞך–מץעֽבֿ‏ÿבֿ‏סבז‏ֽוה‏–יד‏Ýךֿ‏סבז‏ֽזßז׃כפמֿכפ—ֿˆ׳ע׃ו׀ְיד׀טִזÿט‏ז׀יהזִװמצגָכפ—־מפ—׃מֱגלֿֱל־ֱָןÞױנלß“יבוז‏ךÞßֲÿ־׀ÝאוזעדץײגפֱָןÞָײןßײזזזזזזגהוˆגזײקˆסְזכזהֶßוÊץגצוװזזזגוזבִזזזזוÿ׀מוזצזוף׀זזזזװזה־צדוßעױװצ‏זץזזÊיףצ•ךÝמנבץצאמ׀מ–כ־—ֿמ־׀װמׁגכו—ֱל־ְּןÞָזזזמוֱֻגזßÿˆסְזכזוִזךױגא‎גץזם׀מוזזגוזבִהזצזזזסבז׀צדזצזוף׀׀ךזזזךב׀׀נגֿזזה׀זלםז‏ןבפׂßוְוגזה‏–יד‏Ýךֿ‏סבז‏ֽך־‏–יד‏Ýךֿ‏סבז‏ֽזִךׂכפמֿכפ—ֿ׀־“ׂמפמװכהכßה׀ֳןÞָײןßײכו—ֱל־ְּןÞָזזזזזז׀אסˆְזדבֱנזזװזב׀זֽזגלßוÊץגצדִהזצזןז׀‏דזצצזזנִזוזעבובִזוזצבÿ׀ְווצצבףßְ‏דז׀זזוְֽאהמֲןז׀ÿדו‏פגזזכזזָּהצִסלגאזגצזםֽע—יֽךÞבֿעעו־ךÞםֽע—יֽךÞבֿעעו־ךאםֽע—יֽךÞבֿעעו־ךו׀Þ“׃מ־ג׃כפןהכ־“ֿמ־׀װמ׳ך׃כפג־כה׀־ˆװצװןץײלֿֱל־׀ֳןÞָ׳מוײßהֱּןÞװײמו׳זזגו־ˆֱזßˆˆקצזדזההßוÊץגצועזזזגוזבעזזזזוÿצזוזזביגץזהוß‏ױװצ‏זץזעֿבפגו־׀אעˆÊÝדÿְזזזזגו׳ק”יז׀ױˆקְזנזב־ßוÊץג׃צמוז׀זופּׂ׀הֻו‏צוְגזצךזזזיׁזזגזזזבסזזגוזב—הזצזוזג—ֵצוִגזצךזז“צזזצזזזסעזזצגזÿצמוזזגזףסֻזדזזזזו‏זבץגץאזעןבÞׂßוְוגזה‏–יד‏”יֽ‏”מÝעֿבפךנבִֿנבֿעעו־ךהטה“או׀—ץז’צו‎׳גדגצ“ןו־—־ˆִ—װןצ—ףגו׳הקאוְט—מֵגוךיןÞָזזצא‎ˆֲּדגׁזו‏זנכגא‎גפ–זְגדזזבלפזכעבֿזאזצוז׀זזז•זזצזזזסעזזצגזÿצמוזזגזףץ׃זב׀צוז׀זדֿזזוזזזוסצזוזצוֳזְגזזצוינעזךזזזזבְזסגץג‏וצִÿלגאזגצזםֽע—יִֽ•יִֽֽיפגסמß‏נבß‏נבץצאמ׀מ”כְִמדץזדֹ׀ב’Ê׀ךצדצְןכפן‘פ׀ֳדץצצאףעׂÿֻ“ׂיץּץגְ“ֱלְזוזכ‏בך׀בעוִצזה׀זÊװצ‎ּץגזֵזזזוזצוÿזזזזזסהזצגזזעזזזזכזזָּז׀ִסלגאזגצפםֽע—יֽךÞבֿעעו־קּכ־—־מ־—׃מְעÝלß—ֱל־ֱָןÞּזזזזוזכ‏בך׀בעוִצזה׀זÊװצ‎ּץגזֵזזזוזצוÿזזזזזסהזצגזזעזזזזכזזָּז׀ִסלגאזגצפםֽע—יֽךÞבֿעעו־קּכ־—־מ־—׃מְעÝלß—ֱל־ֱָןÞּזזזזדזְֽעצטֱˆ–‏זה׀זÿזהךזפכגא‎גץזקצזזוְגוזְזו‎׀זהו׀גדוזמד‎׀זגוצעגס׀זגוזסֱהזגבוזסקאוְךדזזזאהך‏מֿ“ִדוִךבֿמצזזװזה־צםוßעױװצ‏זץזזÊיףצ•ךÝמנבץצאמß‏Êיףצ•ךÝמנבץצאמß‏Êיףצ•ךÝמנבץצאמ׀מ•כ־—ֿמ־׀װמֻ—ׂכפמֿכפ—ֿÿפ“׃מפמװכהכßה׀ֳןÞָ׳מוײׂפװֳמהָױןß׳ׂ־׀ֳןÞװײמוײזזזוזט“הדצאכזײזזה׀זÊװצ‎ּץגזֵזזזוזצוÿזזזזזסהזצגזזעזזזזכזזָּז׀ִסלגאזגצזםֽע—יֽךÞבֿעעו־ךואÞ—׃מפמ׃כפמהדפ׀ֲןÞָײןÞזײזזזוזקזבףצכÿוְֵזז׀זְװצ‎ּץגזסזזזוזצוסזזזזזס—זזצזוףץגצזְִנלגאזגצףמץעֿזןֹˆּֿבׂאװזזזזווטגבך׀סוִצזה׀זÊװצ‎ּץגזֵזזזוזצוÿזזזזזסהזצגזזעזזזזכזזָּז׀ִסלגאזגצזםֽע—יֽךÞבֿעעו־ךבדÞ“׃מ־ג׃כפגבךÞװֳןÞָײןß׳זזזוזלזבך׀גוִצזה׀זÊװצ‎ּץגזֵזזזוזצוÿזזזזזסהזצגזזעזזזזכזזָּז׀ִסלגאזגצפםֽע—יֽךÞבֿעעו־קיכפ—ֿמ־—׃מְעÝלß—ֱל־ֱָןÞּזזזזוזד”ˆזפִוֿעזלצהנפז‎עבֿזגֿ“וז׀ִכזצמדלצגלזצזוזזָגפֿ׃זגß“וז׀ִכזצמדלצגלזצילזזגגזעֻ‎פז‎עבֿזמְזןזזךהו׀יֹהצעהזצגהÿצְאזְמהלגװזהְָזÿ׀צוזזזׂזג׀ֵצה‏זו׀זדזְִד‎׀ּבזְגוזֻ—מוְמהז־ֿכזזצגםּװזהְָזÿ׀זזזה“זףבֻזגהְÊמÞמעמßגץגÞצץגÞגכהו—ױמצ‏ֽמ־‏–גפך–ךßג–ם־‏ֽמְ‏סגפךץמÝעÝיףצ•ךÝמנבßעץךßעֽגץצנךÝמ”וםßזף”אםßִעֳִה’‏ÿױׂײײױפְנֳ’ִÞִּˆיÞְׁבמ־‎זײהיזצִ‎דß‎ׁ‏ˆ׃ףז‘•יִ‘ÞיÞ–׀ˆׁÊיˆסךיְװזזזזזזצוֱˆ׀אסצ‏ץזבְוטּׂ׀כבו‏צז’אזצגהנזגמו׀זוזזְדפֿ׃זדּ‏ווצם‏זצְןזזגזהזילנעׂ׀בֻו‏צדצזוזגןזצצןְֱזןהזגןהן׀זז׀ךלÿ׀זלה־ֳכדזעהזצגהÿצװםזְמהלגװיזצְמזבאזצזזכְוךא—ׂ׀אסו‏צדמזוזגןזצצןְֱזןהזגןהן׀זהְזדזְָד‎׀׀בזְגוזֻ—כהצמהז־ֿכדצגמהזוֱוְגזזה“זףו׃כװהßצנגזזזצוו׀גגו”“זו׀ְוו׀ֿזזָזז׀ּלז•ִךוצמוזצֱֻזזּםךגװךוצמוזצםֳה׀גהז־ֿכדצגמהזוֱוְגזזה“זףו׃זטְזגזצִווזֳזזִמזצִמֱזזלזזךםהְיֹזזעבהסזהצּ׀פ׀׀וזצגהÿצװוזְמָפ׀—והזְזÿ׀‏וזזזׂזגß‎נסֻזבֳֻסע–םץעג–כץעךֽגÞ“ֽלהךץגÞגטהו—ױמצ‏ֽמ־‏–גפך–ךÝע—ם־ך־וֿעעבִֿנבֿעֽמÝצÊם־ך־וְ‏סבו‏נבß“הבץצאו־ך־ם־‏–ךß“הךÝמ•יֽע—ם־‏ֹם־‏–יד‏•ךÝמÿםֽע—יֽ‏Ýךֿ‏ÿבףךסמßגעךÝמ”וֻסזף•כׁכßֿ‎–‎ֳבֿ‏ֵא•ֿעיÊֳבפנז׃לנ׃ֻ־ל׳ףֶכ’־װָֻׂ׀ץךִףםֶף‏Êֵאֵוßנפ”ֳÊ‎קכבֳֶֶֽׂױזִֹםֳ־ְׁבםֽׂזָטיסÊßסְּÞנּוקֳּװׂסִֽ׃פפָױטפ“נן–ץ‘ס–‘ץענט־ÿגֵֿלהֻןכפ–הטועָּןנּב‏ֳֵֻבץֿגÝ־ֲֹֻיˆÿÞֱה׀זוזמהֽזךיזÞמזז׀זֲצוװזזזגוזבעזזזזוÿצמוזצזוףצזזזזךזזßגדהועױגÝעֿב‏הְֱלךֻ׳‏זזזגזזזזזזזזזזזזזזזֲÞזÊצהץנוגךצזזזזגזזזזהזגבךֳָ’הÿ׀צזדהזזזזזזז—Þבֹ‏ְזזזזדףמנÞײˆמֹעצֳ‎האמזזזזןזזמזזזזזזזזזזצזזהאכְָזזו‘כ־ֱײהו–ּזזצזזזזזזזזזזזזזזזזזזזִבץ׀דזזזזזזןזזזבטְזִוףָזןזע‘זו׀בטְזִוףָזןזע‘זו׀בטְזִו”ׁˆזףזלּביצו”וףעזֳ׀סזזלּבצזזאומ׀זײצפךזלּגֽזה׳ומ׀זײצפךזלּגֵזה׳וÿךזְֲנ–זלּהכְה”ז־“ז׃׀מׂˆּהכׁˆעז־ˆÝצץײזדעבוצה׳וגזײצֵזלּב׃צה׳וֵעזײצנהזן‏בְְו•ו‏מזְֳנהזן‏בְְו•ו‏מזְֳנהזן‏ןְָו׳וצ—זײצפ‘זל‏בְְו׃וט—זײצףזזבגבל׀הקוך‏זךְע׀זמ׀בךזהךוףזזֽזע׀זמ׀בךזהךוץּזןצִ‎זד—בוצז‘וך“זד׀ףטזזגÞ׀וÿופצזװְסךזכמבקְהÞו‏ךזְֱנעזכמבױ׀ווֲגזְֱÿּזן“גנ׀ו׃ובװזֵצץֵזא—גנ׀ו׃ובװזֵצץֵזא—גנ׀ו׃וװמזףְץזמ׀גךצוִודגזÿזפגזבגװצוודזÿצצˆזב—גק׀וֳודזÿצצˆזב—הÞזזון“ז‏זץָזמ׀וְהטזֱ׀זֹזןזם׀וˆקˆקזֱÝˆְׂ