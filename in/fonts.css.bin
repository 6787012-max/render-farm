ֵ—הֽ׀זֹזהֻזאצּ‎דב‏ֳב׀׳עז׀׀םןצצדדפצקפßצֿדעָקזז—ױלßדגזדˆלÞװץטףּßךהעעו־ך־םÞ‏–ידךÞבֽךÞיֽע—םÝע•יףצÊמÞמןםÝ“וךÝמÿבֿעעוְִנבß‏וׁ‎Êהי־ִ•ךפם־םÞָ”װ“צˆכעעײבß׃׃פּע׃ך־ךױיְִֿ“ננבדß‏ׂכ–צ•לָ‏“אץ’ֳכה’םה—ֿעמ־סדכÝּעמ־ך׳זזמזגזזזזִ‏הְֽזלזז—זכעזֵהז׀ןדס‏כוזָכהֻ‏זהְ—ןוזמךפ׀׀םהצßכוזגילצױזדˆלßדגלÝּפטףּßךהעֽבפך–מÝעוךßגÝמÝעןזִ‏•ֽקצופֽ‏•׀׳אם־‏ֻ׃ז‎ֽֶכ•זזגזגקˆ’זִמה־צזֲזה׃זאֿמֳבץ“זזסעיבצֻÿןצךיס׀זוהְ—יזזץלב׀ִיל׀זˆקÞװױלßגפטץגפטףג׀זצִֽוÝמÿבֿעעו׀‏ןו־ך־םֽע—ךÝמנךÝמ–יהִÊםÞ‏ֽג׀ןהטˆ“ץֻֽםְבפץאצסודסדטֲפ‎ÊכÞ‏ֹפָ–זָÊאכֻֽד־פעֹץהע־כוװפÊֽל־ךצן׀במזזמזגקˆ“זִמהֽצזעזהצזפגזײדזװידßגÿסזךֿהץֻסבßגיסזװיהְװגז׀—ךדץעקאץגסאץװיזגװןא׀–כבצזילÞװצßודגגךצץטץגפטצזˆקÞװױßהװץגּֽץגּֽßךהעעו־ך־םÞ‏–ידִ•ט׀גסוְִ•ךÝמÿבְִ—מÞמןוֿעעבß‏ÿבֽךÞיÝ‏ו׀ֹֻףִֽ“•ֲ”ה׃א׃“׃כּ׃דל־נקנץצסהצָטא׀“ֳמ׀ְה—בפגנ—”־ÿ׃׀בהׁבאגִ‎ֶ׀םד—ג“קסךעדד—טזזזוזוזזזזןכז׳צזהזז׃צוװגז׀ִאזצְדנזזאהִֻזז׀ָודזזגפז‏מהעְןוְ—ױל׀זˆקÞװױגּֽץגּֽץטףג׀זצךֽגÞך־וÞך”זִׁסע‘׀ÿֵּֿךְלעˆנ׀הה—ֱצזזךזגקˆ’זְֲהÊזזÿזוזלְזצהעֲמֿ׳עופְםסוזֶהֿזגוצ—כםז—נמגװ‏בז–כדץ׀םדעװםםז–כמזזילÞׁגלÞװצßוגפטצזˆקÞװױגףּ’ךףזֻבז‏ןו־ך־םÞ‏–ידִÊיףצ•ךÝמÿבֿעעוß‏ֹיהך־בץצÿיֿך—ם׀‏סבוִנךÝמ•זְֲÿןג׃–ÿדלֲ•–ˆ‎—מ–טנֶֶײ—ךֲÞז‏ּÝע‏ןדעײיִֵֻיץ׃םלדוÿÿעוךֶÝ’ֲלהßזנףֻצ—ÿ’ÿטסמֵˆ׃ֻצעּװ‘יÞךָט׀זזוזזצזזזוׁ׀לֽזוְזםצזזגװוֵְזטהׂ“זג׀ׁׂזויכְזזיÞ“זג׀צׂזזק—כְזדÞ‘זזְזד׀זזגץמ’ׂזזזגכְזאֳßווצדֶזוּז‘ְז‎זזםֳצץװזהצז‎זוּזאצז׳זוּזטצז‎זגּזאצו‎זוּזֶצז‎זןּזאצהםזוּזÊצז‎זלּזאצה’זוּזÞצז‎זז–ֳׂזזס—כְזבפ“זזצׂזזֲ”גגֵזז‏זןְזנזו“זםְזֲזד‏זןְואזו“זסְזֲזא‏זןְו•זו“זְֿזֲזם‏זןְהÊזו“ז׃ְזֲזך‏זןְזיÿעגבזיעזןְדֻזו“זזֻ•“זוּצׂזזּ—כְזםה“זזזצׂזזÊ—כָזכְזקזזזץגֽÊ“זזצׂזז–—כְזאץה“זדׁצׂזזכְזאץה“זדˆצׂזזֲגכְזץיה“זוּצׂזול—כְזפ־זׂזזבכְזלÞ‘זוךזןזזלְזגßה‘זהמזהְזלְזמֿה‘זזְזהְז־גץמ’ְׂזׂזזָזמֿגפטְֵזהֿה“זדדצׂזזףגכְזטֳה“זו׀צׂזוה—כְזמֿה“זגֽצךדגובזִטזפך–יִֽאמÞמÊםÞ‏–ידִ•ךÝמÿבִֿנוÝצÊמÞמסבוִנךÝמ”יִֽעו׀“ומÝע•י׀‏ֽמ־‏ֹםֽע—יÝ‏Ýךִֿנבß‏ןיה‏ֽמֿעעבß‏Ýךִֽ•זֵףלֳײה–Þצ—םÝ‎Êד׀ßגצבÿםּ‏Êמ’מל־—טבֽך־ג׀ֶפגÞְֶֹ׃ִּצץָ•‎ְךץגוֱבÞ‎אם־טפטÞָ׃דֿ‏Ýמֿךאז‎׳יט”ײ‏בֽײˆןגִÝםעסִטףִץן—ֳוִÿניÿג—‏ֿמײלע—ֲ׳ְנטױִץÝךֻץס׀’יßגֱץ—בßֳ‏–ִףףß־ג־ָזזזמזדׁˆ׃זטמהף׀זדזזִזז׀זßךוךןםÝִףוÞִ”“Êßֵָא‎ײֶאָו’נֻ׳ֶׁ“ןֶנ‎׳זזזהזזˆְֲהזִּזז׀זסזו׳זדְ׀גס׀“עהצצטהז׃םדזצילÝּזקצױגףּßךוךןםÝִףבזִאוÝִ•יפִאמÞמÊיףצ•ךÝלנבֿ‏ףÞ׀ֹיצםקזצװ־אהמָן–ְוב׳ֶסˆ”ןךÞװÊגוְ׳קßעיםßְְכזזוזז“זֻזאךזֳ‏זוְזנצזָזז׀עווז‎זזצ‏טלßדגגּֽ’טצזßךה—ויפעסדצגוֽק‘הזÿ•זגָֻןסֳִג׳ענזזהזז“ז–זאעזֳגזז׀זןזה’זאצגןזְךזוֻ‏גו׀–נזזךיז׀צןוְגןזגזוזז“ױגךצצßוג’טצזױלÝּץגּֽפטףג׀זפג–מץעֿיפגוֻק’‘ז‏ֵְֲאאזÿפˆס‏זזזגזדְהֳז‏׀ו—צזאזוßזגבעגוצ–עז׀‏יז׀‏זועזהזז“ױßוג’טצזױלÝג׀זצע–כצג–וצאךˆָמוצˆ‘זÿ“והנßדנבץבֶ׀זזזְזטˆˆְוֿזלמזהךזם׀זÝצו–עג־גיהוְÊוß‏ֹםפעאםז’לןֿ‏ימצ‎מו׀‏יפ׀“זדפװױגךצױגךצצßודגגץמ’טףּזלÝג׀זץצןוְִאבצִֹידִ•יÝ‏–יהִÊמÞמןוֿעעבßצֽמ־ִÊיףצ•ךÝמנז׀ִֹי׀אגךה׀׃ךו—וגß‏ֻוֿמסןß׀סאץםדאז“ךִביי‎ֹגץעמו“פּ”ךדז’כצמףבִֽֳוְֳמ־זֻדזֶוֽצבֿמ‎טססֵˆְ’דץעךזזְזטˆ”ְה’ְםכזגגזעזוֻצדמבץ׀נב—‏׃הֻצ׀ל׀–עםד׀יבßבעץֿגיסז׳יהצ׳עוֿ׀יכ־ז׃ץְְ׃ב׀ְפֽ‏׳דףßהפו׳ההֿ׳לבִֿיפְßכדעְְזז—ױלÞׁגלßדגלßדגגךצצßוגפטצזױßהװױגךצױלßג’גץמ’גּֽ’ךףזובזִאו׀‏ֽמ־ִאמÞמ–יד‏”יֽךÞבß‏ÿיÝךדוֿעעךÝמ”יֽע—םÞ‏ֽמְ‏ןוֿעצמףמ”ב׀‏ֽמ־ִÊםÞ‏–ידִ•יÝ‏Ýךִֿנבß‏ביהִÊמÞמןדְגסבדךÞיÝ‏ה’ֽמ•יß׀םףץצ’צÊ–בכ־ְְלץמנגְ׃יץְעׂכ־ְ‘פג׃Êֲֵ“ְדצג’‏Êצצֳמלףֳףע‏א–׳ףִ—ֶֻסגֻאןֿףˆß—כוֿ‏ֱל־“׀עהך‏זץ‏עִֻלוע׳ל־ֳֽמץ׀םה־מ׳ˆׁגףוו““עּ‎ָע–ֶםִÞ—־ˆױּמֽ׃ÞךÝָץֹםּÿה‏‏טֳֽציÞּ–ג׀‏ÿמאװ“סן׳ףזזזוזזˆÞ׀דאז׳ִזדצז—צהזדזְץעזז—םסזמגהְמצזומזז׀—ןהג׀ודצֻךזצצםפצגמדפװױלßמ’גףּ’זדˆלÞװץגּֽßךוִֽגףךסמÞמסגץצÿבֽװוßױ־“ףהָ‎דץװ–יצכךבפÝֽעמוזזזזצזטזזזזצםÿזזךזוגזהזזˆךףזÝמ׀ךÝףפױך׀םÿזזזוזזˆÞ׀דאז׳ִזדזזׂצו—ךסזװלהֻצזזְּכגזזפו׀ָךוּ׀זהְ׳ךזזמלפצ‏זדפװױלßמ’גףּזקÝױלÝּßךוִֽיףךÞיֽעץיהװויףקאׂדִײבפֻיׂדענאהּהך־“סזזזוזז“ז•צאןזֽךזוְזץ׃׀מבז׀‎זזצ‏טזהװצÝףּ’ךףזֻמ׀װומßךÝז‏ֳִ‏בֲ־•ק‎זפֹ–׀בֶזזזוזזˆְ׀מםˆמזז׀זףצזָהסצזדדציזזצזטלÝּזלÝּßךזעֿיפגההֱ“בזֱ׃ק׀זזזצזטˆמז•׀לָזוװזןעזץזועמדְזףפץךלהֿך‏בעּבאז—ױßודגל׀זˆלÝג׀בÞך־םÞ‏זףצֹיֽ—ויד‏Ýוְִאןצגעוß‏ֳזץצÿב׃װנץץּסץגצ•עÞװצדע׃כדוזמß–מּעָץדבאÿץדָלןßֹֻּׁעץדסײ‎ךוְְזזגזדְזזזדװהֹ׀זדזוץזהְךהגזזמז—ְוזז—ױטצזˆקÝּßךדךֽגףךכפ—הֹ׀זזזצזטˆמז•׀לָזו‏זןעזץזזװזדְ‏ףפץעיהֿעכזּּםזְ—ױגךףגל׀זˆלÝג׀ג׀‏ֳזץצאמÝ‏זףצ”םֽ—ויהִÝךֿ‏ֳזץףֵצֽץנפעֻםפֿםהי׀ג•גּÊץפֽ“כ‎׳ֶֻדץץפֹÊזץט—טÿף׀זוזז“זˆזאגז‏׀זב׀זßצו׀זגזּכדועגסצּצהצּףוßךססצצסדעּךה׀–םב׀זילÞװזלßדגßודגלßגפטףּץגּֽßךזגעו׀‏ֽמ־ום־ך־וÞך•יÝ‏ÝךֿובֽךÞיצאגאוװׂבֿ׳ױדצװּוףּבאֿ—װא׀–ְגֿךֽזÿצ׀מ־‏טטְִ–כ־מÊהדָכךְזוזגזלצבּזְְזגְזםװ—זהה׀“זלÝג׀םץצֽמ־ִÊםÝ‏ˆזף‏Ýךֿעעוß‏ÿבְבּדצץןב‘‏ױסגְוזÞְכפ’אי׀’אב׳ִֻפּצ’דֿןצטףֵֻזזגזÿזאזקצהß׀זפזוֳזדז‏יסְךידצ—כפז‏כדפװצßזזױגךצßךוךעו־ך־םֽע—יßעאבץצÝךֽ‏Ýךֵֿ—םֿװÊך‏בףג׀‏‏וֿ‏ֳזֱִָמד“ֳֹדזניד‏ְההזזזזגז‏זאזקְהß׀זפזובזהס‏ןגז—ןפזעזדפׁגזהװßךוךעוÝע•יףצֽמְ‏ֽמ־‏–יד‏Ýךֵֿ“ְסמפוְֿאבץ“ÊאÞ‏ßזÊםÞךְֿÞיßממו‏ֵמד“זזזמזמצאˆזְֶהß׀זנזהװזך—זֳןצ‎נםָֿלםְ‏ץסְךץדץִֿמְ‏Êםגְֳםז—ץד—ְאד׀—ױגךצױגךצץטףּ’זהװצßךצױגךצßךזגעו־ך־םֽע—יÝ‏”בצ‏ןוֿעעךÝמ•ךÝמנוßצאמÞמÊיףצ”יִֽסוֿעעךÝמ•ךÝמנזְֶָא־‏׀םפמ’לץז‎גצ‏‎וßעֲÞִ‎םֽמÊמÝֿץגז‏‏וßעֲזֱ—ֵמÝ“ָט־׀ײגץצ‏גֿ׀ֹןזְֱבßָ־צהִ‘כהְףבפ׀מזְְזזזהזהגוׁ׀אָזװִזג׀זײזה–זאֻ‏ָן׀ָָגץץנהוגיז׀צטהוצֱפו—עדצֿמוְזילצױßוגפטףּ’זהׁגגךצױךףזובז‏ןיף‏–יהך־ו־ך־םֽע—יֽךÞבְִעו׀‏ןיף‏”יֽע—מÞמאמÞמÊיףצ•ךÝמנזֶֿםטבמצוßְןבץ“ֹאפ‏ÞÞע־טפּצאץגאאצִסן־ְֶםֽזה‏ד׳סגֿעװקפזממו‏ֶמּזֹט־—׳גץע‏גֿ׀Êןצְֱבָֽֿק׀זוזדְזִזןלזְךזה׀זט׃—זדהצ’זוְזטל׀זױךףזובז‏ֽמ־‏–יד‏Ýךֿ‏וÞֹסעסןס–סבץ–זף׳עֳֹ‎עסןס–זזזוזזזזÝצןאזק—זז׀זףצזָהסזזדדציזזצזטלÝּזלÝּßךהעֿיפגוßׁ“‘זִֵיךזזזזצזזזךדֽזדˆזזךזג—זלזֻצזז׀—דצזגזד־װ’זהװ’ךףזֻמףעֿז“ÝֳזטךÝÝזזזזגזקזז׳זסמההזזפזזÊÝצזעקדְזױךףזווְִאד׀ג־יףצ”ם־ִÊיףצÝךִֿנזסמױסה׃‎וצ•ְכפßמדְץןמצגנםעָױעְגטדמ“טס׀סדּ‏ְזזזהזדÿˆְֳןזזּךזן׀זָזדבזאß‏‏ןÞְְאץ׃סזֿװםמהמטדבצ־דז—גזְְאפְּÊדפװ’זדˆגלßדגגךצױגךצץטףּ’טףג׀םצ‏ֽמ־ִןמÝִÊיףצ•ךÝמÿיÝךןבֿעעו־ך־ם׀ךנךÝמ”יִֽדם־ך־ו׀‏סבוִו׀ג׃•בהמßמֽי—ְאװאן־׀ֽכ—װÿג־עÿ‎פמÿך־‏ִמÿָÿאעךּמגפִ׳צÊלֻֽׂצֵ‏ְבֱמִ‎טßמֵיקֳדו—נךצגוהף‏ׁץנָ“זזזהזזÝˆזןײזײצזק׀ולזםßזÿ׀‎אפה‏װךֽ–ד–צמפזֻאט–‏גט׀ּ’גסצ–ךְּ–בֻצֱכז׳עבּֿיגצעץזיןßזמהזצמגּֽץבßְכךÝִ—יעזץבְֵטÝץלבֽעםיגָָמ׀–לאÝזםא—ָ‎ךְּ‎בְֿכבְּץטצ–מה—‏ילÞׁגגךצצßהׁגלÞׁגלßדגגךצץגּֽץגּֽ’גץמ’גץמ’זדˆקÞװצßהװױגךצױגךצױגךצױגץמ’גץמ’גץמ’ךףזֻבזִאמÞמֹו־ך־םֽע—יÝ‏Ýךִֿ”יהִÊםÞך–ךÞ‏–ידִ•ךÝמÿבֿעעו־ך־םÞ‏ֹם־ך־ו׀‏סבוִÝבפךנבץצןבֽךÞיÝ‏”וףצֹם־ך־בץצÝךֽ‏ו‘ְ׀׀ֳֵֽÿיהֳםֿ׀‎לוזִז׀ְאו•ßױוÞ“—‏ףגֻכוװנמצעהז׀ָױךּֿעה”–‘זץֿיפפּֿהÝכײּֿעדהָבÞÊמהß׳ײקף“ֿןה‏סגְעץםףְׁכ־—־מנסזץß‏‎כֿ‏ֱןß׀ֳןÞ—ּיÝוִכץךִךְֹֽג׀‏ָצזִבופ‏ּמְזהזדֹˆזבִז׳גזצְוצזאֻזצזמעוָּֿיה‏כּואםְ’זדץָטוּזבףְ“ׂגז‏נםֽ‎זףֻֽזץּּÞטצָÞצ—ְלְָץֿֿמפהגלפגּץאז–מהֿ׀להּֿדזז—ױßהװױßהװצßךצױגךצױגךצצßוג’טףּ’זדױßהװױגך—ץטףּץגּֽ’ךףזובז‏ֹמ־ִןבִֿנבץצאמÞמֹםֽע—יֽךÞבץצןבדךÞיףצׁזפ‏–יד‏ÝךִֿÊםÞ‏–ידִ•ךÝמÿבֿעעמÞמ–יד‏”יהך־וֿעען׀גנוÝצÊמÞמסבוִנבß‏Ýךֽ‏וÿדךײוזּהם׀“נצֽמױמהִ‎גÞִִקעצ”‎ִֽ—לזּםלז׀‎מßÞםֿ“־ל־‏פהףִֵםץ׃׀פפ׃׀םדּךג־ּׁןץְָזףךײקצמוז־זפן־‏ßיֿךÿלוך‎מְֱןעגֽכבמ—טהָז־צץמפצßאּֿעבÞצװמ׀—סהֿװֱא־ענÿדßֵמ•‏•בßךֲמהצֱזזזדזהֵˆְכפזײצזה׀זֶזדְזפעזׁאÞ׀׃טד‎עךהִיסהז•דסצדב׀ֻעהץזלהץזדההװ“כפ׀װטגָֽיז–זטוװטפצ‏ףדעּךזז—ױלÞװױגךצצÝץג’זדˆלÞװױלßמ’טףּ’ךףזובז‏ֽמ־‏–יד‏Ýךֿ‏ןיהִÊמÞמאבץצÿבֽךÞיÝ‏ֹו׀‏ןו־ך־םֽע—יÝ‏ÝךִֿנןצגֽכְגֽמְִאבץצÝךִֽה—װטץּװֵאּ׳ןדי–וףֲֹׂÊע–ץ‘ֲבץץֲוזגי־װֲ‏ÿבהקֱֻּלדעץוד—׃ץ־צֱֽ–ךÊזעײץßֶפּװֽםּÿ׃‎ÿכץֲ–ֵֿÿבּÊץֿזכהנ‎ְסÝִÝהצװףץ־׀׃ךÞ–ם׃ֻ‏זזזמזמצזֿזֳגוָזזצזהגזדֵעֵהּזההְ“זלßדגךףזֻבהך־םÞ‏ֹיִֽ•ךÝמסבזִÿבְִעמÞמֹם־ִ•יÝ‏Ýךֿעעוßִנזֳגכוו‎ע‎נ‎ֳדצךלְגְ’—ְװגבֻץֻ‎ֻ—יז׀ײזפדּװהß‎פנֻֻ‏דזװכײס׳לגצװנעֻ׳‎נז׀כה‘ֶֻפְזהˆˆְבׁז׳צזאְזֿזןםזץ׀ךִאßמףסוגִהֻצזאְּףגסצכא׀–עוז‏םזֿגצוזְזהזזֶב׀עְהß׀אגֿךֶבִֿואß׀אפ׀גֶהעּימז–םז׀ָלפ׀ךאהִּּז׀–םזץִילÞװױלÞװױגץמ’גץמ’גףּ’גץמ’גּֽץגּֽזקÝˆßהװױגך—ױלßמ’גץמ’ךףזבמßגֽגפך–ךִֽ•קצג־יףצ”יֽװובפמאבץגעבֽךדגפמןוֿעעזנךן—׀דצײֲכהֳ‏–־׀ִןהÝֽטß‏קוְלמˆÿְפג׀“Þלץסםהזקןפ”אÞ׀ֲזס—ואפֳּצ׳גזזצזזךְז”זב׳זזװזדױֳ‏ז׀ּיפ׀‏זדפװזלÝג׀גßצאמÞמÊיףצ•ךÝמנ”ה“־מ־“ׁמפגׁזץּ־כÞ־מפׁזזמזמ׀זֿזֳךוָזזצזהגזדֵעֲדעזגדצ“זלßדגךףזֻוְִאמÞמ–ידוםֽע—ךÝמÿבְִאו׀‏ֽמֽע—ק׀גÊיףצÝךִֿנזֳך’ֵÞִגהÝֻמְזָגדג׳‎טנֹוזװ’פמזלוזßל“Ýם׳ם׀װפפסײָדזװךפאּÞֶפִכגֶֻּײז׀כדגְזוזזֻˆˆמהÝְלּזזָזדְזֲזהגזßְֵזטהׂ‘זו׀זג׀זלְזןוה‘זזמזז׀זלְזזֿה“זזֽצְׂזכזזךזזֿגפטֵָזדצזףזו׀ץגֽÊ“זזךצׂזזט—כְזד־“זוךצׂזזנ—כְזב־“זזךצׂזזֱ—כָזמזזנזזמץגֽÊ‘זהגזבְזהגץמ’זכְזהÞ“זוָׁׂזזךכָזהְזזזדװױׂזזלגכָזןְזקזדװױׂזזֲגכְזזוה“זזףצׂזזֲגכְזגֳה‘זוְזדזזכגץמ’ׂזזלגכְזןה‘זהזזדזזכגץמ’ְׂזֿזז׀זהßגפטףזßםפךסמÝעֽיץךÝגףךדזפךםזפך–ךֽעץיהך־וÝע”בßגעך׀ע–ו׀כטי—ֶ—ÞÞ”עֱ“ךצןבˆ׳נˆיצִבם”‏טטצב׃ֿ–׳ֶנֽגוהׁזֿןףְלÞˆÊָ‏מזגדאְ—ÿי׀קײפפףװכזזזזךזןˆˆÞזָׂה׳זז‏זו׀זכזהסצבצהזץָככו—נבצג‏ןצזִלהֲּןצזÊדÞִּספְּה־ְ׳אפָםסו—ֱהסצֳכז—זבסעובצֻסהציאְְ‎גזגמזְךךבץּאאÞגֳו־ָ־מפצװו־ָּפ־גײדץְוגָּאגְ—ױגךףגלצץגּֽץגּֽץגּֽפטץמ’טףּ’טצזˆקÝױלßדגלÞװצßודגßהװצßומ’גץמ’גץמ’גץמ’גץמ’גץמ’גץמ’ךףזֻוÞך–יÝ‏–יה‏ֽמְִֹקְגÝךֿ‏סבזוךÝמ”ז׀גֽהצגֽיףמ–גףצֽמְִ–יßִץבדךה‘־ÿ‏ֻגײןֳָֽאץיאקÝיםסב‎’מßהוˆֽ“ßזִÿ׃כ–ו׀עְֳֹ“’ססעÿֶ–ְ׀ןÞ’אדֽ“’טֽםוע–עֵזּֽףְלÞˆÊָ‏מזגדאְ—ÿי׀קײפצזזזצזדˆˆÞזװ“ה׳זזלזז“זיזז”זקׂ“זדְױׂזז“כָזזְזדזדװױׂזזהגכְזהיה‘זזװזז׀זהגץמ’ׂזזדגכְזד׃ה“זז“ׁׂזז“גכְזןֳה“זו—ׁׂזזק”גגֵזז‏זד׀זנזזזםְזקזד‏זד׀ואזזזסְזקזא‏זד׀ו•זזזְֿזקזם‏זד׀הÊזזז׃ְזקזך‏זד׀זיÿעגבזיעזד׀דֻזזזזֻ•“זו—צׂזזץ—כְזגפ“זו—צׂזזÝ—כְזךÞ“זזךצׂזז–—כָזיְזÝזזמץגֽÊ‘זדִזך׀זהגץמ’זכְזדה‘זה—זםְזלְזכץה‘זזָזזזזלְזהֿה‘זוװזג׀זלְזאßה“זזזצׂזזג—כְזכץה“זזׁצׂזזלגכְזיֳז׀ךפעֽבפך–מÝעףךßגÝז׀גֽהצגעו׀‏ֽמֽע—יֽךÞבֽךÞיףצÊמ׀ִֹיֽע—מÞמןוְִֹיֽךÞבß‏סבזִנזףעןזװ“”ץױףככÝֳץˆֽ“ßזִÿ–ג׀Þפּ׀עד׀“‘ד—ּÝלִֿו‏דֳּבצ“נאפ–ÿטץ“‎קב‏וכֳֶָנָֻßזצױˆְמץˆע“הװׁֻצ־ִֶך׀סם—מ׳כְךֳןףצÞגזװֲגֻֳאו׀ױלץװױה׀זזגזפˆˆˆזֳ׀וּצזכזזךזךףזווßִןם׀ִֹיÞִ”בÝִו”םלץי’אפי׳לפי׳לףזסׂףּףֶץּÝֲפּÝֶפְּזזז׀זֲˆˆ‏הבְמגזזװזד׀זֵזה–זןז—‎דְךסֿך‎הסעךד׀–נז׀ּיג׀ֿלבֿזםבָּאזז—ױßהװזקÞװױלßגפטץמ’ךףזובז‏ֽמ־‏–יד‏Ýךֿ‏ףמףעֿוßצאמÞמÊיףצ•ךÝמנזסמ־בְִֿמוִÿמִףהזן“ßהמנבÞזְבßִֿזִװנמוÿבÞמ־ˆׁ׳הֿ‏ְןßִÿמ־מזזזגזטזו׀זִָהז׀זכזז‘”צזךםדּזאזז“ױזהװßךזגעו־ך־םֽע—יֽךÞבְןלֳסץעֳÿסעסןעוטֻץ•ֳֻץעֳÿעזזזמזטזזוזֹּהלזזךזוּזֲעובוצ‏קהזִדה׀׀פוְ—טזוךפוֿצסוß‏ÿגֿעןסֿמÿדצאזז’נז׀ִםנז“אדצךמוצצףדזזלאצ—טפֿ‏ףדץִןפְ“ידעָגו׀–להְזילÞװױגךצױגץמ’גץמ’גץמ’זדױלßדגגךצױגךצץגּֽץגּֽץגּֽץגּֽץגּֽ’גץמ’גץמ’ךףזֻבז‏ױזץגÝגץִÞיץגÝזÞך–יה‏ױזץגֽגףךÞבצם’פ–•נ׳ינֶיֶםÞסנֱײּ׳––םז‏ק—צבטזפק“‏ׁםˆ‘ץזִטעזזזהזבעזֵצן”זֱזה׀זÿזוֻזגבצקהצ–עזßעיפז‏פדעְךזז—ױל׀זױלÝג׀זץצאמÞמÊיףצ•ךÝמנוÝצÊמÞמאבץצנךÝמ•זֱֳ“סֻסˆֲס‎נֱףוְצּםֲ‏עםדÿזג•סֹיßסבס“ֳב‎ונ––הצסֳ‏זזזוזגצזֵ׀ןךזֱִזז׀זףצזָהצזזדדְיזזצזטלÝּזלÝּßךהעֿגפגוÝק’“ז‏ֿׁז‏ְזזְזץזאוײצמלזזךזו׀זßצו׀דזְעאו׀צזסצ‏הדסעזוז—דזזעגוּּוו׀–םוזזילÞװ’גףּפטצזױלßגפטץג’גּֽßךהעֿגפגדגפגץזֶֹֶזא‏טֱֵֵ׀אֵˆ׳“ולֱÿזזזוזזךזֵזאֽזְ׀זז׀זדזדג׀זצִֹי׀אֽ—ידצזףÝצ—יזזזזמזוזוָזֵ‏האצזדזזִזז׀זßךזגןםÝִÿם׀ִÿזֵֵ‎•ֳײֵÊ’•ִזעכֶ•ֳֽÿÊ’Þִזזזהזהװזץ׀ממז־זזו׀זכזד’זםזעגהְְכז׀ּלוְיעהְציסזךכדצְםזְָכז—ְאהצ׳מז׀װיצזמאד־װױלßגפטץגפטצזױלßדיגףּץגּֽץגּֽßךהעֿיפךץמץעÝזßגֿגצממˆÊץוז‏ֿסֶׁ‘ֱץ–גו־ד”Þצבֿˆ׳זזצוןזזצדזצלנזזּזז׀זßךזגןבÞִןיÞִֿיßִדזֳֻס•ֳֻס•צגאס–ִוֹם‘ֶָן‘ֹׁױ‘זזזוזזדװזהˆ’װזבזז”צהמצסְ‏ץדצךגזצּמדץצזוגְקגְ–מדצװםפז—מדעְזוז׳מזצזילÞװױלÞװץגּֽץגּֽץגּֽזלÝּßךוךֽידִ–יהך־ןצגנבפך–ידִ–ךßענבֵ—ײזףזזפ׳םלּױװזצקאביךאֿגןפעּףץּ‏ףפצזזז׀זזזײצז—ְי־זזװזב׀זֽזדםזן–‏ֿא׀׳נבצלסְךםדפגזבצזֿוֿעזפוְאהְֿםהעְפזז—ױßודגלßדגגךצזקÝױלÞװßךוךעו־ך־םֽע—יֽךÞבִֿעו־ך־םֽע—יֽךÞבְִעו־ך־םֽע—יֽךÞב׳ך‏גֿמ‎אֿגפאד‏גֿג‎אומפאן“‏גֿמ‏אומפאזך”גְֿ‏גֿגֶאÿ׀ץאוְץגְֿ‏גֿג‏בßמפאוְזזצזזז׳ךזֽ׀טסזז—זהצינז‏זדצזױטףג׀ג׀ִÿוßִןבÞךֹיÞִ”םÝֲק‏סֻ‏נב׃ֵךססÿנבßִ‏צטסלÞּױלפ—׃כÞװײלפװײזזזהזזזה׳זועז”‏זה׀זÿזו’זג–‏סד׀׳נז׀ּיבצולגְ׀םגָּאזז—ױßהװזקÞװױךףזףבז‏ֽמ־‏–יד‏Ýךֿ‏סבז‏ֽמ־‏–יד‏Ýךֿ‎עאומפאוּץגְֿ‏גֿמ‏אומפאזיךגְֿ‏גֿג‎אםגץאוִפגְֿ‏זזךזזזלּזלְדְֳזכזוִזא׀זßצו“ֶזßװםאצנבצלסְךםדץעזא—ְ‎אז–לגְ׀םגָּאזז—ױßהװױטצזˆלÞװצßודגגףּßךוךעו־ך־םֽע—יֽךÞבֿעעו־ך־םֽע—יֽךÞבְִֽיףטָאומץאץּץגץּ‏גֿג‎אומץאÿ“ײלְיךגְֿ‎גץג‎א‎זץאוְץגְֿ‎ט׃מזזֱˆˆׂצז׳ק־זזװזאגזטסזזכדעְבוזָבו—ְהו׀—ױגךצױזהװßךוך־יףצ”ך׀‏סבוִנך‘פÊז־װהמÞז“ˆׂפײהז׀םאףֳִןזזוזזגהÊצהםז—ִזז׀זדזדג׀ג׀ִֹי“ֻדץעעהבֳÿס׀זוזזזה׳זג־זÝִזן׀ז”צוֲגß—מדְיעהוךיוץֿעזßְידץ—טןֿװטה—ְצה׀–מא׀זילÞװצßודגגףּ’זהװצßהװצßודגגּֽßךזגעו־ך־םÞ“ומÞמאבץצÿוÞ‏–יד‏ÝךֲִֿזףךÞיֽע—םÝִנזפמױןÞךֶג־ְ‏גְֲֿהÝמײןÞךֶגÞְÿגְֲֿהÝךהץײןֿװ‘אומֳהßÿךוױןֿ׀‘אומִדו‏זזןˆֻזל‎זזזדֳזזםזזׂ—זְּבזז—ױßזזßךוגעוÞך•יףצֹיß‏ּי־װןעהףגױךפ׀Þכß—’זזזוזלˆ”׀בךˆ‘מזוצזכ׃זי‏זזציזהװ’ךףזומÞִ”ך׀ִוףד׃־‏ףßֿˆ׃ּÿ–זזזמזזקּזלֵˆְָזםזוךזכגזֵגץממסז—טדסעההז–מגֿגלגְָטועְצהְ–םוצזילÞװצßודגל׀זױלßדגטףג׀בßצֽמ־‏–יד‏Ýךִֿעו־ך–ךֽעֹךß‎םםצסבצֻÿסֻיֱזךײז“—ּבצקבßכפÞßÝן׀װזזזגזזזל‎זא׀דֳזזםזז•–וצםמו׀מילßדגזדג׀ג׀‏סבוִֽםֽע—י•׀לÝִ־ףציÿכףךױךÞ׀׀ץּֽזזזגזױ׀ל‎זץװדֳזזםזז•–וצםמו׀מילßדגזדג׀זצ‏סבוִֽםֽע—י׀גֵק־װ”מּ—דסÞ—ÝלÝךװךג‏’זזמזזזל‎זטװדֳזזםזוךזן—זצדְָקדגְץדז—לו׀עהפזִהדפװצßודגלßדגגּֽזךףזףוֿעעבÞךÊיףצ”ו׀‏סבוִֽםֽע—יװלÝִֽףÊזלÝִ־ףציÿכףךױךÞ“ׂץֳּֽכףךױךÞ׀׀ץּֽזוזזזז׳ּהכזטֳזזזן׀זױזדִזנעז”וץמ–בבצׁאְּׁמ–צ–בזֱָהבצֽדצ—מיסצ׳ז׀ָ–זהּזוß—מםֿזלןß—פפה׀ֳדעְÿךְ–מה־‏יפהזזדפװױלÞׁגגּֽץטץמ’גּֽזקÝױגךצױגךצױגךצױגץמ’טףג׀זץצאמÞמֹוÞִ”םֽע—יֽךÞבְעןם׀‏ֽמ־‏–יד‏Ýךֿ‏סבזִֻיה‏ֽמְ‏סבו‏Ýךֽ‏ֻיה‏ֽמְ‏סבו‏Ýךֽ‏הכדװׂמß׃גאגעעקפ׀װקֱÿאגצֵמÞ“קפ׀װקץצופ־ְֳןפְָןץ—ָˆײ‏ָןץ—ָלו—ֳלזךÝכֽ׀סץץֳבאÞךװקֽ‘ׁב—עסקה“װקֽ“װמßװןפִֹןץ—ָלו—ֳםÞֳִןפְָזזזהזזזהÊצגדז’—זד׀זֵזה‎זב׀ע‎ז–צףדצ—מסוּדהּֿזהגְלבְ–מגזזילÞװ’זדױßהװץגּֽßךזגעו־ך־ם׀ִֹיÞ‏–יד‏Ýךֿ‏ןיה‏ֽמְ‏סבו‏Ýךֽ‏וזÝ—װםßֳבב—עסק־׀ױק־‏ָאß“ֹםß“ֳםְךÝכד“סץץֳבאה‏װקֽױאÞּÊןֿ“ֹלזזוזזזהÊצהףז•מזג׀זװצוװאסזצידץזפג׀מזומלדצ׳מהזָםפזְןדעְקזז—ױלÞװצßהװפטץג’זהװ’ךףזףבזִאמÞמֹבפך–ךßעעךÝמזפ‏–ך’ךףבפמעהÞָײבפװולְךÝםוֲָועקם‏צ‏בצבזזגזזקֶזמןˆְָזבזובזהסצזז׀—בפזךזדפװ’זהװßךוךֽיףך–ך“אוסÞױ•־ײֲזזזוזזד”׀הֳˆ‘מזוצזכ׃זי‏זזציזהװ’ךףזףמÞִ”ך׀ֲֳט•םֿקאן”•ץֱÿ׀זוזזד’זהֹˆ‘גזהזזנצז–עזְךיפז‏ןהצ‎מוצזילצױזהװßךוִעמÝעÞיפִÝבײְֲֲֹךװום־גל”מְךצזזזְזזˆױ“ז‘ˆ‎זזּזג׀זֵצז“דו׀עלגְּקהְ—מפזעזדפׁגלצץגּֽ’זדג׀בßצןםÝ‏–יהִÝבְִעוÞִ•יףצֹךßֵױףץלÝִ־ֱּ“ֱק־װ”מיבטֿ—׃ךÞָ—כפגטß—׃ךÞָ—כְזזזצזזˆװזזֽק־זזּזיּזְסזְןהצֿעהצ‏יזבצדזְָדובצווז—גו׀ּמוצךזהגװדהז—ױגךצצßוג’טףּזלßדגלצױßהװßךוךקזףע”םÝובצֲךמ•ֻיףפי׳ףׁ׀ןֿמײדÿװֲג־ּטזזזוזזזהÊצוװז”צזהצזכ׃זםמוצזילצזךףזףבזִֽיֽע—םÝִנֵהצ•לÝ—ֳף׀כ–ךפװßכדמׁןףּזזְזזז׳ּוז׀טֳזזזא׀זײצוּהאצץעג׀ָיסוּגהְ‎זזיזְּצדצ–מוß‏ילÞׁגגּֽזקצױלßגפטףג׀זצִֹו־ך־םֽע—יֽךÞבֿעעוÞִ—ם־ך־וֿעעבֽךÞיְגדאגצֵמÞ“קפ׀װקץצצלו—ֳלהְֳןפְהװוֳבבף׀ׂכד“כהךֵקֿ—ֹםß—ֳלהְזזזגזזק‘”זכ”ˆְָזסזהֳזאֻ‏גד׀—סגעְזבז׳מהזָםפזְידעְבזְ–מגצזילÞװױלÞװפטצזױךףזÿבזִסמÝעׂזף—וךßצאבץצÝךֽע—םֽעÝׁעָײמהּײזֽגז־ײֹפֿיבץצּÝמעּבן׀׳קפְּ־הזזזזצזזז׳ּזֹציֳזזעזהצדנזזגדצזױטףג׀גÞךֹיÝךןֹף׃־‏ףßֿז׳ֻ־‏Êמזזצזזז׳ּזְצי־זזעזגעזםסזזדדצסמז׀זילÝּזלÝג׀גÞך–ךÝעÝְ‏בÿלְל‎ל׳זזזגזױˆּזסÿˆְָזכזוֿזדֻצזה׀–מוצצלוצֳמזְִילßדגל׀זױךףזומֽע—יÝךאבץצÿבֽךוסֶ‏הל׀מֽמדֽ’לָמדזּ‎יß—ִזזזוˆ׃“ה׳זזזזÝִזן׀ז”צוֲגß—מדְיעהוךיוץֿעזßְידץ—טןֿװטה—ְצה׀–מא׀זילÞװצßודגגףּ’זהװצßהװצßודגגּֽßךוגעו־ך־םÞ“ומÞמאבץצÿוÞ‏–יד‏ÝךֲִֿזףךÞיֽע—םÝִנלßֽאֿמָאומ‏ןְװÞלֿֽאֿךָבßמ‏ןְװÝזׂ—ֱלֿ“ֵטְֿפןצװֱבÝזֱלß“ִטְֿפןז׀ֱאזזהזזזה׳זדßז’עזה׀זÿזוֻזגבצקהצ–עזßעיפז‏פדעְךזז—ױל׀זױלÝג׀גßצאמÞמÊיףצ•ךÝמנוÝצÊמÞמאבץצנךÝמ•ע‏Ýךּ‎בךÝיאמףךֻםףמÝםהעÝזß׀Ýץע‏Þך—‎אךÞע”יÞעּיÝ‏זזְזזˆױךזסק־זזװזב׀זֵצובנדßעיסְךםדעָפדזּפפְ‏זדפׁגל׀זױלÝג׀בßצאמÞמÊיףצ•ךÝמנבץצאמÞמÊיףצ•ךÝמנסוְפגְֿ‏גֿמ‏אומפאוּץגֿ־ןגְֿ‏גֿג‏ב‘“פאוְפגץּ‏זזעזזקןזנֽˆְָזכזוִזמ׀זׁזדװזפגזׁסֽך’הףךֵס־—ֹה־—ססֿװֿדס‏סד׀ָסהס‏דהצ—ךןֽוזי־צטפֿ“‏הץ“אצומ׀דָּאזז—ױלßדגלÞװץגּֽזלßדגלÞװצßהװצßהװßךזעעו־ך־םֽע—יֽךÞבְִעו־ך־םֽע—יֽךÞבִֿעו־ך־םֽע—יֽךÞב־עעו־ך־םֽע—יֽךÞבִֿעו־ך־םֽע—יֽךÞבְבָאומפאץּפגץÊהאומץאץְפגֿ־ואומפאוּץגֽֿץְפגְֿ‏גֿמ‏פץְפגֶּֿגץמ‏ֿßמ‏אומפבßְץגְֿ‎גץג‏אםּפאוְפגץּ‏ֳֿמ‏אומץאוֲאגְֿ‏גֿגֶאצזזז׀זזˆװִונˆ־זזװזב׀זֵזדבזןßּדאֻעֵאזֵָהס‏קבצ–נז׀ּיא—׀‎אז–לגְ׀םגָּאזז—ױßהװױטצזױלßדגלÝּץטףג׀וץצאמÞמÊיףצ•ךÝמנוßצאמÞמÊיףצ•ךÝמנםÞך–ך׀בֵאומפאץּפגץּואומפאוּץגֿ־ֳֵׁ•ןגְֿ‏גֿמÿאםּפאוְפגץּ‏‏ףעזזזךזזקןזסׁˆְָזכזוִזלְוןצה—ְבצ׳ספָָהֻעײאזָײהס‏קבצ–נז׀ּיאו—ײגֻֿמםָֿםםְֹּאצ–לגְ׀םגָּאזז—ױßהװױßהװץגּֽ’טצזױלßדגלÞװ’גץמ’ךףזבבז‏ֽמ־‏–יד‏Ýךֿ‏ןבז‏ֽמ־‏–יד‏Ýךֿ‏ֹמ׀ִעבֿעעו־ך־םֽע—יֽעֹמÝעÝזסװ‏גֿמ‎אץמץאצג‏גֿמ‏אץגפאם–יזßװ‏גֿג‏א׀ייׁ‏ִפאוְפגִֿ‏Êץמ‏אומץאץֿֿכצװֹהֿמ‏אומךםצװ׃יצזזזצזזˆ—זסק־זזװזדױֳנז׀ּיפְ‏זדפװזלÝג׀בßצאמÞמÊיףצ•ךÝמנסוְפגְֿ‏גֿמ‏ֿßמ‏אומץאוִזזזמזזקקזיÝˆְָזכזוִזןעזפסֿעקהֿעםסְךםדעָפדז–לוְזילÞװזלßדגלÝג׀בßצאמÞמÊיףצ•ךÝמנוßצאמÞמÊיףצ•ךÝמנ”וְפגץּ‏גֿמ‏־וְפגְֿ‏גֿמ‏ֿßמ‏אץגץאוְץגְֿ‏גֿג‏ב׀זזז׀זזˆ׃װז’ׁ־זזװזב׀זֽזהםזבֻ‏ֵמצ–נבצלבצֻנז׀ּיצו“ךדּזאאז“ױל׀זױגךצױלÝג׀בßצאמÞמÊיףצ•ךÝמנוßצאמÞמÊיףצ•ךÝמנבßצאמÞמÊיףצ•ךÝמנ’ְֿפגץּ‏גֿמ‏ְּֿפגְֿ‏גֿמ‏פץְפגֶּֿגץמ‏ֿßמ‏אץגץאוְץגְֿ‏גֿג‏ב“‏פאוְפגץָ‎זזזוזזדˆ‎זהˆ’ּזז׀זףצזָהסצזדדציךזצזילÝּזלÝּßךוִֽיףטֵׁ•ִיצזוזזד—צהˆ’ּזגְזֳצומץסץמצהֻעזגְ–מדְמםדְּקזצ—ױßהװזלÞװ’ךףזÿמ׀ִעבֿעעו־ך־םֽע—יֽעֹמÝעÝׁע—דאßְפגץְֵז—•ֹה—כם׀ָפאוְפדהעככףעזזֱװזִָזזזכֵזזװזגּזלסְּדהְּץפְ‏זדפװזקÞװßךוגעו־ך־םֽע—יֽךÞבְֿפגְֿ‎גץמ‏זױגפאוְפגץּ‏זזזדזזדצגִˆ‘מזה׀זÿזהךזדְזצ־װזׂזזֵכְזהפ׀ךץִעו־ך־םֽע—יֽךÞבִֿעו־ך־םֽע—יֽךÞבִֿעו־ך־םֽע—יֽךÞבֻצ‏גֿמ‏אומפאא‏ֶגֿג‏בßמפאÊמֶגץמ‏אומפא‏ִפאוְפגץְÿקץמ‏אומפאוְגץּ‏גֿמ‎אצזוזזזזצופזעךזה׀זט׃–‏דהצ–לוְזיל׀זױךףזףבז‏ֽמ־‏–יד‏Ýךֿ‎פאוגץאוְץגץְואֿג‏אוגץאוְזזצזזˆ׃ָזלׁ־זזךזג—זלזְֻזז׀—דפזגזדפװ’זהװ’ךףזףמÝעÝל־ָײˆ׃ױמזזזוזדךוֻזבזּגזז׀זכ׃זי‏זצזיזהװ’ךףזווÞג”זÿ׃דˆׁװˆזּא׃ױצזזזצזזזײצווזכֶזזךזג—זלזֻעזז׀—דצזגזד־װ’זהװ’ךףזומףעֿזצףˆזגגזײצ•זזגז‎ק‎זםזהּצזדזז‘•זֿזדפזגזדפװ’זדßךוִֽגףטצכהßֹזְׁזזצהׁזִָוז׀כֵזזװזגּזלסְּדהְּץפְ‏זדפװזקÞװßךזגעו־ך־םֽע—יֽךÞבְגדאומפאוּץגְֿהװץמ‏אומץאץְזזזןˆױזלןזזזה•׀זכזוםזהֻ‏םז׀ָםגעָאזז—ױזדױךףזץבז‏ֽמ־‏–יד‏Ýךֿ‏‏גֿמ‏אץגפאזלßגְֿ‏גֿג‎אזזזזְזטˆ—ז“ְםקזזךזו׀זדזדג׀ג׀ִֹיßךןםÝֱ־ֵאֿװ‎Ê׳ְֶָןֶֻנֻײˆְֳ׳‎Êּזזזגזזזלןזבצה•׀זכזוםזהֻ‏םז׀ָםגעָאזז—ױזדױךףזףבז‏ֽמ־‏–יד‏Ýךֿ‎עאומפאוּץגְֿהװץמ‏אומץאץְזזצזטˆˆָהךְם“זד—ז‎עז“סוזפהצצצהזךגטז“׳מֿ‏ִןָֿפמÞמֿםÝָ׳כדְ׃טÝָ׳פֽך“הֽךזט־–ללפ—ימ־גֿןזּפפץָםדעּגזז—ױלצצßךצצÝפװצßודגלßגפטץגפטץגפטץגפטץגפטץג’גץמ’גץמ’זדˆגלÝג׀םץצקזףִ—םÞעאבץצֱזץ‏סבזִֽיÝמ”יֽע—םÞ‏–ידִÊיףצˆזץִןבוויÞ‏–ידִÿוßצÿבִֿנבץצןוְִֹיהִןבß‏הךֽע‏ז—ױÝֿצֻףהצ‎ßְגףהְּהגףע”בהִץזףֱֵןÝ–צדְמְבß‏ְבצמײדÞֱִֵףהאצ—גמגפ׀’ו—ףןהסךםהעםףץָעגוצןדאִקץּװֻק־‏ׂףְעגךÞײׂק־ָָט–זבדומֱבוךִלהך־ודְלןוְסהעזזצזטזזזהבצם–זוִזךגזֱנזגÿהסְץהזָץגְֻןגְ–‏זצךםזצְבדְץמה׀יפזצÿדפװױגףּ’זדױלßדגלÞװßךהעןמףִֿיףצׁזפ“ויףצ”ב׀ִען׀גנבß‏סגצמסיˆ“׀קזב־‎ֶ‏–מפְכזףהײטß—ֱױֶ•׃ף‎ךןה׀צֻיÝּזץמֶז׀װגמהעˆˆׁװזזזגזדְזזזעמהֶצזֿזה׃זאְךאנזצאהצצמזצֿםגוךיב׀ֻמהß“םה׀ךזהצךטלßדגלßדגל׀זˆקÞװצßדג׀םצִֽם׀ִֽיÝךÞק׀מ—כ׀גÊיףצ”ךßעען׀גנבץצקזצ‏סבוִנזעמףאץװ’׃דֲֿד׀ךוזÞמ’ץדִימףג”ז׀ןדְÊ׳ײאֿױץמֳֽßְיבָֿ•םֻמבצנאףךקהפנבÞָץצזזזצזטˆˆְו–ְםֹזו‏זכּזִגְֻסדז׳‏זֿעיגצװפזְ‎םדֿמיהציםה׀‏םפזװדדפװױגךצױגךצץגּֽזלÞׁגךףזובזִֽבß‏סבזוםßגֿמֽע—יÝךןבדךֿבְןנןß׀־וְֱּאˆֳףÞגעז־װוצ־ְוֻּֽÞװאבß‎כהזאע‎ףִ”בץגסזזזהזזˆְמכזÊּזאזזֿזד‎זמ–ְÿדז׳‏זִֿיפץֱּהֲּּאצֲּגזמאא—ּצג׀—םז—ּכוְֻמה׀ךילÞװצßהׁגגךצצßהװױזהװױךףזובזִֽבß‏סבזוםßגֿמ־ִÊיףצ”בßצנךÞגנזץצןםÝ‏ˆזֽךההßֳםזצןמֱֿױףמפגפִידץ‏וֲÞױפÝ‏פוְמןםוצוףמֹßװֶאְםוְאעבֿךÝי—מהב׀ֲˆֽ“•ךצ׀טךִג׀זזגזדׁˆזטמה‎׀זÿזהיזבץךפצזּפדֿמלפצףדצֿםהְ‏םפזָדדפװױßהװץטצזױגךצßךוךעוֿעעבֿעעוÞִץיהוםֽע—יßִןבוובׂמפדפצףבסזÝך׀“וםגגׁזֳעסעßעײײהװ”לצִוצה“ממוצ–טג“הזßִקןוצזזזגזדׁˆזטךהִצזֻזד‎זמהגְנוְּדץגףבהזÿפהגֳה־גÿאצֿםבז׀םבגְÿהז–מז׀זילÞׁגלßדגגךצױגּֽץטףּזלßדגךףזףבזִֹיהווֿעעבß‏סבזִאוÞִ•יץצֹםֽע—יÞ‏ֹםֽע—יßִןבוובׂךֵדץמֿדוִגה׀עֵבְעדהפצ”גץ—ֻדְגׂע־ךו‘Þ’ְווצאהÞָסם‏עÿג־עֵדפ׀ללוװאכ‏ּפמנגטדץצׁךֻעדוֿעפמז“זזצזטˆˆָהאְםÝזהמזץּזױןץß‏בß׀םב–ְלמז—ִבß—כדעֳּאצֳָבßֳםדץךלגגּעדצ—מזּּםוצּםפזָהדפׁגלßדגלצױßודגלßדגגץמ’זהׁגלßדגךףזובזִÿבֿעעד׀גֹזÞגאןצגעוÞִ•ק׀ג•ק׀גÊיףצ”ב׀ִעךÞגÞבְמֶטפְאדץְ‎הק‘ֽגףּעה׀גדזֿצְצפ“קוגגוףß—־זֱםמגׂך־בָֹֿקְ׀ו־ְÞעסודץָ•ֻגֽיßֳטכע—גד־זÝזזזוזז—זזזמֶזÊ“זךְוֿצדֳּןÞעדכֿּנדזײהֽזענזךּהץצפנופדצךמוßצקמזװפפפ“׀הפ“ׁכßּּןצװפפץ—‎דץמעפצעדעְֹזז—ױלßדגלßדגגךצצßודגלßגפטץגפטצזˆלßדגלßדגלßגפטץמ’גּֽßךזגעד׀גֿםÞ‏–ידִ•יÞ‏ֹםֽע—יßִאוßצֱזץ‏סבזהיהִאן׀גנךÞגÞיףצÊמÞמןוְִֹגß“וזָֿץםק’נגזגיהו׀ßהßמßגזגהמ—זֱוץצםֿ—הוצמÞזעזßעּֽ’ןÞמצבגֳ‘ְזגְֹףסß—צצל־מסכßְךבה—׳‏זךןהוָקא׀—ײגץםׁזֿװךטץֿצםֽג‘‎ßצניצ‏וכוהֲזזזוזז—ז•ְדÝזֹעזבְזÿצז׀אהוזפפְ—פדעּמזז—ױלßדגגףּזךףזףבזהמ־ִ•יףצׁזפ‏–ידִÿוֿעען׀גנßָױהץװאל־םסלּגףו־סטםצןןךּ‎—זץִׂםהִטםומÝך•גגהצּ‏ג־‏פזזגזדׁײזֲ׀הְֵזֵזה’זןבְ‏דז׳‏זְֿיוזעהג׀׀סזְסםגועיפצװבהעְכז׀—ױלÞװצßודגטץגפטצזױלÝג׀זץצןמßךסבזִאוÞִץמפמֹםֽע—יßִאוßצÝמףמÿבְןװמÞְ׀הßזצןׁטןß‏ףל׀“וזףגוקßִץד׀ן–יפÝ’־מֿאוֵָוְלּמו׀ְקעגדוזעֿןוְזזזגזדְזזזֲ—הֳצזֵזה׃זא–ְ‏גזָ‏אסְקאצ–‏וְְםוְְסגו‎םגֿ‏יפזװזדפװױגךצ’זדױלßדגלÝג׀םץצןוְִאמÞג”מףמ–יהִÊכ׀גÊיףצ”ך׀ִען׀גֲזצן׃ה׀ִֶבוֱÝ׀וףֽע‏ןÝױץסדצקזֿסגְֱיפֳִט־•׃טעג׀ט׀ךלוב׀׃פץצנזְָגְָזזזצזיˆˆָו׀צטןזדגזטגזְנוצׂדצּמו׀מבבß—ֵאהגֽם׀—ױןעְ‏ל׀–לדצעיזְּפזז—ױßהװױßוגפטףּ’גּֽץטץגפטצזˆלÝג׀זץצקזצ‏סבוִאמÞמֹםֽע—ק׀ג•יףצױזפמזףצ•יףצÊיףצ”ב׀‏סבו“ובץצןוֿעעט׀גÞבß‏ו׀ףםׁב׀נךץגקהßׂ׀ל•ֵטץֿעײכֿךגמ׀צֲדדקÞק׀ָךזסֿהך”מ‏גְ—עכזצֽד־װעְÞז’פֻלֹדÝִקה־מ‎ךדזההצּקםֿצכבדְÿךְֲֻּצזהזז“זזזן‘זָֹזגְזִזבבזכֿ‏ÿגֿß‏זוךםגְֻÿדצ—זהזגהו׀ָבהßמזבוךÿאזעÿאעּכו׀ָכוצע‎פזמ‎דעְףזז—ױלßדגגךצױגךצפטץגפטץג’גץמ’גץמ’זדױßהװ’גץמ’ךףז׳זץג—ק׀גÊיףצ”ב׀ִעט׀גÞבß‏סוÝע—מÞגאן׀גנך׀ן‘ˆֽגצדÝ׀׃ד׀םכÝעָמßֻ‘ˆׁ׀עז׀ּהמזגÊטו—ֵדבְ•פְמילּֽßעִ•װץְֱׁ־מזזצזקˆˆְהלְםזדךזטגזְכְ׀ֹךו‏דנז׀׀דסְדוצּדהזצֻכה“מםÞץמןפִיזְּמזז—ױßהׁגגץמ’טףּ’זדױלßדגגךצצßדג׀זץצקזפג”מףמ–יהִÊמÞמןוְווְִאוÞִ•ק׀ג•יÝ‏–יהוםֽע—יßִאבץצֱזץ‏סבזִ•יß‏ÿבְמײגÝןֽֽצוןֽהקֻ‎”כֽגדז׀מגה־ךץדזמבזßְֵגÞזפףְ“גןהװ‎לֻ‏Ýֲּ‎זזצֻןיָÞ׃ןֻצ“יפז־ÿ•והגףגקד׀ִ׃ִ—ָׁיצ“לבפךעכד׳נזצְכדֿ‏־בו“—טהֶ׃ג•בֶזזגזדׁײזיװהֳזזֿזג׳זלֿ—ִצזִּדְ‏ןוצָךדץװקגוֳּדץ׃לןוּלאßזִפצ—ןהצ—צפצעצהְעדזוצדד־װצßהװצßהׁגגךצױגץמ’גץמ’גץמ’טץגפטצזױגךצßךוךעוֿעעבßךסבזִֹיֽ—וזÞִ–ידִ•יףצׁזפ‏–ידִÿוßצֱזץֵֵע׀גֳכוװבדצגצןßִםעָיזץּˆן׀ןֻךןמגßדֿוםגלצעָמומוֽזךדלֿ“דֿ‏לאֿזטגָבדßגטמֿגזזזגזדְזזזףגהֲזזֽזהבזג–ְדוצּדהזּֿדוְקפץע‎דעְקמצ—ױלßג’טץמ’זדױךףזֻבזומףִÝךֽ‏–יה‏–יד‏–יהוכְג–ידִÿוßצֱזץ‏סבז‏סבו‏וךצמֵˆָׁ׳ְָֿףה׀ִִנֿז‎יצ—הןּג׳גדֶץה׀ֻױץמֶדדמךהÞ—ךאזֱָו־‏פקב‏וגוזךאßגװבסִנכָ“זזְזטזזזהדזםױזו׀זלְזצה‏םהֿְלסְאלזֻ‏מו‏יוְְטלוךÊפץצצהֿץמםְָלם־ֿמוÞְיפו—זדפװױגךצױßהװפטץג’זדױלÝּץטףּ’ךףזובזודְגֽמפִÊבףצ”יִֽÊיףצ”ב׀ִעט׀גÞבß‏ÿבְִ—ל׀ג־ו׀‏ןוֿעעבÞגÞזְ׀־יְָ׳דˆבגזגךוßֻגכ׀“דצִ‎בךהְפד־םױֿ‏םגזּמדְבפטצגםֲ־׳דדוֵגז‏׳מץךßד–זטצמצאדּׂפֽׂבßזעםםץ—ֶטגעזזצזטˆךוׁצםׂזדִזעּזßןÞז־גהצÝבßִסנוזסדסְאםז—טמהמֲםוÞלּּׁך׀—ּן—זְן׀“סב—ְפב׀–מגהמיפהָדדפװױלßדגלßדגלßג’גץמ’גץמ’זהװױגךצצßוגפטףּ’ךףזובז‏קזצ‏קזצ‏ןםÝִ•ק׀גÊיפ‏–ידִÿוְִען׀גנבß‏סוÞך—מß‏ÿיִֽ•יÝ‏–יהוםֽע—יÝךןבוובְאכ׀מץהָץיו“קוצצ’סֽיֵבßמוז־ָÝםצװאוז“גגװ”ד־עםא־גÊןÝ“טזß‎ובצןעבס“ֵׁÿצֱןְ׀‎הÊםלגץֻß־׀׳ףל–מהוצ‏‏ו׀ְאםßצÝףץ־מ‏׀אגפםֳגצ“‏ןוִֿץסְסדֿמ–גצזזזצזטˆׂ—וְם—זהז‏—ז“בßעֵוו“ֲגץװ‎נועץדצ׃‏הפּםהסְמלְ—ףזÞזִמְ—ֶםפִדמהזפצךׂהפצְמוֶּןּֿיפו“ידעּדזז—ױלßדגגךצצßודגלßג’גץמ’טץגפטףּץגּֽזלצױßהׁגßודגגךצץגּֽßךזעעוÞִץיהִÊכ׀גÊם׀‏סבוִנךß‏סבזִאמÞמֹוÞִ”םֽע—יÞ‏–ידווֿעען׀גנבß‏ÿג׀ןÞלפגםגה”ֶהßֱִמֿףאÞמְהףװָל׀ֻאף׀ׁכומגךװהןץִאבךגבועהודװֳךצמכזצך־כהמידצ׀Þכָֽוגפ“ףטדֶּׁף‏‏ט־םֵזצ׀ןאצךךוד—Þֻˆ“ֽזזגזדְזזזֱ‏הְֲז—זאזצוגßגוװֿהב‏ֲבְֻÿןֿעיג׀‏ךוזלךדב‏דÝגינז‏מהצ‏מאזװצמÞמֹןֿך׳מ־עׂןֿךצןפ׀ֲמ־עֳןֿ“ףפפעףדעְכזז—ױלßדגגךצצßודגגךצץגּֽץגּֽץגּֽפטץגפטצזˆלÞװצßהװצßהװױגּֽ’גץמ’ךףזֻבזִאו׀‏ֽמףִֿךֽע—םÞ‏ׁזפ‏אבץצֱזץ‏סבזִאםÞ‏ֽמְ‏ןםÝִÊיףצ”םֽע—יßִאבץצֱזץ‏ÿבְן•דצגָדוֹִÝָועÝּÿןְֱֽדוְֱ‏ß—םה׀ֹהזעהצעןד—–לßמגךױץמ־קעטה‏דנץײ׃צד—ׂטזךטזץציא׀צטוד‏‎דßךוהץּךה־געמג“”בֽßכיצמןהְֿגדְ‎ףנצזוזזזןֵזֹ׀זק׀ו׀צד—ןאÞצ“א׀עבצזך“דְצבהזװßגוװּגֽגׁבßעְמßװּלףמ–וצװ’ט׀זדפ־צְה־צֵאÞׁבגְßבצָßפץצכדצילוצזילצױßהװצßודבגךצױגץמ’טץגפטףּ’גץמ’גץמ’גץמ’גץמ’גץמ’גףּזלצצßודגגףּßךזגעד׀גֹיÝצֹוßךנבץצןוְִֹיֽע—ם׀ךÊיףצ”יֽע—כ׀גÊיףצ”ב׀ִען׀גנבץצקזצ“ובץצÿיÞִÊיףצˆזץִאבץצֱזץ‏ו•ßֿץדזצֳÝףעגהְ—ךמ׀עהל׀ךןםוזאְֻיוועÊמצ׀ו׀ןÞץזקיעעףהזּ‏דְןֿןß׳ÿזצ“ץלׂˆ׀וְצאוענבצ‏‎אְְפזÿֶָוß“פנְ‏טדה—עמגֿקזֿ‏סגו׀‏םִֶֿסז–דגץװְ’ו“ִגףגֽכְגךד׀׀צכץװזזזגזדְזזזֲ‏הִ׀זזאֳזקבְקגצּקהזצבד׀ּ‘יץזֻמץצ–כפצץםפװ–כ־—ֶךָּ‘יצָ‘הדֿםםפגלםץבמא־—יקצ׀קטגזץטז’מוצ׀םפצעזדפװױלßדגגךצױגךצױגךףגלÝּץגּֽץטץגפטץגפטץגפטץגפטץגפטצזˆלÝג׀זץצקזפִ”יהווßִנב׀ִאמÞג”ךÝמ–יהוכְגֹם־ִÊכ׀גÊיףצ”ב׀ִען׀גנבß‏ןוֿעען׀ג”םÞ‏–ידִÝוֿעען׀גנזֲ‏ץלְ—האßֻזֳפזהא׀ָּˆױְװײ׀“לקְ“לו׀גךוßָךÞּץזץ“ˆב׀ָםז׀ֶָץעזּםּגקווֻממ׀ןץךֿ’כוְָףגßם׀נץְÿ‎הל׃גזִםיצ׀נףֿצןוז‏יה–עÝטְךאבְִטוץְעאֻצעכֿךßְֵֶֿכעֿאדְצסד־װסזזזהזז“׀ןֿזֹגזןזז׳זבםזךפךלנז“‎דס‏לזְָלהס‏דהצ—אדו—סםו‏ֿג־‏ָמהֳּםגְְלזּּבְּּןצְּפץמנדעְךזז—ױלצױגךצױגץמ’גץמ’גּֽץגּֽץגּֽזלßדגלÞװפטףג׀זץצקזצ‏ןםÝִ•ק׀ג•יףצֽמפמÊיףצˆזצִעט׀גÞבß‏ובזִֹגףצ”ב׀‏סבוִףזֲבײֳס‏ףאפ“נטÊ’ֿסק•כףצ׳דזמÝע—ֿלק’”מפצָדוגומצבד–ץ־אף‏מֶדגלגֿוֽֽֿע׃טÝ—דדפך–צק–ױקֿ‏קזֳִנקְָָךוָיˆָּזזצזטˆˆְו–זםÝזועזמעזענזִץדצ—טפזךףהצ׀טפצָטדעּדזז—ױלßדגלßמ’זהװßךהעעוÞִץיה‏ױזפמ–ידִÝוßצזףמÿגß‏ו–ו“ֲןהקֶֿ־ּצוד”כנְ׀ְז”ֿÿלץזולִֽױ‎ֽֿובו’׀ˆ׃צִזזזוזזװזזזלךזָזזנצהֿצב׀נךץִּסע׀ק־‎דסעßגץצ׃סיג׀ֿנז׃בהסךÿצהגßיוֳ‏הÞָםם־בזקִֿטה׀ְ‎ב׀“ֲמה׃דכע׳סעצָ”ץעֿךסצ–בצגך—קּ׳זטְ—Þיגָ׃יז—ךםּץזמפזטבִֿÿדֿזÊפז“Êדפװצßודגגך—ױßודגלßדגלצצßודגלßדגלßגפטץמ’גץמ’זדױßךצױגךףגגךצצßהװצßודגגץמ’גץמ’גץמ’גץמ’גץמ’ךףזובזִאו׀‏ןוְוו־ךֿכ׀ג—יÞִÊיףצˆזץִאבץצֱזץ‏סבזויהווֿעעבß‏ÝיÞ‏–ידִ•יßִאבץצÿבִֿנבץצקזפך•יףצׁזצִÝךֽויִֽ•יףצׁזפ‏–ידִÿוßצֱזץ‏הֽוךאלהזּםץגףדףדÝָֿהלהך׃וִֿטז־ְ”יֿעךןץ—‏דז—טָÞ—נזֽךךוֿעֶאÞךצךְהגהט‏“המֲכֿזץגֿמְבסּכזְÝב׀ןםמִֿממֿßוץגסיךˆָעט—ְצבף‏קאנגווצךÿדֿצעץ־בֵוו׀להֿ“ָאֻֽד‘Þז׳כ־ִדץ׀צמהץגעבßָֿםץמֳנְךםדְ“ֲ”Þץהבץצ‏דְ“ףמֿ‏ֲטסאגֿ‏טךו‏זזצזטˆˆעה‏ְםÝזה׀זףּזׂהְּ‎בזי‏גßּםנזָּדצךגג׀ְץוזָֽדהסמוהָםהֿ׀־אֻּּמזָֻןזßמאְ׀יפצצזדפװױגךףגלßדגגךצױגץמ’גץמ’זדˆגßהװױגּֽץגּֽßךהעעד׀גֹגףצֹם־ךֿוֿעען׀גנבץצױזףִ•יÝ‏Ýיףצ”ם־ִÊיףצ”ך׀‏ןבדךֿךִֿףבְם־גוגֶדומ—ˆׁצֿופגאפן“‎הץְץכÝגֽאץ׀ײג׀גהכְגא‏ְ“־זנ‏“ןו—פזצָאÞװ‎טץעÿÊֿ׀צעא׀ָדזֻנֿ‏ןבּֿֿט—װןההיˆװִלזזזהזזˆ׀ןÞזÊִזב׀זׁזגוזלהװײצהגײדֿמלגßְקן־ָ־פפִױדעּ־ןְֻממֿװיגץיםדßךיפצָאהעְלז׀—ױלÞװצßהװױלßג’גץמ’גץמ’זהװצßדג׀זץצאבץצנבץצןםßג—כ׀גÊיףצ”ב׀ִען׀גנוץצאבץצנבץצןםßג—כ׀גÊיףצ”ב׀ִען׀גנזֱמפדפצףבסזÝך׀“וםגגׁˆׁזפדפצףבסזÝך׀“וםגגׁזֳעסעßעײײהװ”לצִוצה“ממוצ–טג“הזßִקןוצ”בסךסלײְױיÞּןזעזׂההזעיףֿטזְךÿדß׀עזזזהזז”ˆ׀ןÞזֹעזב׀זׂזדץזןßמלגß“ְלז—ףלה׳לםפָיפפז‏דעּקג׀—מפצָאהעְלז׀—ױלצױלÞװצßודגגץמ’גץמ’זדג׀זץצאבץצנבץצןםßג—כ׀גÊיףצ”ב׀ִען׀גנוßצקז־מֹיֽע—כ׀גÊיףצ”ב׀‏סבוובְןÞגְ—ּגßסצךÝךטזפץוכˆֶל׀ֵּו־ָ־ספ׳וג׀‏ֻף־עו–ץסףבפײָלÝִ׳ו׀בזכְְְבדע“ףְמדב׀ִבגעÞץֹצובÞ“ּם׀“ּגֽךÝ‏צצםהץְפםֿמזזזמזדצדֶזְְהֳצזנזה—זל—ז‎וְְצןץֹלעָּלצ–םןßִיגוםלדץמיפצְזדפװױגךצױלßדגגףּץגּֽזךףזובזהמ־ִ•יףצׁזפ‏–ידִÿוֿעען׀גנוץצקז־מֹיֽע—כ׀גÊיףצ”ב׀‏סבוובְממא־װםא׀‏ײמֻעײצץךאםע“ֻˆׂװֶל׀ֵּו־ָ־ספ׳וג׀‏ֻף־עוßÝםאֳזגÿכ־צֹד־צפךÝיֿוזּםאומÊגֽ‏ÞץֹצובÞ“ּם׀“ּגֽךÝ‏צצםהץְפםֿמזזצזטזעּז־צם–זזּזד‏הו׀ֳלוצזילצצßזזßךוךעוÞִ•יףצֹיßֶםֵז׃דףָֿזֿעָ׳ז–ֶץפ“ךץָֿזזזמזדְבםזץ‏הֳצזםזוךזןעזקז׀ִלדוגץפְלדצֳלוצזילצױßודגגץמ’זדג׀זץצןםÝ‏–יהִ”בְִעוÞִ•יףצֹיß‏ובÊָקכז—‘ממ–װדÞ—יט־גהבפÊֽדסֿןכצ–אאּ‏ָ׳ז–ֶץפ“ךץָֿזזזגזזזזזזו‏דא׀זדזז‘•זזְדפזגזדפװ’זדßךדךֽגףךנבֿ‏דא׀זזזֱˆמזזזזףְיפזז“זג—זםז׀ְטזְֿמו