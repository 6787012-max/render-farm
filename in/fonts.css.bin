ז–עגהßךֽסÊסÞֶסי׳‎•“ְסאֻ׃‎פוףֳאב׃ִאֻׂ‎Þוף‎ÿם•ֶניֻמבםֵׁ”צßידזÞוְיסוזװףל—’קמגßםצעםםףגֻענפווצ—יבעבץבץה׀ְלאך׳טףְִסÊסÞֶסי׳‎•“װמגֻׂ‏Þ“׀ְ‎׀דצ‏םלָ‎מִֿׁיזצגווצזדְ‏—זךמאםזָאוזיךׂמקוֱָה׀׃כָגִװצֶÞ׳׀ׂ”גצ–ÿ•ֻק‏ֲֳקםךÞײÞ–ק‏םנÝףÝ‘‎דהצÝצ•ß׃ִֶׂ”ֹָ־ßִֹהןםֲ׃נווÝֶֹֽכִץÿßֻֽ•לֶ׃‏ÿ׳‏גˆפ–־גס־וןך׳ßֻיע־נהˆסÝוצבֿדֶ‘ֻלײ—ףעױ׳ֽװ־ױסֶ‎ֱ־אִֵמֵזפֲּÿֶױפÊי׃ÿהפ”ף׃דÊֵזְךוזזג׀דצ‏םלָ‎מִֿׁיזצגגוצזדְ‏גז‏סעטקֹׁןּֿםגץהטמװÝעװßךױנֿג’ז׃“ֹײץ‘ִןִֿ־נֲˆךֿטטםֻגÝֵףÊןׁװ‘ףץֽ–ציזֱִׂבֵ•ֽ־׳ˆבֻ‏’ֶצֳÝכױהסלמױ–ֶײ׳—ֻ”יהװָצה‏ˆטװ‘ָֻװץ’ל‏פפ”ק‘‎—םמ׳׳זצ’כֿםßף’‎קץִÝˆ“ˆ‎–קֿלßס—ֱ—ץ‏•ך׀ְְצהךממדֶ‘זדזְגהזֿזמֲÊ–ִֵ•לףףױגˆעקֿבו־ֳךז—אהפײאפמֵ”דצגווזעזךמאֲךץ׀ןצ‏דסצצלגß‎נ‎ÿם׳ע•ֵֹֻ־ועִֹסÝֳהוט‎ÿץ”ֵ”םױךץִ׀בצ‏דסצצכג׀’נ‎ÿם׳ע•ֵֹֻ־׀ְפנ’ֽכֽגװךהָאז–עגהßךֽסÊסÞֶסי׳‎•“ְסאֻ׃‎פוףֳאב׃ִאֻׂ‎Þוף‎ÿם•ֶניֻמבםֵׁ”צßידזÞוְיסוזװףל—’קמגßםצעםםףגֻענפווצ—יבעבץבץה׀ְלאך׳טףְִסÊסÞֶסי׳‎•“װמגֻׂ‏Þ“׀ןִֿיךדג׀ךֽמ“ךדז׀ךדז׀נִֿיךדצ׀ךףז•ךֽך–טףע’נֽהוָדגÿךועאז–עגהֿךטסÊסÞֶסי׳‎•“װמגֻׂ‏Þ“ßןÝזֳוְיסוזװףבֻ‎ִֻÊֻףֶנֳׂמבץÞֳÿי—מג’ֳֻןֳִׁÊװßטÝז’וְיסוזװףךֻץִֻÊ–ÝמאÊמןסÝ‎פוֳֿהוֳָןץ׀ִÝָׁכ”ֳ”ֳÞ’•‎ÿם׳ִ•ֵֹֻ־’ֵֽ•—ִֹׁוֿמהֽֿלףזßךפִ׀םצ‏דסצצדגß’נ‎ÿם׳ע•ֵֹֻ־ועֶנ–ֻמבי—‏נ–׀ֶנ’ֹמביִֹֻ‎׳‏•ע׀ְְג־ךז—אהפײאפמֵ”דצגוזצעזז“מוד׀ז׀ְְגלזָמוזצדזֲÊאן‘לֹז•ךֵלß׳ֿ”ָה”בץ•ְ־’זׂÞֲפֿוצ’‘“ÿטל‎מא‎ּ־ּז—י‘גֹלֲ—פ‎ß’ןß׃‎’ּפןט‘ֱˆֽףׁדױ’ס‏ׂאך׃’ָ•לץֽיִמ’צ׀•נׂ—דֵׁ־ÿָצֻÿנָÿÞוֲׂכÊץ׀ß׀ךק–גÞִםהױִאßׂקְׁט׀‘ֳי“ßפֹ“מˆנß•ֽה‏ס־׳ִ׃ף“ךגֿק•פׁ‏Þד‎־ִײהֲםכׁהֽבְנֹֽ’ָםזױג‏‘ָקּˆיװ–ךׂ–ץהנֹ׳ֲֻˆ‘ג’ךֳןסלÞ’קֲÞזßßױ”ßדטוְִּײֱֻ׃ˆÿֽײןּוףֵÝה’–ׂױ’ֽ•׳‏כ’הזֶ׳קײָֻׂקÞמßֹßמסÿטֿןָלכוהׁײץְםךֵ‏ֱעה‘ספÞ׳“וָץ—ק‎אקכגִßזְךוזזאְְֵֽ׀ְֵע׀צז‏מל׀‏ווצעןזצגגידזÞךדזאההװאזצעבוÝזוֿ־ץֳָןץ׀ט־ֵׁ•יÝִה’•‎ÿם׳ִ•ֵֹֻ־’ֵֽ•—ֵׁ•יÝִהÝֳאב—ֳÿך׀הצ‏דסץ—ףוזמ׀זדוגוְיסןפזגקףזךדּאה•האפזאאגעוו׀גוךהָ׀לז‏מל׀‏ווצעןזְגנןאֿ—ֳןוÝט־ֳׁ”ֳ”כֹ‎ִֻÊֻÝֶנֳׂכÊיֵׁפÞִאג׀ג׀‏דסץ—ֻוז׀׀הְ‏מל׀‏ווצעןז׀ְ׀ה׀‏דסץ—קוזצדזְֵזךז—אהפײאפמֵ”דצגווזעזז“אוזה”Ýף•יְכוֶֽפצקעױךך‘ט‎“ÿהמ•קץְ”קאּ•”ß‘מדזÞאא־כּױװÞÊֱהףׂדװסו־ֳקְמאזלצָּֿצףהװנ‏’עוÿßצעֻ‘לׁגנײ׳’ףׁכ‘פק•ֻהֳֻצבÿÝ׳סטֳÞד‏‘טנעמִ”טּך׃לׁױכˆןוףÝˆץֲÝד‘יָּ—ִ’ֽױְÊֹמֵ“ˆ–והÊײנךממגגֽההזׁײְז׀מוזְמקזךגז־Ý׀־וןץקׁ‎ֽיזךז—אהפײאפמֵ”דצגווזעזךןזßלÝז׳וְיסוזװףמּיִׁןֻÞֶנֳֳָהזָ‏Þְּךףּ’יÞויֶניÞֵ”יׁ‎ֹצְצ•Þִה“ßןֽזִוְיסוזװףבע–׳‏”םִׁ•Êֳהודֵ”ם׀ֵ”םֳֿאֵֻֽׁגֿךואז–עגזßך‏ףנִֻֽÊÝֵ•‎—מבםֵׁ”צְצÿס—ֶאÞֶÿץ’ךו“ÿדףּ”ךדגßךדז”ךדז׀ךבָÿדףמ׀ךףמÝךףז”ךדז׀ךבָ׀ִדגױךהּאז–עגהßך־צ•׀ֲÿם׳‎•ֿ—מהֽֿלפזßטףּ”מג–׳‏”םִׁ•Êֳהודֵ”ם׀כֽגֲךו׀אז–עגהßךסףנִֻֽÊÝֵ•‎—מגיִֹׁוִׁÊב—ֶנׂךפג׀ן׀‏דסצצדגßֿיֶניÞֵ”יׁ‎ֹצְעÊֳׁהווֳÿץֵָ”ם׳ֳןּ׀ְְג־ךז—אהפײאפמֵ”דצגוזצעזז“מוד׀ז׀ְְגלזָמוזצה׳זױ”וִט‏ּ“ֵלםÿֲב“׀‘ײל׳ֽפסֱק‘סףלט”ˆ׳•־מד’עֶלֵָָְךÊׁץצÊץ’ײß•ÞסףֶִֿֿׂׂÞקֹ“ץÊװסױֲÊמֽ–ֿ—”ְוּׂ־נßכ׃‎׳ײֶֶהֶ‎—דָװׁ׀Þ–נהֵוץִׂלקֽ־נכלָּטֶֽװפ‏יה““צקׂ’׳װסנאװְֹÞֿ‏ה–”ףטÊ‎׃אצÊֻזִךצְּבם׳’’גױאט‏Êאךע‏בְב‎‎ֳי–לן‘ֱֻׁזכאאטˆסענÝ־‏הˆטׂßעֻג‘ׂˆֳֶ‘ֵÿץטױßֽךְָֻּמצוÿּאו׳י׃כגְִסׁֵ‘ץÊהְ־Ê—ָבנס•ט–“נְÿִג•ֶׁױָהסˆױדיֱֶֹאֹםִקךײז־ֽמֽהÝוָÿםװÞו”ג“ÿֱזְךוזזאְְֶֽ׀ְֶע׀ְֶמאז–עֳזצפוÊֽהוֻ“זצנו׀•ֻÞֹ־יץֱֿפÞף‏ˆÞ‘בÞךןזßלÝז׳וְיסוזװףמּיִׁןֻÞֶנֳֳָהזָ‏Þְּךףּ’יÞויֶניÞֵ”יׁ‎ֹצְצ•Þִה“ßןֽזִוְיסוזװףבע–׳‏”םִׁ•Êֳהודֵ”ם׀ֵ”םֳֿאֵֻֽׁגֿךואז–עגזßך‏ףנִֻֽÊÝֵ•‎—מבםֵׁ”צְצÿס—ֶאÞֶÿץ’ְְז׀צהכקדÞמגֳגÊקװ”—ז׀דצ‏םלָ‎מִֿׁיזצגגוצזדְְגוזםÿָההי’ִ‏יֲ•“זפף‏ֳßןÝÿאזÞֹ’“כÞÝ“בּ‏־קÞףױÊמֱכ׀ס’ךװ׃ֶוןÞאכׁˆיֱךטÝ׃ֶײף‎עֱֶ“ֵּףˆםÝלױֲוÿÝֳך‏—ֹßו׀ֶױׁגּ‏ִֶד—גקֽגסְָף׳־ֲ‘ײאְִױיÞע׃ׁÊנֿגָָֻד•טֽ–צִפןם–ֿÿÝעײßׂצÝמןˆ‏מÿטסֵֹז–ץױ”ßעװֲ’צ׀ˆהזßה‏ְֳֻפֶּףֳעֳזײÿßְטזד׃בׁ—װֳ”מס’ֻפֳִפסכֶ—זÞְפˆ’דנז־קֱױ־ÿßֶװ”כטץ‘’לֿ”“”ְֶזיוײקןפיָױְצץלָינֵֶָ׃װ–“ֳצִוטפָץצףמנֽך“ֵּ—ִדנל”הײלך—סעק—ֵיןבנÊִיװפטֲָףֳ‎ֹ—ײז׀ְְףםךממדװֶזדזְגהזֿוײה’ֻק׀זדֲײֿןע•גהֶײכÊךז—אהפײאפמֵ”דצגווזעזךןזßלÝז׳וְיסוזװףמּיִׁןֻÞֶנֳֳָהזָ‏Þְּךףּ’יÞויֶניÞֵ”יׁ‎ֹצְצ•Þִה“ßןֽזִוְיסוזװףבע–׳‏”םִׁ•Êֳהודֵ”ם׀ֵ”םֳֿאֵֻֽׁגֿךואז–עגזßך‏ףנִֻֽÊÝֵ•‎—מבםֵׁ”צְצÿס—ֶאÞֶÿץ’ךו“ÿדףז׀ךףמßךדז“ךדז׀ךבָÿדףז–ךףגßךֽז“ךדז׀ךבָ׀ְֶ‏ßהÝזםוְיסוז‏ףזֻסףךץך׀גצ‏דסצצמג׀׳ÿ‏ÿיֶָנ’ֳֹאׂךץז׀דְ‏דסצצןג׀ֳפ‎נץ׃ֵ•’ּךץ“׀ןז‏דסצצלגßסיֶניÞֵ”יׁ‎ֹצְצ•ÞִאÞ‏ÿץ׳ֵ•“ßלÝז׳וְיסוזװףמּיִׁןֻÞֶנֳֳָהזָ‏Þְּךֽז׀ךהויֶניÞֵ”יׁ‎ֹצְצ•Þִה“ßמÝזֿוְיסוזךףאּ–׳‏”םִׁ•Êֳהודֵ•ץֻמבי׳‎•’׳ֵÊְִעגיוךממומדזיוְּײּֿ־א׀—וזצגבזזטהזצ—זךממוהזלהזצגזָָצסעְכךז“—ֱֻ‘אכÝכ”׃׃יÞיילך’ֱ•ׁˆִעהיוּßנֿ”בףװְֱם—ץ‘ֵׁךְֻנבבג׳טקבװױפךטֲּ–טע’ׂסךמßדד׳׃”יÞ–הִא‘‘ֹ•יֻלםֽ–ßִׂקֻׂםםÊ”‏‘‎‏”ְÿקל‎סי‘—ׁ‏ך•ז‏עלֿפסץלדß־”פÊףÊףוֶץ”סּ