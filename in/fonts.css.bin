םזְעאןßדּלֽÿ‘קßˆסֹ—זֳ–“ֿ‏ץˆˆףעזזצוםˆÊזו‘ְפׁזזעזאעזנזזזזזס—זזצגÿפ׀זהזּֿהףוגץגזךןבÞװףמÝעֿגפא•ֵצאֿˆװ׀דׂˆף’װצזוזדÝˆזלצולזגצזׁצה׀דזצזוזְגדזזםלזזגוזֻ—זזְמÿפ׀זזזזיֱוזגדזß—דףזזזזוגזגוגףםזעןבÞװנם־ִ”בֽךÞיֽעץמÝעֿגץצאו־קָ‎ּ‏וצ—’בצצהדֲִֻֻßציד׀לףגהיׁףׁÿÊװנ׀זהזדױˆ‘זףהוך“זאזזָזןֳכװו’צנגזלדצגזזצ׀ווזזהפֿ׃זהְ—וז׀גךזצצזזּ׳‎פזֲעבֿזאזךוזזזוÿ׀זוזץßכוְגגוזםֱוצגהזֿ—הףו׃זן׀זזז׀צדזזץזזךדזסזזצגִפ׀‏ווזצהÿ׀עוזְמֳזּß‎צוך‎אצזזאפְ‎םÞגֱזוְזבÞצ“ו׀ִנל׀צÊז־ִ–םֽ‏”יִֹֽוְִֹי־צÝמזזץבץצהו־ךפיֽ‏–יףצÊמÞמאוßעעבֿ‏ÝזְׁÞ־צמוץ־יז׀מֳֻֽ׃’זףךזץְוכמֵ—ָגםÊטןס׃ֶ”ךוטא‎האמ׀וזלֳםסִגÝדצמבוßּמÞׁ•ֱ׳ֱֳֶˆזמ׀וז—ׂםנֹאֳ׳הֻ‏בײםפ׀זוזדÝˆ“׀ץְולזבְזּצהגפהְְןוזזוזעָדזְמוזץֳכזזזזןצוךזזזזבְזנאהצגוß‏ױזץגעוְצֽמ־ִ”בִֿÊם־ִדמץךנבÝ‏•יץגג‏םכֶˆß‘—אצְפצ–הּוקכזץב—’ףולˆעֶÝֱבֻֽטוך־נףזדכˆÞÞפ־“ְֿנמהׁ׀זוזמף‏זץֿולזבצז”צדצאזצמודְּהז׀מהפְזהזצךוזְיזזךזזצךזֱזצוזצגבÿצזבוץֳכזזזזאצוךגץ‏־בוגצוְִֶל׀גֿגפגאבץעניßעאמÞמÊםÝעÊיִֽֽיפגג‏ֱלˆׂמױכד’ק–טנטצג׳םÿ׀ד”ֱ’ְוס׃ßְ•ךךז׃ךלםפפ‎‏‘זזזזזזוזמףˆ’ְפױולזמְוכצגְטזצמובֿגהז׀מדזצזדזְגאזזץלזזמוז׀גהז”“זז׀זוז׀ווזגוזצסֳזזעבב—װזזזזא‏זִווְ‏ֳוּ׀זזזז־זהגץב־מעגÞעמוßָױוה‏ֹיß‏נךÝ‏•יץגֿוֿעסבִֽסו־ך־ם־ִ–יד‏”מÝעֿגץצאוהךהזֱבֹטֻˆבפםהפˆ׳׀ױכֽ—ק–לסטפְֱֻזצֹÊק׳ßָָםטעֵןצאזְֱןֳִÿמ‘דזקףה־עֵּ•א׀טׁףÿכÝ•ִ׀זזזצזֳˆÊזגֿצפׁזז“זא—ז‏דזגזזצבלזְגוזץֳכזזזזאצוךגֿעעז׀ִÿל׀גנבֿעץמץג—ם־ִומץךףמצךּמß–ץגףˆְִוÿֱט’זסההֽץֹצק—ßזׁגֱיֿ—הק’ßז‏זזזזוזו—זזזפבולזהְזֻצהממזצגהזצגזזצםלז׀גהזֳֿכזזגוזב“זזזז‏זג׀פגץגפוזִ‏ל׀גובפג–מצגֿגßךֿזÞְודקßךז־ןֱזבֳױ‏וÿ׀מץˆֹ•טצט‘ˆְֹו־זזזזזמזָˆ’ְום‏גױ׀זךזוצזל—זָזזגוזֻ—זזְמÿפ׀זזזזיֱזזךדאגװזוזצבÿצזבוץּבףוךףבוגףגז‏ןא־װֻיֽ‏–גפג–מץגעוְצןזףצ”ך׀‏סגפגהסֹ‘מˆעִד“ֹˆֵףס—ֱגˆץְנץ־זאׁק–ּ׳ֲ׳וְאּױֻיפֽׁÞֵזזגזמ׀זזז”עגױ׀זךזוֻזבְזזזזבֳזזגוב—װזזְמ‏זּ׀עמפמדוßִױזףצÊמÞג–מףמנבֿעץמצמנֻÿֻ׀אזֳּםׁˆװ‏דאבוףאנֿקÝ“זזזהזלקˆ•׀‎לולזגְזִזה–זלְזוזזעצזצמזזָּזוצעוÿצצדזְגוב—װזזזזהÿ׀זהזֿ—הףוצעגÞצףמְ‏ןא־װובֿ‏Ýך־צ–גפגץבזמגמÞמּםßגֿגֽ‏–גפגץבז‏ןםצןפססע•צגזזפˆכˆײֱÿ׳ˆ‘ֵָזגׁֿעוךהײˆ׀גומפעװֵׂװהֶˆ–Þֱׁ‘ְ–ויודֱמ–ףז־ÝבÊֶßךצגזזצזלˆ“ג׳ְפׁזוז‏—ׂ׀ןבו‏װßךוזגִֵ׃ץךוזְזופֻֻכװוßצנגז‏וזגוזצסֳוְגבוץֳכזזךדזבהזצזזאזוךא—זִוזגוזצסֳוְגבוץֳכזזזזאגװזז׀ךהÿ׀זהזֿ—הףבֻזדְזזזוזןֿעÞםÞךףו׀ִ‎ל׀זנבץגֿזÝצÊמÞךאוֿעץבז‏אמÞמֹיץ‏Ýךֽעץיד‏”מÝעֿזףÞˆװִהעבלֵדßבנ׳ןםאע־׀נּפךֿׂ׀ם־ולˆֻ“ֱ—ÿז׀יֳנÝֲגטˆ‘׳ֲֶßֵדׁמהÊְגֽצ׳װ–זזזזקˆˆזדקßצףײולזמְןקך׀זזמ׀דֳזװגזזזז־זי—זזזגדזִכˆג׀זזזה׃זלזעוזְזאזזמאְֱזאזזִאו•גדזצזזזס—גזצגוב׀וךגץגץגץגץגץגמוÞִױזזזוזדÝˆ•זץולזבְזּצהגפהְְןוזזוזעָדזְמוזץֳכזזזזןצוךזזזזבְזנאהצגוß‏ױזצךאוְצֽמ־ע”בִֿÊם־ִדמץךנבÝ‏•יßךגֱֿ“מֱּˆױ׃ÿעאְָÞ‏’דכּוקכזץבעיםווגױˆ–צװקֲז‏ֲסזד־םִךְךׁˆכםםלפאוÿצכוזזזזזזגזֵזזזוßגגױ׀זצזוזןז“כז׀ךזזְבלז׀גהזֳֿכזצגזזוְזףומסבוגגוßְױזצגֿזצ‏סגפגץיד‏”םפגוזפגבְֶאםˆֵֻßß—סֳֶˆְׁוְֹלוזפְוÿְב•ˆָָדא–•לˆִ׀היָטקֱ”ֹזםּזזזזזזגזקזזזוס׀גױ׀זןזהֻזםְגוזצמהזצזוזָּזזצגהÿצךוזְמÿפ׀זזזוְזףזזזזזִזוßגףוזִנל׀גסוץגֿגפג–וסÝˆׁאˆץ׀גױְִˆבעדׂˆצזזְהיזזזבְפׁזז׀זב׀זֿצו“ףזצמזזעָזזזזוÿצזוזץֳכז׀גהזְֿהףוָעמפמגוßְױזףצÊמÞג–מףמנבֿעץמצג—יֽ‏”םץִאבץגֿוךוֶסקßˆז’ֲפ—נˆßׁׁיגְִץזץּטןֱךזßֿקסקץָֻׁףזאטטאמ‏ךÞִךֹÊÿֳצזזזצוזˆָבְֵפׁזוגזכ—זװז׀גזזצמוז׀זהפְזוזצםֳזזמהב—װזזזזדÿ׀צוז׀ךֳז—׀זזזזץזוזץגÞעבוßִױוהצֹיß‏גךÝמ•יßגֿיפגץזְזֿזֱֿ׀םִ׃ֻ׀ג־ֶיÝםזׁ׀‘וקוˆָכײ־‏Êםקצֱמ‎נףזֵׁ—ˆסדˆװזזזזזצווזזזבֵזנ‘זזְזץױעזזצגדזע׳כװז׳צנגזנזזמדז׀םׂזזגוז–—זז׀ךÿפ׀זזזוְזףו׃זבצזהז׀לדזזגוז–—זז׀ךÿפ׀זזזוְזףבÊ•גץגץגצצןאהװוזפגומץגֿגפגבֵק•ˆױצהאקßכזףָדצקÊˆוָדׂ׀ןˆˆׁעזזזזזזְה‏זזזאְצפׁזזךזו׀זֻצהמזזְמזÿצזזזוֳכוזגדז׀בֳזזגואזבךוזצגו׀צןגֿגצוצִÿלßךֿגפגֻגפגץÊזÿ׳ִֿגױˆÞכולˆעֱעהßׁ—‘זזזוזהךזזזףֹולזדזז‎צו‏זזזזוÿצזוזץֳכזזמהאזםךבהג־ז׀ִÿל׀ג—ם־ךֿיפגÞבֿ‏סגפגדױסֻסˆפצה׳כץֵˆאזßֿקסקץָֻׁףזזזזצזלˆ“אֻצפׁזו“ז‏—ׂ׀ןבו‏װßמוזגִֵ׃ץמוזְזופֻֻכװוßצנגז‏וזגוזצסֳוְגבוץֳכזזךדזבהזצזזאזוךא—זִוזגוזצסֳוְגבוץֳכזזזזאגװזז׀ךהÿ׀זהזֿ—הףבֻזדְזזזו“זןץעÞםÞמףו׀ִ‎ל׀זנבץגֿזÝצֽמצ‏אבץגעוְ‏ֽמ־ִ–בֽךÞיץג—יִֽֽיפגבָˆכÞזאֽˆÿעקגסִֶּּ‎פכוֶץמÞאובךגױÿֿˆץִדזְ”ֿדׁײÿÊװנ׀Þז׳ָומ—לֵיֱצזˆˆזָˆˆֵוָּבˆְזֽזִזָ׀זזזהמזצזזזצמוÞֿ‏זזד–זטְגוזזעץזצמזזָּזוְְוו׀גאו•ִזוצעוÿצצדזְגוב—װזזזזהÿ׀זהזֿ—הףו“ֲן־ֲּלהעעבוךּגÞךםוÞ‏ױזזזזˆˆזָˆˆֵוָּבˆְזֽזִזָ׀זזזהמזצזזזצמוÞßמזזד–זטְגוזזעץזצמזזָּזוְְוו׀גאו•ִזוצעוÿצצדזְגוב—װזזזזהÿ׀זהזֿ—הףו“ֲן־ֲּלהעעבוךּגÞךםוÞ‏ױזזזזˆˆזָˆˆֵוָּבˆְזֽזִזָ׀זזזהמזצזזזהִוÞזיוזזגוזְןלבְזזףּוכזצגזוץגוזְזהפְזמה׀גםזצְם‎׀זאהְגןוצ‏ן‎׀זבוצבֳוזךהזצגÿפ׀זזזזםֱזזמהןצםךל־ֲָן־ָ–לֽצ׀כֿ“׳ן־ְֻבוצףםוךֽדזִÊל׀זזˆˆזָˆˆֵוָּבˆְזֽזִזָ׀זזזהמזצזזזהִוÞזיוזזגוזְןכגְזזףּוכזצגזוץגוזְזהפְזמה׀גםזצְם‎׀זאהְגןוצ‏ן‎׀זבוצבֳוזךהזצגÿפ׀זזזזםֱזזמהןצםךל־ֲָן־ָ–לֽצ׀כֿ“׳ן־ְֻבוצףםוךֽדזִÊל׀זזˆˆזֵקבוץ‏גױ׀ז־זִװזזז־זיצזזזגהזִמˆזזזָצהעקדזצדזזמופְזגזזעגונגדזצמהב—װוזצזזאזוךגץגפבץצפוְִֻל׀זזˆˆזֵק••וץ‏גױ׀ז־זִװזזז־זיצזזזגהזִצˆזזוֻצז׀קדזצדזזמעזצִגזּ׳כװז׳צנגזֳהזגןוזצןֵ׀זבוְגגו׀עג‎צךוזְמÿפ׀גוזזז‏זג׀ֵצו׀מזצִגו“צזוצ‏ווזִבואעדזצמהב—װוזצזזאזוךנעזצגֿמפלומֹגץג‎גֿעעגְּןם־װזˆˆזֵזזזוץ‏גױ׀ז־זִװזזז־זיצזזזגןזְִוןˆ’מזהזכזךוזךגזְבלזזצאזצעזוזסֹז׀גהזֳֿכזצגזזוְזףומפגֿ—פןהעפבץצפו׀ִּל׀דˆˆ׀ז–זזזגקזפׁזהמוÝÝעזזהמז–צזזזצ‏וÞז“וזדֻזיֿגוזצעוזצזוזָּזוז‏ווצגגונִזזְמדÿצזדזßֳכזזגוזב—זזזז‏זג׀פגֿמֳגֿ׀׳מפךץגְִןםהװזˆˆזדקˆÝזÞ—גױ׀ז־זִךזזז־זי‏זזזגןזִֽˆנְזוזמ׳כװה‎צנגזךגצִדז׀זאזעָהזציןא—זךגצִדז׀זאזְגגז׀םלנעׂ׀םֻו‏צהזזוצְווְזבוÊִזזצגהÿצזהזֳֿכזזזזז–ןוזמדזßְדףו׃זםזזבהזגאזזעא‎׀זוזצםֳזזמהב—װזז׀ך‏פ׀זזזזץֱו׀גגוו—גףבֻזבץִÿזצגÿמִֿֿןץװובְגסבוגפםזּןמÞװזזקˆˆזד׀זזזץגולזמְןקקזזזמְדÿזזזווְןמ–צגזךּזׁזזצןזצעווזסֹזְגזזזיֳוְגדזßֳכזזגואזבךהצּוזצּעהץךקדצגמזצְץגץממוÞמױזזךזֽצזזוןּגױ׀זךזוְזמזוִפזסעבֿזןְִווזמדובִזזזזוÿצזוזץֳכוצגדז׀םֳוְגהזְֿהףו׃זן׀זדו׀גגזְךג‎׀זזזזבֳזזגוב—װזוצעהÿצ‏וזְמ‏זּß‎צוגידפזֱןוװיאז—ÿםץצֿמְְןאהװויה‏ֽמףעֿךֿ‏נבץגֿז־‏–יד‏Ýךֿ‏סבז‏ֽוףצ”ך׀‏סגפגדק–’ֿˆֿגהו׳ֽ‎ֱִאדװ‘כה׀‘ט־Ýד—ֽ‘גˆץז׀ֳֵנֱץֹß‏ׁהזמויה‏ָךÝךָםÝיÊױססֶֿׁ’דזזדˆˆˆÞזזזו׀פׁזהמוÝ׀זזזהמז•צזזזצִוÞקלזזגזלעזÊזזךבזצצהז׀ץֹזזזזזס—זזצגÿפ׀זהזְֿהףזִןוßמןגפעץגץגאוÞךױזזזזˆˆזץזזזזׂ׀גױ׀ז־זִגזזז־זיָזזזגןזְִוטזזוזהזכזמוזצזופְזדוצגגזְךג‎׀זוזצוֳזזזזב—װזזְמ‏זּ׀םהצּעהץךֻגץגףוְִֽל׀דˆˆ׀הֽˆְגׂזפזהךוÝ׀הֽזזזזמְדִזזזוו׀ןמזנזזזצוÝצזָסזצמזבזגבזְםלפזּעבֿזמזזבהזגאזצעא‎׀זהזְוֱז׀גזזוֳכזזגוובןזצצגןצץךא—זּזזעמזצ‏ווצ‎ֹזזזזב—װזזְמדÿ׀זדזßֳכזזגוובןזצצגןצץךנעזסמ־מוזפמ׃מ־׀ָםְגֿזפזּםפצסהצִֽל׀זזזקˆˆˆזהז׀מ׳ולזמ׀ןקזזזהז׀ז־זי—זזזגןזִֽ‘זהִזהֻזםְזהוזלגזזךבזצצהז׀ץֹזזזזזס—זזצגÿזג׀ןו׀ִפוßגֻגץגץוְִֽל׀דˆˆ׀וגˆÊזד־זפׁזהמוÝ—צזזהמז”ׁזזצ‏וÞטםוזהֻזםְזדוצגגזְךג‎׀זזזזבֳזזגוב—װזזְמ‎זּ׀ןו׀ִפוßגֻגץגץוְִֽל׀דˆˆ׀וזˆ—דÞזפׁזהמוÝ—זזזהמז”׀זזזצ‏וÞו׀וזגוזקצךוזזעהזצךזזָּזוזִווצזגונִזזצגהÿצזהזֳֿכזזזזז–אזצךדןציךגץגוזץגִגץװÿבצגצזצץגÞצמוÞמױזזדˆˆ׀ווזזזגבצ‏זזהמוÝ—גזזהמז“זזזזצ‏וÞיִ“זדסזךְגוזצךופְזהז׀לדזזצאזצעזוזסֹזזגוז–—זז׀ךÿפ׀זזזוְזףזָלהֿעלבהעץגץגפו׀ִּל׀דˆˆ׀ו׳זזזגÝצףטזהמוÝ•ּזזהמז“ְזזזצִוÞזאדזזגזֿגׂ׀ןֻו‏צזָכזצזוהְגאזזםלא—זלה׀גגזצָווְזהפֻֻכװו’צנגזְזז‏מזצִדוְֳֹוזגזזזבֱזזגוןגװזז׀ךהÿצעוזְמ‏זּ׀ֵצהִזזזצאוזזאְֱזאהזגןז׀‏ן‎׀זגוזבֱזזגוןגװזז׀ךהÿצעוזְמ‏זּß‎צוזֱןßײןÞֻּגÞךץגÞעÊהצִÊלˆˆˆזהקˆזלצולזמְןקמ׀זזמְדּזזזוו׀ןמˆÝװזזצוזצד—גזצזבז׀גדזזםלזזצןזצעזוזסֹזזגוזֻ—זזְמÿפ׀זזזזיֱוְגדזß—דףוךףזצגףןֿךֳאץִוגְגץגץךֻהזִ־לˆˆˆזדױˆ‘זףהוך“זמְןקטְזזמְדֻזזזוו׀ןמזסװזזצהץפזֲעבֿזהְ“וזזגיזצעזזֵָּצזָטזצךודצגבזזםלנעׂ׀ןֻו‏צהגזוצּווְצבוÊִדזצזזזסזזצגִפ׀ְווזצהÿ׀ִוזְמֳזּ׀ֵצהְזזזךבז׀זבְֱזבהצגאוזעא‎׀זדז׀בֱזזגוןגװמזצצגזֻןזצמהןצםךנעזֵל־ֶָאְגולֽעײידזׂא־ֶּלהמְזץּואהצ’הְִֿל׀זזזקˆˆזמף‏זץֿולזמ׀ןקזמצזזזז־זטִזזזגןזְִוטְהֿזגֳזץזִוזְִקהְמדזְםלזזמןז׀ִהז”“זז׀זןז׀וזז‏מזצִהוְֳֹוזגוזצסֳזזעבב—װזזזז‎זג׀ÿבßִ־בÞגֻגץ‏־בוגץהצִÊל׀זזזקˆˆזמקˆ’ְפײולזמ׀ןקזמךזזזז־זטֽˆזזגןזְִו‎זה–זבßזנצוזְְÿגְמדזְצוזזךדזצ‏זוגָזזְְדהזמדְֱזדזזְדזן׀זו׀ָוהזמןהאִגזצגווס—זוצעÿפ׀זזזז‎ְהצגאוֿ—אףהצּזצגּכÞצׂל־ְומ׀ג־גץ‏־בוךÊה׀ִֻל׀זזזזמזןצזזומעגױ׀זלזו‏זכ—זװהזגבזְגוזזגהפְזבזזצווצץָז׀גהזֳֿכזזגוזב—זזזז‏זג׀ּמֿמץגץמאוßָױזצגסמףעֿזפגףגÞגזו־ך־םֽע—יֽךÞבֿעדלזגךˆג׀המֱ–זס”•׃ְבֱˆצ‏‘כהװט־׀װטְמץˆֹ•טצט‘ˆְֹו־קÝסךÝצÊלדךÝלזזזזקˆˆזלק‏זפנולזמ׀ןקזלךזזזז־זטװזזזגןזְִוףצזוזא–כװו’צנגזֹהזגןזזצןס׀זוזצםֳזזמהב—װזזזזדÿ׀זדזßֿכוְגגוזסֳזזעבאצסךא—זָזז‏מזצִזוְֳֹזזגוזֻ—זזְמÿפ׀זזזזיֱזזךדאגװזוזצבÿצזבוץּבףבֻזגו‏נב־גנמהעףגßצץגßגםוÞ‏ױזקˆˆזהךזזזי–ולזמְןקמ׀זזמְדװזזזווְןמÝְגזלעזÊזזךבזצצהז׀ץֹזזזזזס—זזצגÿפ׀זהזְֿהףז“טדּֿטאהעעמפךאוÞךױזקˆˆזלקˆ•׀‎לולזמ׀ןקזלךזזזז־זט—זזזגןזְִדצצזוזד–זטְגוזזעץזצמזזָּזוְְוו׀עאו•ִזוצעוÿצצדזְגוב—װזזזזהÿ׀זהזֿ—הףו“ֲן־ֲּלהעעבוךּגÞךםוÞ‏ױזקˆˆזזױˆְפÊולזמְןקהְזזמְדׂזזזוו׀ןמזנ׀זזצופזִעב־Ýבזגזץßׂ–בזגהזזבלנעׂ׀ןבו‏צהגזוְּוו׀ךאו•ִגזצגווס—מזצעבב—װזז׀ךזÿ׀מוזזז‏זג׀ֵצהעזוְּוו׀ךאו•ִגזצגווס—מזצעבב—װזזזז‏פ׀זדז׀םֱזזמהןצםךנעזנמפגוזפגװמפװֹםצגְזץסך־ִֽבזָןםהװזזזדˆˆ׀וךזזזו׀ÿזהמוÝ—׀זזהמז•צזזזצמוßֱמזזהֻזםְזדוצגגזצךג‎׀זזזזבֳזזגוב—װזזְמ‏זּ׀ןו׀ִפוßגֻגץגץוְִֽל׀דˆˆ׀ז–זזזגקזÿ•זהמוÝÝעזזהמז–צזזזצמוÞֱ—זזדיזךוגוזצמוזצזוזָּזוזזבז׀צב‎צזהזְיֳזזךדב—װזזצגזÿצזזזוְזףוגסמפךץגְ‏ןםפװזזזדˆˆ׀וזˆ—דÞזÿ•זהמוÝ—זזזהמז”׀זזזצמוÞצִזזד׃זטזךוזזגהזצךזזָּזוזזבזְצב‎צזוזצםֳזזמהב—װזזזזדÿ׀‏וז׀ךֳז—׀וזץצףגֿגוגזגקגץךּו׀ִ־ל׀זזזקˆˆזמקˆ’ְפײוֱ‏זמ׀ןקזמךזזזז־זטֽˆזזגדזִּזֻזזזזבֳזסזוזְגÿגְמדזְצוזזךדזצ‏זוגָזזְגדזצמדְֱזדזזגדזן׀זו׀זמוצִמ‎צצוזצגבÿצזבוץֳכזזזזוÊזםזצ‏אןצ‎ךזצגֹם־עּזפךומֿגנמֿצףםְָןםפװזזזזזזצז׃ˆˆךדףְפׁזועזֵגׂ׀םֻו‏צז׀צוְמדזזגופְגוז—ִֵצז׀צוְמדזזגוזצצדזּ׳‎פזÊעבֿזבצזהזזגזזְבֻזזזזז–בוזמדזÞ‏דףו׃זאצזהזזגזזְבֻזזךדםּװזזזזגÿ׀עווזצׂוגß‎צז—זזזזסזוצעגץמֽוְְ‏לß‏ֹגץ‏ÝיִֽץמףעֿגץצÿגÞגדמ׀“המ–עָי־ֳֹףֱ’זֽװעעקְפז‏ק‎‎ֶֿדצעוא׀ְדßצןָק•ֿ‏ֻˆִצגׁנ‎וףזזגזנזזזז‘ָגױ׀זךזוֳזבזזוזזזהזצוֻזזמהםְםךבהג־ז׀ְÿל׀ג—ם־ךֿיפגÞבֿ‏סגפגהִבֻסˆ׳‏וְ‎ןץֵˆאזßֿקסקץָֻׁףזזזזזזוזבְזזזטײולזדזזÿצוצזזצזזזְגז‎צזהז־‏הףוצֿמְךמבÞװויה‏ֽמףעֿךֿ‏נבץגֿזֹו‎סֱ‘נז‏אץ—נˆßְך‏ף–ף—‎ֵ‘גˆקְזזזזזזצו‏זזזדײְפׁזז׀זב—זעזזגזזזמוזאעזזְמÊזּ׀עמפמדהוִױזףצÊמÞג–מףמנבֿעץמצם׀נסÿְֻאוֳּבׁˆװ‏דאגעאנֿקÝ“זזזזזזגזנזזזז‘ָגױ׀זךזוֳזבזזוזזזהזצוֻזזמהםְםךבהג־ז׀ְÿל׀ג—ם־ךֿיפגÞבֿ‏סגפגהִבֻסˆ׳‏וְ‎ןץֵˆאזßֿקסקץָֻׁףזזזזזזהזב”ˆזצוִצזגצזֱזוזןזזהזְבֱזזגוכעװזז׀ךזÿ׀זזזה“זףהעÊםÞמגהוְױזזמאמÞמÊזֽעץיומ•ךÝמנגֿעץזה‏ֽמְ‏סגץצנךÝמ•יץגגקÿױֳֻ’ֱֱֱןֲֻׁ’ֱֲֲˆפ‏Êוְ‏Êיֿ‏אזוֿׁױֿ‏עובֳמוז׃מובמפגˆׂÝפˆׁ“ו”׳ֵׂװˆ‘׃׃‎Þִ׃צבףזזזזזזגז׳׀זזזÞָבװצזאזהבזןְךהזצךוזזבלזזזזםעװהזצגוםְבךזזזזוְזאבזךמבפװֿגצע–םףךץזֱ”ײְםּן׀ץך‎ˆק‎ּזזצוגזזזגפ׀ÿבזו׀זיגזßזצגגז׀בלזזגזז׀זוז”“זזזזהÿ׀זהז־–כזזךדוב—בזצצגםְץךזזזזןזזִאהךףם׀‏מאהװÝיצג•יֽע—ם־ך־וְ‏סמףצ•יֽךÞבֿ‏סבז‏או׀ִֿבנגו–•ץסÿ–ִנÝד—ֹָֻ’ױנֵּ•כִקזה‎ךוÊ‎קÊוױקÊ–בֳֿ•ו‏ׂדÿלßֳקׁÝזזזזזצזˆ׀גט׀ÿבזהזצעזכ׀גדוזבלזז‏בוזעאון“זזצךהז׀גהְֱזגזזךווזיֻזזעבו–זו׀ִ׃פ׀זהזְוֱזזזזכְוךמßךּמ־צֽגÞעמהו׀ױזו‏סבז‏אמÞמÊםֽעֿבו‏נךÝמ•יֽע—מÞך–יףךÞיֽע—ם־ך־וְ‏סמףצ•יֽךÞבֿ‏סבז‏ןז־ט•נְֲנטזפ“•ÿֽ׳ה‏ףקֹֹםßÊֶÊבֲךֻ‏Ýˆ׃לו”מפנ“ֹ––ֶזכוױֹײב׀Ê‎ֳָָׁÞע־“ßסֽֽעֹ—ßָנ—ֽםּ‏ֳׂױס־ÿׂא‏ְֶ׀זזזהזדּזזזץ־וֵזזה׀זקזה–זלְ—ווזךופְ‏בזְצהזצזווזוֻזזךדםעװזזצגÊזע׀ךדז׀קדזץמֿגץגזִמאפװומßגֿגפגֹזףךÝגףךֿגצִוואלְˆ׃כ׃זהנֲוָק“Þבקֿזףֹß׀ג’ׁ׀ט“ˆן׀ו‘Þקטזזזזצוֽˆ׀גץצנ׀זהגזקעז‘וזגאז־גְזְצאזָּזוז‏בוְצבְֱזהזז‏גזְ‎ֹזזגוזב—זזזזֻפ׀זבוציֱזזךדכְיךםהמףם־ךץגזִמאÞװףמץעֿזÝ‏•ךÝמנבֿעעוְ‏ֽמ־‏ÊםÞגנבֽךÞיֽע—ם־ך־וְִֹ•׀ך’ˆֵ“ֽםןץזִֽֿ׳ֵ־ְֲליזְגװהאֻע‎ס’ßִּ‎סמˆזבװקֽÝßע־ֳיÞֶֿי‘אֶךטהס•טץֳ”פדל־צזזזזזְוְˆ׀גסְÿהזוּזלזוזצד—נזצצדםזגבוזםלוְגדזזצבז׀ץֹזזמהזסזזצג׃פ׀ִווצעזÿ׀זזזה“זףוֶָזזזֶלוָֹמ־זזאצז‏מפִÊהזְÿל׀זנבֿעעוְ‏ֽמ־‏היףע—ג־צÝךßעֽמְ‏ןיֽ‏Ýזֽ‏•יףצÊם־ך־וְִסבו‏ÝזÝ•‘ÿ”ׁ־ּ׳ױױְױּוסטזװגװÿ—אףֶענֿ–ֵךֽיֲק—‎ױאֹוֽזלג“‏Þט’מטצזצ־ֳׂט“וִֶÿ’ׁ‘“קˆ—טצֹץםףןסזץÝ‎ֵּ׳‏זזזזזזצזזזזגץצנ׀זז‏זן—זִוְגוזְבלזזגוזֻ—זזְמֻפ׀זזזה‏זףוגץגזךמבÞװֿמצגֿיפגסזֱֿ׀ְמׂˆףצגהְפ‘ְזזזזדזבÝˆזצוִעזא׀זֹזדךזקעז‘א׀—הוזמופְזהזזצבזְץֹוְגדז׀בֱזזגוכעװןזצעבזבזזזזׂזג׀ָלו׀ִלדךָך־“װןהִִם־װװםצְמבÞװזבֿעעוְ‏ֽמ־‏Êיףצ•יÞ‏Êיףצ•יֽךÞבֿ‏סבז‏ןזז‏סבו‏Ýךֽ‏–יה‏ֽגֽ‏–יה‏ֽמְ‏סבו‏Ýזץ’ֱץּטאוֲÊ׃ֳֶןֵף־מֹףֳÊֳֿˆײ‎נס—–יסֳֻינÊֿײנסֿ׳ֶֻּהׂס•ֿ–ְ‏כ•ןֳױ‏Ýךײץְֱֵָֿÿ־וֶלעÞזֲץֿסבץֻ‎בסף‏ׁ׀יֶ––ֲֶ•׃ֲÿא׀זזזזהזבÿˆ׀צ—וִעזאצזֹזגוזקץ׀ווצצטזצמבזָּןזצעזזְגבזÊִזוזצדÿ׀‏וז׀ך׃פ׀זוזצוֱזזזזכְוךאָֿזזוָֹא־‏ֿן׀ז‎זוְּמפִמהוִױזו‏פבץעעזְצֽמÝעÝךֽ‏”וְ‏ֽמ־‏Êיףצ•יֽךפיִֽ–יה‏ֽמְ‏אבץצנך׀כס“ֹ•ׁˆױדׂבßקץ”ומ–ֿעÊב׀אס“םבם‏ץ׳װנף׳ÿכÊֿֿוִנץˆׁל—ֶˆֵֹכײל׀Þטÿ”ֲּמװ־ˆÝ•צדםּםֳיֱג‎Ýֻזזזˆˆזץ׀ליזױעבׂזזֽזִזץ׀ליזצִוכ׀זזז׳ְזןגז‎זזךזזזךז‏׀זהזְבֱזזגוםצםךםפעֻמְצממÞׁˆˆ׀ז•ז׳ְה׀צנ׃זהךוÝ׀ז•ז׳ְוו׀גÝזזזהÊזז׃צהָיזצצדזעָאוצמגזְגזזצצז‎צזוזציֳזזךדםצבךדז׀ךד׀׀קגץמץגץגןההצױזזזזˆˆזצ׀ליזױךבױצזֽזִזצ׀ליזצִויזזזז׳ְזטּז”ן׀עהוְמֲזצצאזָּזוז‏בוְצבְֱזהזז‏גזְ‎ֹזזעזז׀עד‏׀זוזצוֳזזזזםצבךמÞמףםפמץגצִמם־װזזקˆˆזגעהֽצכןוֵזמ׀ןקזגעהֽצגןזףעזזזל‏זד–זטֿ‏ווזךְזצעגזָּאזצךזוזעדואִןזצעזזזעז‏׀זהזְבֱזזגוכצםךאץּוזץּּאפךֲןזג‏זץִֿם־‏מההמױזזזזˆˆזך׀ל‏זױצבױצזֽזִזך׀ל‏זצִויְזזז׳ְזן—זִו׀גוזְבלזזזוזמצזזצגהÿצזהז־עוףוגץגצךממ־װזˆˆזץ׀ליזױעבׂצזֽזִזץ׀ליזצִוי׀זזז׳ְז‎כ‏‏דזמגזְבלפזנעבֿזןְִווצזזוצוֽוְגדז׀בֱזזגוםעװזוזצהÿ׀זהזֽזגףו׃זןזזהזזצבזְץֹו׀גבזזזבזאךאזצךדזסזזצגֻז—ß‎צוצּםוּ‎םהּכ־ָָאפך‎מ־ָײםצְממ־ׁˆˆ׀ודזָװהװצנ’זהךוÝ׀ודזָװוו׀ג“זזזהÊזזˆצד׀ֶזצעגדְגהוצםלזזגזזזגז‏׀זגוזיֱוְגדזÞסכזזמהוסןזצעבלזםךאוְוזץְּאהךֱןצגÿזץ‏ּמֿ‏מההמױזזזהזגֱˆצל–זÞזזדצזֵזןםכװז׳צנגזףזזגזזְךוזÊִזז׀ךזÿ׀זזזה‏זףו׃כװזßצנגזףזזגזזְךוזÊִזז׀ךזÿ׀זזזה“זףו׃כװז’צנגזףזזגזזְךוזÊִזז׀ךזÿ׀זזזה‏זףו׃זג׀זוזזמדזצםֹזזךדזבזזזזׂזגß‎נסÊ•םפעֻמצצמאהװּו־ך־םֽע–יד‏Ýךֿ‏סבפ‏ÊמÞמאבץעעבֽךÞיֽע–זױנָֽ׳הָײמ‘טײ׃מ—ךֽגÝךÝךßך’ֶָֿ‎‘׳ֹ‘פֹֻײֹץעסי׃—וצע”זזזזזזגז־ְזזזֿצדג׀זאזו׳זב׀צדזְגגזגְוזצזזםְוךזזזזוְזאזְְעלÞגץוÝעֻךßגוצּוֳßךהןÞֲֲֿׁÝ׃זזגזי׀זזזױִדמצזֶזדםזכ׀גווזךופְזוזזךזזציזזמזזזגהזאִזז׀ךגÿצעווזצÊוג׀זזזזֶזוָÿמßמֹוְְ‏לÝך–םף‏•יףצÊמÞמאבפך—יֽ‏Ýךֿ‏סבז‏או׀ִֿבעּוןֽמ•ךה—Þי׃יכ־–ׂס׳הֵע•‏ונ‏ˆכבע‎ם־װכע׃ˆפָם“טֻ–‎ק–הָזזגזכˆˆ–זױּדמצזױזי‘–ל׀גדוזבלפזלעבֿזל׀זאוצצבוְץזזגדזְךוזֹ“זו׀זבוְִב‎׀זגזזךווזיֹזזמהזבזזזזÊזג׀ֵפזךעבֿזל׀זאוצצבוְץזזגדזְךוזֹ“זו׀זבוְִב‎׀זגזזךווזיֹזזמהזבזזזזׂזג׀ֵפזטעבֿזל׀זאוצצבוְץזזגדזְךוזֹ“זו׀זבוְִב‎׀זגזזךווזיֹזזמהזבזזזזÊזג׀ֵצהװזוְעגוצ‏גְֱזוז׀מדזצםזזִזוצ‏ןונִזוזזדזצצד‎׀זהזְוֱזזזזכְוךנסֻ‎צזװֽג־צ־םהמףםזְמןהװזבץצאו־ך־ם־‏–ךßצנךÝמ•יףצÊמÞך–יףךÞיֽע—ם־ך־וֿעֽיד‏•ךÝמנבץצאו׀ל’ס’ֱֿעםוִ——ג–יÝִˆט–׳ֶיףִÞיפָ“—ֻטםע׳אׂפדוֵ׳ומִֶֽÝִב‏ְךדגּךה׃ÿךÞ“ָן־׀ֱאּֿÊין‎׃ט–ִÿזזזזזְז•זזזה׀צךסזזָזדְז׃צהָךזצצדזעָאוצמגזְגזזצצז‎צזדז׀בֳזזגוםְבךה׀װכדְװטגץמץגץזןהוּױםפךסמÝעֿם׀גÝגףךֿיצִןזװבס—ˆ‘ײדצבֽ—–ÿ•זךֹ’ֱ־׀ןױˆֽÿךבעזזזזוזגקˆצלÝזßעזןְדדצזװֲוזמאזֿ—ווז‏הפּׂ׀הֻו‏צהךזוז‏בוְצבְֱזזזזגהזזבֻזזמזוְצהוÊִזוצעדÿ׀זדזÞ‏דףו׃כװזßצנגזֽזזצאוצ‏גוÿ“זזזזוזְזו‎צזהזז‏גזְ‎ֹזזעבז–זז׀ךׂז—׀ֵפזטעבֿזמ׀זגוְעאוזסזזזזזצמזזנעזזְזאוזמא‎׀זבוציֱזזךדםְיךא—זֽזזצאוצ‏גוÿ“זזזזוזְזו‎צזהזז‏גזְ‎ֹזזעבז–זז׀ךׂז—ß‎נסֻזה־ך־גÞע־גץזןהוװױגÞגסמצִ•ךÝמנבץצאו־ך־ם־‏–ךß‏נךÝמ–יה‏ֽמְ‏ןם“װוׁ‘ßבגעֿמ׃בֽנסצּבֹףזףצß‎ףװ‘לÝזס׳׀ךס׳‏ךְֵ”׳םֱ—“ֶ—‏ּן•——טֿעצלצזהזגÿˆצכןזÞִזב׀זֽזכץזהֿעווזךֱזצעגזּ׳כװז׳צנגזֳזזגזזְךוזÊִאזצךזוזעדואִןזצעבזבזזזזÊזג׀ֵפזךעבֿזןצזוזזמדזצםֹוְגדזזצבז׀ץֹו׀גבוצוֱזזזזכְוךא—ׂ׀דֻו‏צו—זזצזהז׀גה‎׀‏וז׀זגוצךג‎׀ִווצעזÿ׀זזזה‏זףו׃זןצזוזזמדזצםֹוְגדזזצבז׀ץֹו׀גבוצוֱזזזזכְוךנסֻ‎צוצ‏אזזזאהך‏מֿ—ֵזוִזב־גÊםצְמבÞװזבֿעעוְ‏ֽמ־‏–יףצ•יֽךÝבפך־וְ‏ןיֽךהיֽע—מÞמאוßעעבֽךהצ“ץצֽ–Êס׃‏דעְפךכףÊידגֳָבד–׃םֽװקטדּהד“’ףֹ–ןָלצÞֹך‎ֶױץ׳כץּדֽֽׂÿָֿףלד—’זזזוזדךזזזל—זßעזוְזֳצוָאזצגהזעָזזְזוזזמו‎צזזזה‏זףוגץגזךמבÞװֿמ׀גֿיפגסזנֲׁזעׁנ׀לוזÊÞ׳ֳצזזז׀וןˆˆעה׃צךֿזוִזמְזׂזכה•ב׀װהוזמופּׂ׀הֻו‏צו—זזצ‏וז׀מוז•ִזזְזגוצמג‎׀ִווצעזÿ׀זזזה‏זףו׃כװזßצנגזֳזזגאזצךהזציֹזזמזוזעהואִןזצעבזבזזזזׂזג׀ֵפזטעבֿזןצזווְגדזְגד‎׀זהזזצבזְץֹו׀גבוצוֱזזזזםְוךא—זֳזזגאזצךהזציֹזזמזוזעהואִןזצעבזבזזזזׂזגß‎נסֻזבהךֽאוְֽכ־ך