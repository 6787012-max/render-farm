כםזזזזזצהקˆÊזגהְפֶזועזכ—זװו׀גהזצ“וז׀מהפְזהזזךזזְיֹוזגוזצסֳזזעבב—װזזזז‎זג׀ץבֿגנגץזאוßָױזפךץמצ‏אבץענבֽךסמ־‏ֹםÞ‏•יÞך–מצצל׃ˆ’װמהְÿפֽßְּֽדזֽצ׃ֽ׀יˆÊזב׳ףֲׂע“ְלהלזֳםװסּßּהסזזזזזזגזֽׁˆװוגגÊְז־זגיזצזוזְגנזצךהז׀גזז׀מווְזגפְזהזזךזזְיֹוזגוזצסֳזזעבב—װזזזזאÿ׀ִווְ‏ֳוּ׀זזזז־זהגץבֿגנגÞעמוßָױוה‏ֹיß‏נךÝ‏•יץגֿוְ‏סבץ‏נךßע־ם־ִֹיד‏”מÝעֿגץצאו־ךוך’ֱםב־–פלפÞˆ־ְְםß‎לקןÞטץ׀צÝכמד׀‏כֹÊץצ־מ‏װֵא׀ל־ֻ׀םאי‘ֻענְָמָו—ÊÊאÿוק’ÿפלֵֵֿ׀זזזצזˆÊזגןזפֶזז“זא—ז‏ה׀גזזצבלזְגוזץֳכזזזזאצוךגֿצעז׀ִÿל׀גנבֿעץמßג—ם׀גÝזצגÝזצכםןֿׁׂםׁ“ט—צג“זצֱץˆ׳עו־׃ֻצֱ—”ז׃׳קטזכ‎ˆ־ךו”ֱ•דזזזוזדװזזזצִוםָזהְזֻצהממזצגהזצגזזצםלז׀גהזֳֿכזזגוזב“זזזז‏זג׀פגץגפוזִ‏ל׀גובפג–מצגÝזצגÝזױךויˆÞ‏זֹֹציגוטְגב—צמֱˆֽְֲֻצגˆ־‏ו•ְזזזזמזװˆ’ְוגצגÊְזיזוִזל—זָזזגוזֻ—זזְמÿפ׀זזזזיֱזזךדאגװזוזצבÿצזבוץּבףוצעבוגעגז‏ןא־װֻקְמ–גפג–מץגעוְ‏ןזףצ•יÝךאוֿעץמ׀םו‏’ץפˆפּדּÿˆ׳Êˆ‘םאßÊ‏דצׂ—ְּיפֻנ‏המ’ÿףםק‎ֳ׀ךוֻׂ׳ָיפ–ׂעֱÞֵזזזזזצזזזזדסזפֶזז׀זאעזנזזזזזס—זזצגÿפ׀זהזְֿהףוצֿמְךןבÞװויה‏ֽמףעֿךֿ‏נבץגֽז׳׃ß‏ׁ’—ז‎ם’װב•’זÝ‎ְֵ’ס‏׳ֹף•זזזזזמז׃ֱˆּוֶעגÊְזףזו—זכעזײזזגזוץגוזְזהפְזבוצבֳוזךהזצגÿפ׀זזזזםֱזזמהןצםךבוצףםוצ־וְִֶלÞענבֽךÞיֽ‏–גףךץבז‏גמÞמּםßגÝזד‏–גףךץבז‏ןם׀ב׳‏יץְּטלה׃כק—כÞפˆװÞכ׃זבזםױעÞיםױץלפ’ףײÿ׀הײק–ן׳ׂסÞץעךגכׁÝפ־סװהפׁ”ÿ‎׳ִ–וְזזזזזוזזֹˆְץֹוםָזן׀וׁפזßעבֿזהֿךוז׀גופֿמוזגִֵצזָףזצךוגְגהזזםלנעׂ׀ךסו‏צוְגזצגווס—אזצעבב—װזז׀ךזÿ׀מוזזז‏זג׀ֵצו׀גזצגווס—אזצעבב—װזזזז‏פ׀זדז׀םֱזזמהאזםךנעזטזזזזן׀זֲב־ךÊמßךןוßּױזו‏סגפךדיה‏ֽמ׀‏אבץגעו־ך־םÝענךÝמ•יץג—יִֽֽיפגדְטֲ’ז‏טפ׳ÞגֹÊ׳ךױפהזֻס—׀ל׃—הםצפֶ”ףלצכ־Ê‏ָ•ײסֹִ‘לָה‎עגנÊגוֳבׂ–י׳ÿˆˆ׀ז”ˆ׃גיזפֶזהמוÝÝִזזהךז”צםױזזזזמְדֳזזזוז׀ןהˆß׀זזזזױצהְבזצמזוְזהוֹ“זוְזןוְֳֿז׀גזזזבֳוזגוזץִזףוגץגץגץגץגץהזִֹל׀זזזצזˆּגדצפֶזו‏זכגז׳גְְהזצמןזצזוזָּגז׀מהזֳֿכזזגוזאזזזזזֳזג׀זזזזנזו‏ףגÞצבוßִױזצךטז־ך־םÝִנבÞ‏ֹזÝךףבֿ‏ÿיֽ‏”ג׀צימ׀־ה’‎ׂ‘‘פ•‘ֻ–גֵ׀ײדץ“נֵÿָןמְפֶˆףנְ“ֹץÿ־—ּבנÿּדנˆÞֵקִֻּןײ־בז׃ךזזזזזזצה‏זזזא׃זפֶזוזזן—זִדְװדז׀זהזעָדזצמהב—װוזצזזאזוךגֿצסגצצןאהװוזפגווְ‏סגפךץידִֹך׀גוך׀ףÝזֶןˆזקßםםפנ—׳ׂ”“ז׃—וֳזוֱˆ‘וז•“ֻאקßזםהˆ‏דֵˆנזהָזזזזזזוזד׀זזזעדוםָזו׀ז׳צה‏וזצגהזְגזזצםלזזגוזֻ—דזצמהב—װזזזז‏זג׀זזזזןזזִץג׀צןב־װובצִץמßגֿיצעדױֹ“זפֶ־ßֵו׀צבֻצזזזזמזֻזזזוִִגÊְזךזוִזמעזֲגצגהזזבלזזזזזס—זזצגÿפ׀ךוזְמ‏זּ׀ֶבהג־וזִ‏ל׀ג—ם־ךֿיפגÞבֿ‏סגפךויד‏”יßִאוֿעץמ׀עיִאןנצטױֲױוֳׁׂׂןבֿאÊהז—ץ׃׀ך•‏אסנל‎—ˆיְוֽג’׃ךוְםךָ‎םˆֹװזזצוץˆ“ב‎ְפֶזוגזכ—זװז׀גזזצמוז׀זהפְזוזצםֳזזמהב—װזזזזדÿ׀צוז׀ךֳז—׀זזזזץזוזץגÞעבוßִױוהצֹיß‏גךÞזּיßגֿיפגץוְצֿז־ÝÞֶצְִָגÊִצגאזצזו‏ג׀ןÊֱ‘ׁמ־צֻֽפזֿױֶָהי‎ÿיֱֱ‘זזזזזצוףזזזבק׀ÿֳזזְזםעז־זזגוז׀בלזזמדזָךזזצגדÿצזדזßֳכזזזזאזוךגץגץגצצןאהװוזפךומץגÝגפגבקˆ•‏ß׀םכˆ־’ודךגםֱֵׁוזעו•ק‘זזזזזְוÞזזזאףְפֶזזךזו׀זֻצהמזזְמזÿצזזזוֳכוזגדז׀בֳזזגואזבךוזצגו׀צןגֿגצוצִÿלßךֿגפגֻגפגץְִÿִ־צבמˆׂנוםױ‎׳‏דֵˆÞץזזזוזד׀זזזעהוםָזדזז‎צו‏זזזזוÿצזוזץֳכזזמהאזםךבהג־ז׀ִÿל׀ג—ם־ךֿיפגÞבֿ‏סגפךגפÿו־ˆךעדק”ײ׀ÿֵּדיÊוֻׁס־ÊֳקÝ‏זזזזזצזםˆˆ‏אצ׀פֶזוזֵ—ׂ׀ךסו‏צזָףזצךוזעָפזצוןא—זלג׀גדזץמוזְזהפֻֻכװדבצנגז‏וזגוזצסֳוְגבוץֳכזזךדזבהזצזזאזוךא—זִוזגוזצסֳוְגבוץֳכזזזזאגװזז׀ךהÿ׀זהזְֿהףבֻזדְזזזוזןֿ‏ֽם־ךףו׀ִ‎ל׀זנבץגֽזÝצÊמÞגאוֿעץבז‏ֽמ־ִ–בֽךÞיֽעץיד‏”מÝעֿוס”Êׂצאדּׁ–מפֲֶּÞ׃ממהסÿףÝזײ”צצהוםױֱ’ק—׳זׂל‎־ֶֽ׳נֱ’Ýָײְםֻצץֶ‏צב—נע•ֻצזזזקˆˆזכÿˆ’זנֻוִצזמ׀ןקזכעזזזז־זט—זזזגהזִָסזזזצדָוזצזבגְגהזזםלזז‏מזצִווְֳֹזזעבזס—גז׀מוזץֳכזזזזזֻזזְמֳזּ׀ֱןßײןÞֻּבוצףםוצֽהצִÊל׀זזזקˆˆזכÿˆ’זנֻוִצזמ׀ןקזכעזזזז־זט—זזזגהזִװֶזזזצדָוזצזבגְגהזזםלזז‏מזצִווְֳֹזזעבזס—גז׀מוזץֳכזזזזזֻזזְמֳזּ׀ֱןßײןÞֻּבוצףםוצֽהצִÊל׀זזזקˆˆזכÿˆ’זנֻוִצזמ׀ןקזכעזזזז־זט—זזזזֹזְִהˆְזגזצמוÞֿעזזג’זפ׀גוזזעפזצמזזָּזהזװוהצגמהנִזוְָוו׀עאו•ִזוצעוÿצצדזְגוב—װזזזזהÿ׀זהזֿ—הףהװױןßױי־װ–ךפֱלֿ׳םץצעגÞצעמ׀׀ןם־װזזקˆˆזכÿˆ’זנֻוִצזמ׀ןקזכעזזזז־זט—זזזזֹזְִהˆְזגזצמוÞßָזזג’זפ׀גוזזעפזצמזזָּזהזװוהצגמהנִזוְָוו׀עאו•ִזוצעוÿצצדזְגוב—װזזזזהÿ׀זהזֿ—הףהװױןßױי־װ–ךפֱלֿ׳םץצעגÞצעמ׀׀ןם־װזזקˆˆזםֽ”׀ףהוםָזמ׀ןקזםְזזזז־זיצזזזגהזִםפזזזָצהעקדזצדזזמופְזגזזעגונגדזצמהב—װוזצזזאזוךגץגפבץצפוְִֻלˆˆˆזםֽ‘צףהוםָזמ׀ןקזםְזזזז־זיצזזזגהזִץפזזוֻצז׀קדזצדזזמעזצִגזּ׳כװז׃צנגזֳהזגןוזצןֵ׀זבוְגגו׀עג‎צךוזְמÿפ׀גוזזז‏זג׀ֵצו׀מזצִגו“צזוצ‏ווזִבואעדזצמהב—װוזצזזאזוךנעזצגֿמפלומֹגץג‎גֿעעגְּןם־װזזזדˆˆ׀ה‏זזזג׀ְפֶזהךוÝ׀ה‏זזזזמְדעזזזוו׀ןמזצׁֿ׀זׁצה׀קדזצדוזמופְזגוְגבזזצב‎׀ךוזְמÿפ׀גוזזז‏זג׀פגֿמֳגֿ׀ֻגֿעעגְִןםהװזזזדˆˆ׀זזזזגוצפֶזהמוÝÝ—זזהמז–צזזזצ‏וÞגגגזדֻזיֿזוזצעוזצזוזָּזוז‏ווצגגונִזזְמדÿצזדזßֳכזזגוזב—זזזז‏זג׀ץגץגִגץװָמפךץגְִןםהװזˆˆזבקˆ“זװִגÊְז־זִעזזז־זי‏זזזגאזִ־יוזוזצד—פהזךדזז‏ופְזבהזגאזזעא‎׀זוזצםֳזזמהב—װזזזזדÿ׀ִגזְךדאזיךאוְוזץְֽאהמֲןזגÿזץ‏עגץךּהצִֽל׀זזˆˆזקזזזזװגÊְז־זִזזז־זיִזזזגאזְִאוזזÞצהזוזִווצגגונִהזצזזז–—אזצךדב—װזזצג‏זע׀םהצגוהץצםג׀יזצְוהוגץגְְןמ־ׁˆˆ׀העזזזגןזפֶזהךוÝ׀העזזזזמְד‏זזזוו׀ןמזץָזוזוֶפזסעבֿזןְִווְמדוִֻזזזזוÿצזוזץֳכוצגדז׀םֳוזגהזְֿהףו׃זן׀זבו׀גאזְעא‎׀זזזזבֳזזגוב—װזז׀ךהÿצצוזְמ‏זּß‎צזÿבßִ־בÞגֻבוצףמפךמוÞעױˆˆˆˆצזזזִֶגÊְז־זִזזזז־זיּזזזגןזִֽˆה׀זגזהֻזםְזדוצגגזְךג‎׀זזזזבֳזזגוב—װזזְמ‏זּ׀ןו׀ִפוßגֻגץגץוְִֽל׀זזזקˆˆזג׀זזזלמוםָזמְןקףזזזמְדֶזזזוו׀ןמזקּזוזזׁצה׀הזצגזזעָזז׀עווזמדואִזזצגזÿצזזזוֳכזזמהאזםךהצּםבזּףםץגץג׀‏ןמÞװזˆˆז׃ֱˆײואגג׳צזֽזִז׃צזזזהמז”זזזזצִוÞזבקזזצזִ—זלבְגהזועווצמהפּׂ׀כסו‏צהזזוצְווְגבוÊִזזְמזÿ׀ךוזזזÿפ׀זוזצץֱו׀גגוו—גףו׃זםזזבהזגאזצעא‎׀זזזוֳכזזמהז–זז׀ךÿפ׀זוזצץֱו׀גגוו—גףבֻזבפךֽזצגֽכ־ך׃לפִומְגֿםה‏ּבצּןמÞװזזזדˆˆ׀זיזְּוÞצפֶזהךוÝ׀זיזְּזמְדֳזזזוו׀ןמˆßז׀זז׳צה‏זזְצהֿזזדוצגגזְךג‎׀זזזזבֳזזגוב׀וךו׀ִןגְִץםץגץגצ‏ןמÞװזˆˆזצֱ’ְז—מגÊְז־זִוזזז־זי“זזזגאזְִיוזז׳צה‏זז׀עווזמדואִזזזזוÿצזוזץֳכזזמהאצםךו׀ִןגְִץםץגץגצ‏ןמÞװזˆˆזעֱˆׁז’ְגÊְז־זִץזזז־זיזזזגאזִִֿוזוזצד—דזצזבזְגדזזםלזזצןזצעזוזסֹזזגוזֻ—זזְמÿפ׀זזזזיֱוְגדזß—דףוגץזצגץןוגֵבßעוגזגקגץךּהזִ־ל׀זזˆˆזע׀זזזמאזזז־זִףזזז־זטזזזזגאזִֽ‘עזז–צדמוזצגדזעָזזְךהְ׀זגוְגבזזצב‎׀זוזציֳזזךדב—װזזזז‏זג׀להְָסהֿצֻגץגץגְִןםהװזˆˆזֿזזזוןװגװזזֽזִזֿזזזזהמז“ְזזזצִוÞזב—זזצזקגז’ה׀גדזזָאזְעדזָּזוצִווְמבוÊִזז׀ךזÿ׀זזזוßכזזמהזס—גזצגואזבךןßֱלֿ׳םץךֽגץך׃הזִֻל׀זזˆˆזקקˆװזֽגגÊְז־זִזזז־זטצזזזגןזִֽˆִזזגזגוזקצךוזזעהזצךזזָּזוזִווצזגונִזזצגהÿצזהזֳֿכזזזזז–אזצךדןציךגץגוזץגִגץװÿבצגצזצץגÞצמוÞמױˆˆז‎ˆˆײומ“גװזז־זִֹזזז־זטעזזזגןזְִו‏זזגזםבכװהםצנגזלד׀גזזצ“ווצזהפֿ׃זהְוז׀גטזצעזזּ׳‎פז־עבֿזמצזבהצגאוזעא‎׀ךוזזזוÿ׀זוזץßכהזגגוזםֱו׀גהזֿ—הףו׃זלזזזז׀עדזזסזזעםזצ‏גוצ‎ֹזזךדזסזזצגִפ׀ְווזצהÿ׀ִוזְמֳזּß‎צוװׂכֿ׀ִזצגׂטפ““ידמִכץ׀װםפךוא׀גֶםהװלוÞגױזזזזˆˆזֽˆ’ְוזָגÊְזֽזִזֽ׀זזזהמז’׀זזזצִוÞזגװזכ‏זק—זהזגהו׀וז׀מהפְזאהזגןזְ‏ן‎׀זהזזךזזְיֹוזגוזצסֳזזעבב—װזזזז‎זג׀ÿבßִ־בÞגֻגץ‏ץבֿגץהצִÊל׀זזזקˆˆזמˆזץקוםָזמ׀ןקזמ“זזזז־זטְזזזגןזְִוףצדהזבץזעץזוזְְÿזצךהוזגזז׀ךווְזגפְזןהְגמזְִמ‎׀זהזזךזזְיֹוזגוזצסֳזזעבב—װזזזזאÿ׀ּווְ‏ֳוּ׀ּםזגוםהּכ־ָָזפךומֿגנגץ‏ףםְװןםפװזזזזהזדװזזזצִוםָזהְזנזהזכזְווצמוזצזוזָּזוצזגזצעג‎׀ךוזְמÿפ׀זוזצוֲזזזזאזוךםהמפגץגפוְִֶל׀גובפג–מצגÝזצגÝזז‏ֽמ־‏–יד‏Ýךֿ‏סזױךויˆÞ‏זֹֹציגוטְגב—ֱ––כפמֿכפ—ֿמ־—הןˆ“ˆÿ׳‏גוק“ÊזֳױױÞָװןֿײלֿזזזדˆˆ׀הÝˆÊזגץזפֶזהךוÝ׀הÝזזזזמְדױזזזוו׀ןמזעמזוזו׃פזÊעבֿזם׀ְוו׀זגו–ִזזצגהÿצזהזֳֿכזזזזז–זז׀ך‏פ׀‏ווזצבÿצזבוץּבףו׃זלזזאהזגןזז‏ן‎׀זוזצםֳזזמהב—װזזזזדÿ׀זדזßֿכזזצגוס—זוצע‎ועß‎צוז‎אץּּאפךֻבוצעגץצץהצִÊל׀דˆˆ׀זזזזדסזפֶזהמוÝÝ׀זזהמזזזזזצ‏וÞוּגזהֻזםְזדוצגגזְךג‎׀זזזזבֳזזגוב—װזזְמ‏זּ׀טדְ“‎דְֻֿבהגֽוְִֽל׀דˆˆ׀ה–ˆצב׳צפֶזהךוÝ׀ה–זזזזמְד׃זזזוו׀ןמזׁ“זוזזצדָוזצזבגְגהזזםלזז‏מזצִבוְֳֹזזעבזס—גז׀מוזץֳכזזזזזֻזזְמֳזּ׀ֱןßײןÞֻּבוצףםוצֽהצִÊל׀דˆˆ׀זםˆˆ‏ג‎׀פֶזהמוÝ׀ּזזהמזְזזזצִוÞזבׁזזצז־עׂ׀ךסו‏צזָעזצךןזעָףזצוןא—זלבזגדוßךוזְזהפֻֻכװדבצנגזֿזז‏םזצִדוְֳֹוזגוזצסֳהזגבוץֳכזזךדזבהזצזזאזוךא—זֻזז‏םזצִדוְֳֹוזגוזצסֳהזגבוץֳכזזזזאגװזז׀ךהÿ׀זהזְֿהףבֻזב־גֿזצגֿכהגױםÞעומזגֱב־ךÊמßצלוÞצױזזזזˆˆז‎זזזזִֶבßזז־זִּזזז־זיּזזזגהזִעדזזז׳צה‏זז׀עווזגדואִזזזזוÿצזוזץֳכזזמהאזםךו׀ִןגְִץםץגץגצ‏ןמÞװזˆˆזקצזזוזעבׂזז־זִזזז־זיעזזזגהזִּזזזזÝצדזצזצגהזצגזזצםלזזצזוצךגונעזזְמדÿצזדזßֳכזזגוזב—זזזז‏זג׀ץבהגֽגץמאוÞעױזזזזˆˆזעֱˆׁז’ְבׂזז־זִץזזז־זיזזזגהזִֹ‘זזזצדְדזצזוזְגדזזםלזזצזוצמגונעזזצגהÿצזהזֳֿכזזזזז–אזצךדןציךזצגעגßמץזץזודßגףםזִןמ־װזזזדˆˆ׀הטˆ׀גף׀נ“זהךוÝ׀הטזזזזמְדָזזזוז׀ןםזלגזזזוקצג׀צזצמוב׀גדזְצוזזךדזצ‏זוגָזו׀זמוצִמ‎צזהזזךזזְיֹוזגוזצסֳזזעבב—װזזזזאÿ׀ּווְ‏ֳוּ׀וזפִÊםפצומ׀ג־גץ‏ץבֿךÊהְִֻל׀זזזזזוזוףˆזכןוםָזבְז׃צהָץו׀מדזזגופְזהזזגזזְבֻזזזזז–בוזמדזÞ‏דףזזזזו‏זבץצץגÞךאהוְױב־ִ–בֽך•יִֽץמףעֿגץצÿגÞךדמ׀“המÞךקאßצ׃וֹְןוג–לׁץצִךֵײ׃ּהזטױוזפְֹ׀מ–ֱֻ•ְÿסֱְֲבלנ‎ßֳזזזזזצולזזזד‏ְפֶזז׀זב—זעזזגזזזמוזאעזזְמÊזּ׀עמפמדהוִױזףצÊמÞג–מףמנבֿעץמ׀לִָאכֳזאץֲױוְֳׂך•‏אסנל‎—ˆיְזזצולזזזד‏ְפֶזז׀זב—זעזזגזזזמוזאעזזְמÊזּ׀עמפמדהוִױזףצÊמÞג–מףמנבֿעץמ׀לִָאכֳזאץֲױוְֳׂך•‏אסנל‎—ˆיְזזצולזזזד‏ְפֶזז׀זב—זעזזגזזזמוזאעזזְמÊזּ׀עמפמדהוִױזףצÊמÞג–מףמנבֿעץמ׀לִָאכֳזאץֲױוְֳׂך•‏אסנל‎—ˆיְזזצולזזזד‏ְפֶזז׀זב—זעזזגזזזמוזאעזזְמÊזּ׀עמפמדהוִױזףצÊמÞג–מףמנבֿעץמ׀לִָאכֳזאץֲױוְֳׂך•‏אסנל‎—ˆיְזזְוÝˆ׀גה׀ÿגזז—זא׀זֱצו׀זזְמוÿ׀זוזפ–כזזךדזבזזזזׂזג׀ֻםפעֿוזְ‏ל׀זהמÞמהגףעצגֽךÞגֿגסז־‏ֽמְ‏סגץצנךÝמ•יץגגהֱׁ”ׁד׃”דװׂ“ֲל־מÊךֿ“Êאזץֱ–צגװזסÿֱזסצוםקִˆײÝֱזֲף–טˆ’ֲˆֱ”ֱגוא׀זזזז