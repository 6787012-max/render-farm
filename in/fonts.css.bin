ˆˆזאדˆזץִוֿ“זמְןק‏זזזמְהÝזזזוו׀א–זמִזןְז’צד‏ֻזצצאזעָזוְצאְ׀עןזְצוומךזזצזהז׀גהֶזזדז׀וֱזזזזכְוךםהךײלפִÊמÞװּלÞִÊםÞךמההךױזזזזˆˆז‏קˆ׀וב׀ב’זז־זִְזזז־זכךזזזגןזֵ‏זׂזזֲזד׳זי׀זוזזמדזצםֹוְגגוזסֱהצִמז׀עבם—װזז׀ךזÿ׀זזזה“זףהׁמÞךׁט־’יףךֽכ־ך׃להִÊםÞךלההצױזזדˆˆ׀וְˆˆזגÿז‏ֲזהמוÝ•זזזהמזװ׀זזזצִוװזץ׀זו“זכ—זװזזצבומךאזצעוו‏ךזזצזהז׀גה‎׀זדז׀וְזזזזכְוךמÞךֽם־ךÊבפִÊםÞךןההצױזזזדזאדˆßְץִוכִזאצזֽזה׀ז‏ּזףבְגגז־ִÊןוװ‎וצעגדזּהזזעדפּׂ׀בבו‏צוּזזצזוֿזךוזְזגוצמג‎׀זבוצוֱזזזזכְוךא—זֳזזךהז“ךזזצזוֿזזהזזצבזְץֹזזעבזבזזזזׂזגß‎צזּ׳םץמָג־‏אהוָױזו‏סבץצאו־ך־ם׀ִֽיÞ‏Êיףע—יֽ‏Ýךִֿ”ך׀ִזב׀גÊמÞמאוֿעסםףצֹזץ‏Ýךֽ‏–ווֿגֱֶׂ‎Êÿסלֻ“ובפ“דֹֻײי“ץ‎‎ˆעמזִֿיִ•טפף׀ללךˆ“ףאֲֵײצט—Ýֹ’גױֱמץֹהˆפלהץל”ˆ־ע–ֱֹׂ•א‎׀לײקב“ְּ‎אֻנףנÝÿסßׁˆˆזאדˆזץִוְָזמְןק‏זזזמְהÝזזזוו׀אÞוןעזמְהױ׃ד“זְֳמפזֽעבֿזלזזוזזמדזצםֹזזעבו–זו׀ִֹפ׀‏ווזצמÿ׀זמההסכזזךדזבזזזזׂזג׀ֵפזװעבֿזכ׀זאוזגגוְבזזגזזְךוזÊִזוצעןÿ׀זןוÞֳכזזצגהבזהזְֻפ׀זדז׀וֱזזזזכְוךא—זױזז‏גזצצאזÿ“זו׀זבוזִב‎׀זמזזצאהזץֹזזגזזְךוזÊִזז׀ךזÿ׀זזזה“זףבֻ‎צז׀ּמßמּם־ִÊםÞךםההְױזזזהזמָזזזצִומ—זדזזנזה’זל׀עוזְזדוזמד‎צ‏ווזזזזצצז‎צזוזפ‏וףז—יזזזיבְ—סבומזדזזכגפ‏ןהו‏ױזו‏נבץצאו־ךֿגפךץמץמ•יףצÊם־ךֿגפגה‘װֻ׳ֶך־טˆֲׂזֳפגֱÝֳ—נקֹזץּגֽס•Êֵןהֿסׁ’םומ”׀נֱקאמˆְֻזזזמז־ְזזזְגֽצזטזוְזיגזßוְגדזזצבז׀ץֻו׀גבזזזווצוֻזזמהזס—זזצגÊזע׀קד׀זזדßְקבß‏עזז“זדץגץםְְמבÞװזבֿ‏סבז‏אמÞךסמßגÝבףךפיֽע—ם־‏ֽמßגÝזֵָםֶנֽמֽױנׂנגֱÝֳ—נכנ–זיֲ׳Ê׃׀ֵָֻװומ”לˆִבׁÿÝß־טˆ’‎זזמזנֱ–ובּגֹצזסזהעזם—זּבזגזזְבלבצגזץ׀זוזזךהזציֹזזמהזבזזזזׂזג׀ֻלÞִ־וזְ‏ל׀עֻו־ך־םְמ–יףצ•יֽךÞבֿמסבץצאוßִזבֿ‏Ýךֽ‏–יףצÊמÞמאוֿעסזׁֽֿגֻׂ־הְֲֲנÊֲֳˆִאֱֶˆכ׳צּ•טֵײֵֶׂ‏’םקÞְי־זגזױגפ׃ˆ“Êמˆ׀ה׃ץלק–ץ‘מוˆְֻ–ִ‎אßיסֱׂמםאזזמז־ְזזוה‏גֽצזטזוְזלעזÊדְגווזבלזזךזוצצדונעזוזזוזזצו‎צמוזזזÊזג׀ֻם־גץגפזאהוָױםץעֽזפגץמßגֿךֿ‏סבז‏ןםףךÞיֽ‏–יה‏ֽמ׀צÊÞקˆׂׂזֶױס‘ן׳׀ˆֽ—עֹמ’ְמכׁהְָו׀ׁ“ומ•“ײ”לֿלÊװ—ÿד׃־ִצזוזגקˆזקֲום—זל׀זׂצהװזזצמגזְגגְֱזגוצמגוÿ׀זזזזהזצזה‎׀זבוציֱזזךדכְיךמֿךװמֿךֻוְְֶל׀זÊיףצ•יֽךÞבֿ‏סמÝצÊמÞמאבץצנבִֿנבֿעעוְ‏ֽמ־‏ÊיףךעבֽךÞיֽע—ם־‏ֹזעף‎ִֵנו־ך׳ױׂ“פזֲן“‘ֱ•ÝםÞÊמֿןֳׁ־ֵÞְֹֽײגכ”סױז־Þֹ־ֻ•ץעֻ־‏ֻ–׀ÿע׀ׂץףְֵך‘‘כ‏מיע‘ס–ֵÊ׳ֶפÝץמטץָזזצהלˆװדְפֳזהךזְגׂ׀ב–ו‏צוגֽמֿצףוזמדהצגוזְְוזזגדפֿ׃זגפך־בוךגזְךםזצגההזגגזצילנעׂ׀ב–ו‏צו׀זזְךוז׀מוְֱזבזזךהוציֹזזגוזבגזצזזכְוךא—זְזזמדזצךהזÿ“זוצזדזְעד‎׀זגוה‎כזזגוזבזזזזׂזגß‎צזּֽג־צּמÞעאהוָױזו‏סבז‏אמÞמֹיß‏Ýךֽ‏–יה‏ֽמÝעףם־‏ֽמֿגץמßג•יֽךÞבִֿוז—א’‎כי–ֲאִ–עִֻֿֿמֶמסט׀ּעÝֽנְׂןאÞÿֹונֱׁזָ־־ÿֶײנףטÿך”׃ּ‏בֲמזפְִמˆָˆץגהֳֵנ‏סֵ׃׀זזזצז׳זזזדˆצפיזזְזאעזנזזךהזצזוז׀וֻזזגוםְבךמץגץגזצמאהװומץגֽגפג–מפגדˆֱ’Þׁׂ’—זּ‏וְֽק•ˆזָד׳ִזזזזוזןףˆזצכומ—זג׀זֵצוְדזצגהז‏ךזזְמזÿ׀זזזה“זףוךֽבהךגהוְױזץצאו־ך־ם־‏–גףךץבו‏Ýךֽ‏–גףךגה”ׁץְמÿצֳױÊפְמהץׂ׀אוְֵץִננוז׀Ýן’ֱÿ“דדזזזזקˆˆזןףˆזצכוֿ“זמְןקֳזזזמְדוזזזוו׀אßוןעזןְז׃צהָאזצעגו‏ךזוזגגְ׀ךוזצמוְ׀זהזְוֱזזזזכְוךבץעסאוע‏גֿךֽבהצןההצױזזזזˆˆזֳקˆ׀וזװאןְז־זִ—זזז־זךגזזזגאזֵסֹןְז”צדצÿזצצאזעָזוְצאְ׀עןזְצוומךדזצגהז‏ךזזְמז‏זזזזה“זףו‏סןוװ‎אועֳבֿ—ףמßצּהזְֽל׀זזזקˆˆזןףˆזצכוֲצזמְןקֳזזזמְדוזזזוו׀א•זםּזןְזצדְדזצגגזְצוזֹ“אזצצגוסםו׀ְדוצעֹפ׀זהזְוֱזזזזכְוךמפגסבפגװמפװֹםץעְבץֻגÞךעםזָמםהװזˆˆזֳקˆ׀וזװאןְז־זִ—זזז־זךגזזזגןזֵזגעצזֲזה–זלְזגוצפדוְגבזצנדז׀גוזְאדזזמהזבזזזזׂזג׀סבץע‏בץְפגÞךעםזִמםהװזזזזזזצזעזזזגסצפיזזּזמעזֲו׀גזזצבלז׀מהזצזוְ׀זזזה‏זףזזזזזּזהץגֿוזְנל׀גומÞךוך׀גÿי׀גגסֱ“”ֽÞדיּוקץװ‎זףגֱֽ׃Ýומ”ֻֻ’ִז•׀זזצזßזזזבצפיזועזם—זּג׀—גז׀זהזעָבוזךדזְזהְ׀גוזזזÊזג׀זזזזסזועּגפצֿוְְ‏ל׀גומÞךוםßעומÞךוךßךÿיßךÝךßךÿיßךבֱנְהˆזןÿ׀ˆ׃ֲ’ßְװט“מֻ׀—ךßצפי”ךדְֻךדˆאָגֱֽÞֶףף׀דֳˆÞאטֻזד‎זזזזזזוזהִזזזצÝומ—זה׀זְצו—כהזעהוזגזזעָדזצזזזס—הזצגוםְבךגֿמפגזצמאהװוך׀גומ׀גומ׀גוך׀גדץ׃ְֳא‎”ˆÿˆ׃ֳֹז‎ÿִ—וןזפיˆֵˆ׃זאˆּצהףזםוˆּ׀זזזזוזז“זזזצֳומ—זהזזֳצוָאז׀זדזזגופְמוזצזוְ׀זזזה‏זףומפגצךמבÞװוגפךץזףךוזףךהֵױנֳגויְג•—ְא‏ˆÊְוָ׀כײˆִגהק׀דˆˆ׀זטזזזגןצ‏ֲזהמוÝ׀“זזהמזÞצזזזצִוװצץכזו“זכ—זװו׀צוז׀זוזעָבזצצדומךזז׀גדְ׀מוזצזוְ׀זזזה‏זףזָלהְ—לדץמפגֿמאההךױזזזוזגְזזזקֿומ—זה׀ז׃צהָלזצגהוזגזז׀םלזזמזזצךהזנעגזצךדזב—זזזזÊזג׀זזזזכזזװֿג־גבהוִױםץעֿמÝעומףעֿךßעוזן׳ֽהÊֱ–ׁזÞ’כˆנֲנֹֻװדֲ’ֳ”ˆמזזזזזהזםךה׃זךצוִעזןְז׳זךוכװהץצנגזקבוךהזצמֿזצ‏בזְגזוְילא—זקבוךהזצמֿזצ‏בזְגגוְילנעׂ׀םבו‏צהזזזצזבוְגב‎׀זהזְיֱזזךדפעװמזצ‏אזבןוזמזזג‏זףו׃כװהֻצנגזֹו׀גגוְזאוזוזזגזוצ‏וונִזזְמדÿ׀זדז—ֻכהזגאוְוֱזזזזץְוךא—זּו׀גגוְזאוזוזזגזוצ‏וונִמזצ‏זזז‏ז‏׀זהזְיֱזזךדפצםךנסֻזבץֱזזזֱלץָםהמזןְזֲם־ךּםזּלאהװום־ִאו־ך־םֽע—יֽךÝיףצÊמÞמאבפִ—יֽ‏Ýךֿ‏סגץצÿםד‏”יפך־וֿעעבֽךהְֶ׀במ•ֳדֳָטױײא׀קּ‎יָּ•ךÿמפֵאׁינץ