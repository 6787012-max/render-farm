׀הֹץִָÊסֻכֹי׃‏”זם‎Ê–ִ־’Ýֵני׀הנ‎׳ֳÊעִׂ•–ִֽזֿÝֶÿְִׂ•–ִֽז׳Ý‎ÿ‎ֵֻ־’Ýֵני׀הÊס׳‎•ֿ—כֹי׃‏”זםֵÊֻׂ‎פ’Ýֵני׀ו”סֶׂףז׀צעצןֳנ’׳ךדסאך׀ֳ–ֵÊּ׀יע‏—ו”סֶׂףז–צּעןֳנ’׳ךֽז׀ץְֳ–ֵÊּÞךדובו”סֶׂףמ׀ךגצןֳנ’׳ךֽז׀צ׀ץבֳÿםׁדÊב׃ִאסÞִ•בׂ‎ה’Ýֵני׀ה•ץֵׁאßִֿ־’Ýֵני׀העס–ִÊִׂ•–ִֽז–ÝֳאסÞֵאֻׂ‎Þ’Ýֵני׀הןֵֻֻ־’Ýֵני׀ו”סֶׂע‎הךּֽם‎”םֳֿÊסֵֽ•–־הנבֳֽÿץֻ‏•׃‏ְֻ—ֶנßּ‎ניֵׁנמןֳנ’׳ךדסהךזֳ–ֵÊּ׀יעמßו”סֶׂףז–צֽמןֳנ’׳ךדסהך׀ֳ–ֵÊּ׀יעמ—ו”סֶׂףז–צֽעןֳנ’׳ךדסהיְֳ–ֵÊּ׀יעמ”ו”סֶׂףז–צÝִןֳנ’׳ךדסהטזֳ–ֵÊּ׀יעמ’ו”סֶׂףז–צּגןֳנ’׳ךדסהצְֳ–ֵÊּ׀יעםדו”סֶׂףז–צּ‏ןֳנ’׳ךדסדךצֳ–ֵÊּ׀יעךÞוÊßֵׁÊֳÝֳזםÝֳזִֽֿÊÝִ•םְִֿ׀ֳׂןץÊ‏ÿס—ֵ•ֿ׳ֵֹצזזצזוˆˆזד׀זזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזזףָוטְד—זקצגױ׀זזˆÊזמ‏ׁÞ־וךˆ‘ק’ְהאכְָגׂזפ“ז׀דÝוֵזזזזÿ•ודָזזק’ְהאכְָÿגˆ׀בְץטˆÝפ׀ֿ־ˆלמז—ְדפזלּזײצאװˆ׳ִמ‏ׁÞ־זֵֽֽזֿ־ˆלמז—ְדפזלּזײצנ׀ז׳װמ‏ׁÞ־וֵ׀הּזֿ־ˆלמזזכזזכהה׀זבס‏ץסְּמגׂ“זז’ץפזאע–׳‏װדצֵװהֿ‎‏א‏ְ־ֻס‏װזמֻ‏ֵּמזזְז‏•ךֽ‏ֿװֿמֵזזנֵזזצÞיגװְזוזגיְצ־•׀זפÞ׀מאוÊכֵזהכהוּמכדזעכזגםֻײÞלזגכצ—סֽץֵזאץסְֿװזךֻנסםֵנהגֽמץׂלנהה׀עבו‏מֵוזנץװְװדֿצנהא׀טבֻ‎מכגוה—יב‏—סֿ‎כזָעבְֿװצגכצ—סֽץפה׀ךבו‏מֵז׀נץװְװךוצנהוÊממײל‏פה׀הֻו‏‏וװְװהוצנהא׀הÊזֵמכז•עבְֿװד‎ְא•ו‎נסֵּװזמֻװז׳ד‏זזעֻ־׀זגׂ׀הֻו‏מֵזלצß׃כװו’צנהא׀ןּ׃ֿׂוזז‏זלצ•ט“וצו־נסֻּ‏סÊ׀זפ׃‎נפט׀זבו‏‎סֻ‎כֵזדכהובמכזגםנבּמכזבצ–ו‏װזעֽצױזאמ—מֵמפב‎װזבְכֵזגכהךֿמÞגְ‎כגב‏ּמְװז‏ֽצױזאץסְֵװצגכצ—סֽװצגכצזג‏גסֽװזךײמפה׀וּךְ־־הלװזגױװףזבםֵזגםֻב‏‏בזֵ‏סם‎נהי‎מסְּװגוףנכזולßװֿװגו‎מזזעבֻֿנפ•׀ופÞ׀ו—ךױװְזהזגיְצ־•׀ו־Þ׀וÞיהמÞה׀זהיה‏ֵזה‏Êֶ׀זנט׀זנה׀ופָ׃װזִװמהובמכזךצ•ט“וזו־מכזזעב־׀צאו‎‎ױזו‏•וגװזבְכֵזמככמןדזודץעמײמֵמזזצוד‏גמ׃װזּװװזודמ—פÞזזגזצ•והכֵזלכהזְץפה׀זפװֽװזודװזצֻ‏הוב־־יֿמאצְװהוצנהא׀זוׂ׀ךבו‏װהזֵװגו‎נפט׀זבו‏‎סÊ׀זÞעֽ‏עץגװזבְכֵזככהזְץפה׀זפװֽװזודװזצֻ‏הוב־־יֿמאפ׀םבו‏װזזֵװגו‎מזזעבֻֿנֵזדםפיֿץגפ׀זנז׃װז׀װמכזזמ—לÞה׀ָדץסְֿאÞךֿנפָֿכֵזיככגהזּנ׀‎אבגכֵזטככזו‏הזְװז–דפױזזעבְְװז—ֽצֻÊ׀דּילװזופנהה׀ד־יהנפ•׀דÞ׀ְװוו־‎ױזו‏Þה“וזוֽ־־יֿװזד‏ההל‏הה׀דÞיהמÞ•׀גהßכסב־ßואץגנפפ׀דנעֲֽה•׀גפßכעסֿכע–־ßואץגנץװֿנפפ׀ג•עֲֽה•׀ג־Þßזוודסס־ßגוודװזבֿצױזקל–Ê׀זגט׀ז־סהװצ—הםעלßדְמֻצױזוב־ךְװזךֻעב־ßזצוד‏כזגםעלל־־הלמ•א׀ד־ָֿמזו‏פהלמ•א׀ד־ָֿאגוזגיְװזמֻצױזהםנא׀ד־ָֿנֵזיצ—ֲ׀דּין‏כזה‏־ה׀זבו‏װגוְננֶ׀זנךְװזßד‏ְגזאמְװזוצנכוז‏בֻÊװזבֽ‏כגזזוךֽץכזוצזזקױמוזצבד‏גמ׃װוךװזכגזזּסענכזצמ—מְץֵזךמ—ל׀הÞט׀ואוהמאה׀זנא–גֿמוזזזצּלל‏כגפו־ׂ׀־פװֵמֻּ׃װוצװװצזףלÞ•׀בפÞßזץךױכֵזנככגהגÞװ׃װוִװװצךףלÞ•׀אהÞßווךױכֵז‎ככגבגÞװ׃װוָװװצ‏ףלÞ•׀אÞÞßוßךױכֵזִככגמגÞװ׃װו—װװצּףלÞ•׀לפ׀ֽמכזצ‏Êֶ׀זנט׀וÊוכסבְֽמה‘׀זס—ֵמפב‎כֵזײכהךְװוו־‎ױזו‏זנ‏ג׃ענהךְכױזוִץװֿמסּ׃װהװװמÞה׀גאםÊװזבֽװה‎ְפ–ץ‏מÞזׂװזבÞאÞגֿנפ•׀ן־׀זװז—ױװצזהץסץ‏װוזֽצ־ובװז׀ֽצױזכמזג‏גמְ‏כזו‏ֵעפגְגזד׀והצָ׳ְװץמאלהםלßװ־נפ•׀ןÞÞßזו“ױכֵזְככגון־װ׃װהגװװצמֲלÞ•׀מ־Þßזß“ױכֵזֽככגגן־װ׃װהצװװצעֲלÞ•׀םפÞßוֿ“ױכֵזÊככגןן־װ׃װהִװװצְֲלÞ•׀להÞßהץ“ױכֵזװכהזװזבְכֵז׃כהוְװוםְמגךֽװזבְצזהםנא׀זנה׀כהָֿכֵזׂככז׃לז׃ל־•׀כÞ׀ְמגְִמכזךצ•ט“וזו־מכזזעב־׀צאו‎‎ױזו‏•זֽ‏ףְֽממ׳סנהוןמהה׀דגיֽׂזצז‏־ה׀זבו‏װגוְננֶ׀זניְמ•ג“אÞב‎כֵז׀כזהßזזםבסב־׀זץֶ׀כÞײßוצגסץסְ׀נץװ־נפ•׀ךפ׀זװז—ױװצזהץסץ‏װזגנװהײװצעובעס‏ךבֵּמֻּ׃װדמװמדנ׀זנז׃װדךװזכזוץנט“וזו־מכזזעב־׀צאו‎‎ױזו‏זולזךצ•ט“וזו־מכזזעב־׀צאו‎‎ױזו‏זולזזבױצזזזזזזגצמÝ־ßךְגסל־ג׃װדצװמד׀ְץÞה׀דגיֽׂזצז‏־ה׀זבו‏װגוְננֶ׀זניְװזוד‏ףְ׃װדעװכִֿכֵז•כהזמגְִװזßד‏ְגזאמְװזוצנכוז‏בֻÊװזבֽ‏כזזצ•א׀זעיֽטה•׀יÞÞßזְזנםפזׂמגֲ׀זהיהװזמֻפ‏ײלץÞיןמ•גְנאמֵמסÊ׀זפיהװֽ‏וזץעעל־•׀טהÞ׀זוֶ׀גפיהװזצֻװזצֻץÞיןמ•אßהְוהװזֻדל•נלכ־ךְמדÞלטה•׀טפÞ׀זוֶ׀גפיהװזצֻװזצֻמה’ןמ—ִֽ‏פה׀והיהװצָזצױזםצÞװְװאוצנהה׀צבב‏װ׀מְזÞזֵװ׀מÊזß׳‎צּמֽמכזמצÞהלמ—ִֽץÞיֿמ—‎ְװזץדװזם־מכזזעב־׀צאו‎‎ױזו‏•זְװזגױממײל‏פה׀זּיְ‎הט׀ז—יֿ‎בו‏װזםד‏ץׂ׀ז—יְנֵזדםֵזה‏־ה׀זבו‏װגוְננֶ׀זניֿמÞזְװזצÊמ—‎ֿטוװֽװזֿדץױזהםֵזמצ—ִֽץÞיֿ‏הה׀וגט׀זÊמְװזוצנכוז‏בֻÊװזבֽ‏הךְװזגױמזגצ•ה׀זפׂ׀ופסֿװזעֻװזם־מכזזעב־׀צאו‎‎ױזו‏זגםÊגְװזצֻ‏אצֽװזךֻ‏אץצנהגֵמÞב‎מÞזְװזצÊמ—‎ֿטבּ׃װדָװװזזנװוגֽצ־זְמכזבם־זׂץÞיןמ•גֽקדְ׃װדװװװזזנװוגֽצ־ה׀ההיהמהזְץ־יןװזגױמ•ג“כֵזככזזבױזץמ—ל׀זÞנ׀ז־סןמ—ִֽ‏ֵזזסבְׂמד׀ֽמץׂ׀ז־נ׀ז־סןמ—ִֽ‏פה׀ופנ׀והסןמ—ִֽ‏ֵזאםֵזבםעÊ׀ז־סֿׂצְזהזוֽ‏Þךְנאמֵמסֻֽׂזצז‏־ה׀זבו‏װגוְננֶ׀זניְמÞ“ֽמהז־ְֽֽמסּ׃װד—װװזזנװוגֽצ־ה׀הגךְכִּֽץÞיֿמאה׀מאוÊװזם־מכזזעב־׀צאו‎‎ױזו‏ÞךְמדÞלטה•׀ק־׀ֽמה’אװזמֻץױזץצ–ֿצא–ם‎נהזנפ‘ßכְגעלÞ•׀קÞ׀ֽמה’אװזמֻץױזץצ–ֿפא–ו‎נהזנפ‘ßכְגעלÞ•׀צה׀ֽמה’אװזמֻץױזץצ–ֿצא–ם‎נהזנפךְכֶּ׀ז־סאװובדנבמֵעבֻ‏מדß‎כױגׂזץצױכֵווככז“לÞךְכֶּ׀ז־סאװובדנבזֵעֻֻ‏מדß‎כױגׂזץצױכֵוהככז’ל“ְָמדÞ׀והיה־ְֽֽמה’אװזמֻץױזץצ–ֿצא–ם‎נהזנפ‘ßכְגעלזגצÞ‘׀כ־װ׃װגךװװזזנװזצֻװזצÊמהזְץ־ין‏ֵזלמ—מׂץÞיןמ•א