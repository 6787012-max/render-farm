לו–הםהִִמו““פÊצם—ץף‏ג’טמפץזִבסקםÝ׳לאץ׀ׁסףßססÊ‏׃כוגץג׀׀־Êָּ׃זÿֳּלּװßצֿגֲמׁ‘Êץָמ’ע־ֿלזזזוזז“וץ׀הםזֹעזהצזק׃ְמןו—ָבזז—ױßודגזדג׀גßצןםÝ‏–יהִ”בָֻױגה“טט־גהבהײֽדֻ׳גךזֻםןצזזזצזטˆ‘ִז–זםױזוגזדױֳעזוגיפ׀—גדפװזלÝג׀ג׀‏ןוֿעעבß‏ÿבפמֹםֽע—יÝ‏Ý–דּ‎בß‏נט”גßמ־ךÞִצםעהג’לױֶבמףץצנְבֲמֿ–ׂדזזגזדׁָזיגהֶ׀זכזוץזדבצםהְ–עוזעיפְִזדפװזלÞװßךוךעו׀‏ֽיף‏ץגהך–ך׃גֽךÊ’ֶׁוו‏יְֶוִיזףּועֿצזזזגזדְדּזנזהנזוםזדßזמזִףמץ׳קעמ׃טע‏ֿס—מהעמ’טפגֿן–ִ‎ן׀—’וÞ–זג׀ִטלצצßזזױגךצצßודגלßדגגףּץגּֽץגּֽ’ךףזובז‏ֽמ־ִÊםßצנבץצאמÞמÊיףִ•י׀‏ןוְִאמÞמÊיףצˆזף‏”ם־ִׂזףע—יֽךÞבß‏ÿיהִÊםÝצÝךֿעעו׀‏ןיִֽ•ךÝמנבץצןוְִאוß‏ÝךְבְאßענמÞװילוװףבץ—ֶדְךֿןץךהדץצסאÞֻאבֿ‏ףאְ–ֿןועÿאהךֲדצ“יכÝגכא׀עֱךץגעגֿ—ֹמÞךנאפְ–ק׀בֵבץ“װיְְֱנ׀ִףאּֿעצהגֱגה׀ֳזְ“ֲבפצןהז‏להְִדו־ּסן־ךÝבו“ֻןÞזװכזּ‏ט־ִףץוךֱג־עמז׀מבדץִזזזגזדְגֲזָֿהףזזןזוץזדב‏זזְֻנזזִיפְךאדפװזלÞװßךזגֿיףך–ךßעÝזֿױיßף”צגֲע׃Ýִזזגזדׁװזימז־זזמזזׂ—הגװןזז—ױטצזßךדִעוÞִ•יÝ‏–יל—גדִףה•װֻ—ֿבּװױסץָזזצזטזץ“האְב׀זזךזג—זלזֻ‏זז׀—דצזגזד־װ’זהװ’ךףזומףעֿזֿױזמךזץ’פזזגזדְזזזלִזׂצזדזזךזךףז”וÞִ”׳—’כפ–ßִÿב—זזזגזדְזזזטצהצצזדזזֲßזצְזקÝג׀ג׀ךֽגפּךײ‏הצֱ•ˆזּגזזזמזאקˆÞזֲגהײ׀זקזוִזן—זעסזצנהסצךגְָךוצציפ׀ְעדעװצזז—ױל׀זˆקÞװױךףזובזִאמÞמֹםֽע—יÝ‏ÝךִֿנוßזֽמֿגצךÝמו“ףזֳ”ִךדזֲןְכ•אדֿמפדזע‘בÿֹֻ’ÿָנבÿ”ֻ’ÿ“עוצˆ‘ˆױ“זזצו׀זזזוְֽלױזוךזםּזעה׀׀ףזז“ידב‏םדצ—הזז׀יד—ָאד׀—ױגךצזק—ױßודגגך—ץטףג׀לצג–ךִֽ•יץג—מÞמןיףִÿגץצÿבֽךוֽׁ׳יץך‏מְװ‘׃ְְֲגףגקדוגÞזִָׁבְ’ִזׁ•־לצ׀ןזזזוזו“זזזןְזײװזא׀זצהמיהץִדא׀ֻנזץ‏םסץזםהְךוגזעודו‏אדצגףזְּטדצ–לוֿךילÞׁגגךצץגּֽזקÝצßהװױגףּץטץג’ךףזֻוÞג–יÝ‏–יה‏ֽמְִאוÞִ•ךÝמנבץצקזףךÞיÝ‏”זֲז“ˆֶֹ—ֿג’דטפצֶאץ‏׳ױּ’ְֶָױÞםץעקב“ײלדכךֲעיילו׀ˆוִָֻףÊןװֿגךםצזזזצזױˆˆמו׃זלױזהִזםעזÿהו׀כסץֶהֻצגה׀ֱּוצציפִֽֿדעּקזז—ױל׀זˆקÞװױגףּ’ךףזֻבזִאמÞמ–ידךÞבֽךÞיÝ‏–יה‏ֹם־ךֹיֽע—ם־ך־וÞִ•ךÝמÿבֿעעוß“וזֵץנףֹץßלזÊא—זÊמּּ“אף‏ו׳Ý׀ÿִֽצך׳סנלץ’ֲצÝִֶד’טפצ’כÞ׃הטסעםוז“—ֳֽז’ֶ׀פּיה‏ׂעף—ִס׀זהזז׀זזזןֳזײװזהְזיזה–זא׀ְךו׀–סה׀צלה׀׳סזזָיו׀עהדגָךהזּךפְצודפׁגל׀זˆקÞװצßהװ’גּֽ’ךףזֻמßעֽיפג–זףךץךÞךץז׀ןֳ‎—’זגכנֲ•ײÊ׳ײעזו׀ׁ“זסֽײזזזזצזְˆˆמוׂ׀ל”זה‏זמגזףבזיעגוִםס־ךדה־ךגגז—דפץװךדפׁגזדˆלÞװץטףג׀זצִאל׀גןבִֿנבß“ובץצןו־ך־יףצÝךֿ‏Ýךִֽ•יףצֹם־ך־יףצ”ךÝמ”זֵװֹווקאל–ִײצÞְְבֻםךִמז׳ן–“סץהִ־‎–בָו•ˆףאֿעהװבָםסְקאףגֹצ—םׂצ—זלד‘ך—ֳװטÞ“מזˆמֶזזזהזהכˆְן‎זױךזבְזּזדבזןץגףאסצגמ׀ֻעאץךידצ׀בוז—ץבßיזגװמן׀–לב׀זילÞװצßוגפטצזˆק—ױלßגפטףג׀םץצןו־ך־םÞ‏–ידִ•ךßִאו׀‏ןיֽךÞבß‏ןיהך־ו׀‏ןוֿעעבß‏Ýךְן‎טד׃ֳֻדװ׀ֳןײÝזֹץץסוםכטֻּÝכֻׂםןִֿױדצְֵםּׂ”א‎וצ•סףֱם—ֲֿזפףעÞכף‘ְװ—ןד־זסיסßזנצזוזוףˆזןאז׳—זדזזֲצזגהזךודזוסה׀ךלזזװגזצ׀זקÝˆגלßמ’גץמ’טףג׀זצךֽגÞך־ו׀‏ןםÝ‏”מצןא–—ןמ•Þ—ֵגו“ץב־‏וְֳליˆנװהנֿ‏יכ׀ְß‎זזדזדֹˆְןהזײװזן׀ז׳זד‏זקעזÊלה“ֽסזצ—הסצעמ׀ָעוצצידו׀Êפפז‏הפזײפפ‏צה־‏׀פְְ׀דעָײזז—ױלßדגלßדגלßמ’טצזˆקÞװױגףּ’ךףזֻבזִאמÞמֹםֽע—יÝ‏”ם־ִÊיףצ”יֽךÞבß‏סבזִאוß‏ÿבְך—ם־ך־וֿעעבÝ‏ףיהִÊם׀‏סבוִנךÝמ•זִמיֻסייÝ׀ָב—ץובהְי—׳מךףִײןֽםמֽםֵקֽךׁקֹֱדִֽךÿבגֿםד׀Þק‎ֿפכהְ׳כּװךוװÝטּֿÝטעִ׃לפךֹץףּװןÞג—לֽ׀וץדךיÞףףףˆ׃Ýװ—ה—םהנÝ—ָלÝזזְזֲˆָו—זלױזו‏זםְזÞצולמֻצעאְ׳עדהמיסזצבהץצבוז—בגזּÿאגװצןְ–כאזזילÞװץטףּץטצזˆקÞװױלßג’ךףזובזִאמÞִ•יÝ‏”ם׀‏ֽמ־ִÊיףצ”יֽךÞבְִ–גהך־ו׀‏סבוִנךÝמ•יÝ‏ו—ןוÝװצקזסֿךםזּץץעÝך׀יֽ׃ּÿֹ־ֿÝ׀ִבוָֿץßֿםהְ‏וּכם’ֲßצְׂהָֻזְֽטבסÊץגÊֲ׳־ִוזף“ׂץעÞצֿ—פדזזהזז“זזזהֹזּגזז׀זןזזךזךףזףוÞִ”ג׀ִֹי‘ֳטפ—׃טףּ׃כזֲסֵנ–Ýא–ßִÿצזזזׁˆיˆ•׀ז׳׀םוזזךזדזזכ׃זßכה׀צילÝּזךףזףוÞִ”גßצןםÝ‏”יֽע”׳—’כפÝׂ•גףְפה”מו’ס׃ֵÿק“‘װבֿבעװױסָֿזזצזטזםצוְֽן‏זז‏זבּזלזזךבזצצאצזגאד־װצßומ’טףּזךףז׃זףעֻבצ—וז‏ְזאזˆ׃עול’ץ•ÿÿבלססּזזְזטזכ׀וְֿאׂזזךזו׀זׂצוּוו׀מדזז‎נוזִיסְזדדצךגו׀‏וו׀וזזצזטלßדגגךצץטףּזלÞװ’גץמ’גּֽßךזגֿיפגסמףעֿז‏ֵ־זב“ˆְָוֲזבֲעקםץזזזוזז“זֹזאטזֳךזוְזִצווסוזעיסזךאדצךאזזסזזְזטלצץטףּזלÞװßךזגביפ—ויצעוֽׁ‘זזעףׁזאזזצ׳ׂץבֻעץÊ׀זזזמזדׁˆ•זנָהֹצזֿזהעזצּזֻסו—קהֿ—ץהצ—מגָֿסדßך־דצְּדßךֽםפעמפץָףדצמהְְיפ׀—זדפװױßהװצßודגגץמ’גץמ’גץמ’גּֽץגּֽזקÞװßךזגעו׀‏ןוְִאבץִֽיד‏–יהך־וֿעÿבֿעעו־ך־יףצ•ךÝמÿןְגדוÞִ”זנְָהד‏“גצּהןא‎ײאפ׀ובßִפטא‏“ףפָאָזקÝוהװ׃דד–זכץ‏‏זֽÝֶן‎ךֳאזָÊאומ‎ץדֳפמß“‘ˆֿגקף“זזְזטˆ”—הÞצמ•זגךזעְו׃צגךלב——‏אעְ׀הבצÝכְ–עלד“יאץיעפוךיסג—ךהּ—ֱסזְֱדץ׀‏ץדגֽךגְלךוּלקָּ•כז—ץגְֶץזֶָפץְ‎דעָטפ׀–ממ׀זילÞװױßהװצßהװצßודגגךצץגּֽץגּֽזלßדגלÞװצßהװױגףּץגּֽפטףּßךזגעו׀‏ןוְִאמÞמֹו־ך־יףצ•יÝ‏ÝךִֿנבÝִÝז׀‏ןבדךÿךִֽ•יףצÊםÞ‏ֽמְִאבץזֿךִֽÿו־ך־םֽע—יÝ‏”יִֽ•ךÝמÿבִֿנוÝצֹם־ך־וֿעעךÝמ”יִֽ•זװּןדפּׁלץּךפוִ•צאֿוכ־ְֳםֿמÿגז׃כץְךהכְמ—כהְנןעßׂÝאצײזףוֲÿßו—ֲָעםÞ–פףנגְק–באצ־זקְָךב־ֱֻכ־ְֿןז׀סזצ—ִןדז“צזְבפגֶדי”צֿןזּכמפױצ׀םןצםיץדּ׀ץ־ָֿײ—ֿכˆװצ’מףֽלֽעבמעְֽ•ג׀‏“יע“ֹיץּנןןֳֶע־ְֿכגזזזגזדׁˆיזךזהֱ׀זךזדץזמזךהובצזדזֻעזְצלזֿזזגְזדדזִמףזגךהע׀ווזֻםזצְילÞװױגּֽץטףּזקÝױלßגפטףג׀בÞךץךßעֽמֿעץבו‏זִהÞװָּÊג־ִ”ך׀לÞבהÝ“Þְ‏זזגזדְזזזטצהצצזדזזֲßזזְזקÝג׀ךÞךדךצ׀׳ֽמהצצזזזצזטˆ—ז׀זםˆזז—זכּזֳדסצךה׀׳עזזמםדוזזגְְכדצֳךזזװלףזזההּּןזז—ױלÞװפטץג’זדˆלÞװ’ךףזÿמÝעÝךִֽ•יץג—ל׀ג–ךהÞי־ִךהפֿלװֽךסדְ׀Êזֿ—װבזזוזז“ז—ְב’זֿ“זוְזץ׃׀מבוְץזזצ‏טזהׁגגףּ’ךףזֻמ׀װומßךÝזÿֻ‏ÿסßֶֿÊדפזץÝ’זבךזזזוזזדˆְ׀ן‘ˆמזז׀זףצזָהסצזדדציזזצזטלÝּזלÝּßךזעֿיפגוׁ“אזֱ׳ק׀זזזצזטˆצז–זלקזוּזמגזףזוךמדְ“ץזויםגצָלגץ‏ףפצענדפׁגגךצױזדˆלÝג׀בÞך־םÞ‏זףצֹיֽ—ויד‏Ýוֿ—ובזִנןצגעבßֵעבגמ‎בעםהיבומץעעךגד׀־ןעפיץץזךף‎ץוטז–ֱÊעףדֶֻףכßֱִזזזוזז“זזזזזײגזז׀זט׃ְזמז—ְוזז—ױטצזˆךףזÝמßגÝטÞ—׃זײגזזזגזדׁˆגזיצהֽ׀זנזהץזבץגצזזװזדֿזץוֿיםבצ—לבצװהפצּהדפװצßךצױזדˆלßג’ךףזףוֿ—ובז‏ֽיֽ—וידִÊקצג—םÝךÞבֿ—וביץזיבוןץעסםגף•זפּצץ‏–ןקז–ְּ–ִיגֻה‎ÿְ“‘ק’ץםזזזוזז“זצב“זÿזאְזÝצו—ידִֿגאץָססצּפהצּסוßעÿסצצÿדצוםאץָיפצ“ידפװױטצזױגךףגגךצױגףּ’גץמ’טףג׀זץצןו־ך־כ׀גÊמÞמןוְִֽיִֽ•ךÝמֱזץ‏ÝךֽעÝזÿְ‏א־װ‎אאִםדßצםוצע•ווְֵלּֿץÿßזץמף“ו‏־׀ֱמְ—”וץזםאפ—ְםְָ”הףמזזצוקזהּו‎זממזומזהֵיזזְװטזהװßךהעעמÞמֹם־ִ•ק׀ג•ךÝמסבזִנבß‏ו‎ז—גץßֲÊל–ץמקצצךָה—ׂץִֽטץֶֿÿםע׳גטצ“ץ—דּ’נ׀זוזב׀וְׁד—זװִזגְזÿצז׀אדסִדדצ—יה—ְאה׀—ױגךצזלßדגךףזףבז‏ֽמ־‏–ידִסוֿעעךÝמ•ךÝמנה‏ֵםֽאועßךאאז‏נןצן‘ןהזם”צ׀בֽצ•מזְְזזזוזאזוְׁד“זװִזגְזץצזֻÿוßזיו—ְבזז—ױßזזױךףזףבזִ–יֽע—מÞמאמÞמÊיףצ•ךÝמנמבפגְ‏‏וֿעֲםֿװÊךצם־ִֽמ‏ךֱִֽההזנאÞזזזזהזהגוׁ׀אָזװִזבְזױזדיזןץ—אסÞ‏ֶה־‏אגסִדגצ—ÿמפמאם־ץמןפציגצמוְילßדגלßדגגףּ’טצזױגךףגלßדגךףזובז‏ֽמ־‏–ידִ•יßעאו׀‏סבדךÞיֽךÞבְִעו־ך־םֽע—יÝ‏”בצ‏סבדךÞיֽךÞבְאָלוָÊךהע־טפּצאץגאאצִסןׂֹאפ‏Þם־ך“עץזאאזִסןְןאÞךלדָװלֿגעאומִםß׀מןßִֶמּזֹט־׀ָגßעװקפזממזזזזְזֿזֵוײזכןזוךזלְז׃צו׳ÿלוללוגעס׀ְץדצךגדְְען—ְֳבז—מפז‏זדפׁגלצץגּֽ’טצזױßודגלÝג׀זץצאוÝע•יףצֽמְ‏ֽמ־‏–יד‏Ýךֿ‏ןבזִאוÝע•יÝ‏–יהך־ו־ך־םֽע—יֽךÞבְאָפףֿפגזִ‏וßעֲםßּÊךׂֻמּֽ׳גוּץוּֿןבץ“ָא־‏׀זÊז‘סץמסכד—ְההזנא־םזםÝָ׃לץגסאומִםֿ—מןß‏ֶמÝזזצז“זןזוÞְמדזזװזדױֳזז׀ּטצז‏זד־װזלÝג׀זץצאמÞמÊיףצ•ךÝמנזִ׳–סבץ–ֳסץעֳצג‘סן‎•סבץ–ֳצזזזצזזזך—וßְדזזךזג—זלזֻצזז׀—דצזגזד־װ’זהװ’ךףזֻמףעֿזִֵטְןאÝףזזזזגזזזדקז“׀זˆ׀זדזויזהְםעזזךיז—זוזז“ױטצזױטףג׀םפג–מצטךˆןצדֽך׀זזזוזד׀זלצבפזְְזגְזםװ—זבד׀“זלÝג׀זצ‏ןוְומֽע—יÞ‏ֹםֽע—ךÝמÿבְבפל–צױנצעיָה—װפז“גץÞגוב־סלל–מודְˆפטדִֻבצ’אמזזזזְז–ˆ”‏ו׀זםדזוזלזזßצוװנאוָמוֵּסצמֵהפז־דְßעמְ׀יוזממוָּםםְ—ױטצזˆßהװצßודגלßדגגףּ’טףּßךהעאמÞמֹוÞך”םֽע—יֽךÞבÝִÝוß‏סבז‏ֽמ־ִדבֽךÞיÝ‏”זÞ‏ֽמְִאבץצÿזִוכֳֿצ־ךפמÝֳמוױוֿ“װמÞכבßמֻב•ע־בÝמÊןהב‘בßֻדםהוגֹלעם־׳‏ּא•מוÿÞןאףװפאÝף”צ׀ֳבֽגוזצּ•כ—סײטזזזזְזךˆˆְו‘ְלּזדזפְה‎צב—אץְּÊכדמˆיצעהגְםץֽ׃נודװםטץבעיףמםיץ‎עכויסו‏‎דץגקסגצקדצְמוזְפטץגÿאזװÝיÝצ–צוגנדßװיגָניצּ—פ־ְֽדעֵָךזֵּפּֿÞהץּנאזװנפוג’דעְכץְ—ױלצצßודגלצױלצױגךצצßוגפטץגפטףּץגּֽץגּֽזקÝױגךצױלßדגלßדגלßדגלßגפטץגפטץגפטףג׀םץצןו־ך־ם׀‏ֽמ־‏–ידִ•ךÝמÿיÝצֹם־ִֽיףךÊיףצ”יֽךÞבß‏סבז‏ֽמ־ִÊםÞ‏ֽמְִאבץצÿךßעֽבֿעעוß‏Ýךִֽ•י׀ע—םÞ‏ֽמֿעעךÝמ•זֲָךךא“”סÝצׁןפ‏ִאפְצןזךמוְֳװֶ׀ִׂיאגßםפ׀ֵב־גבזְךללÝמ‎בז׃ְֲג‏ףעּ׳מצװÞˆײָ‎בז׀ׁלוִ׳־זװֶֶֽ—מץ׀Êבץמבגפע“כÞ“׃מ־בֻצגִנאפ“נןßִןץ׃םדִ׀ÿה—ףןדם“מßךאלגזןוצעÊםהמזזזמזטֱˆ׀זס׀הּצוהזבזזֶעוזזֿצאא־צ—םֽװׂצג‏Êדּזיאְ“אצזסטד־“ץוֿ‏Êיּוטטעואפףמ’הֽםדפד“ײהֽ’אאגֿממצ׳מפץג‏דעְלןזָלפגךזדפׁגלÞׁגלßדגßהװצßהװצßודגגףּ’טףּזקÞׁגלÞװצÝץג’טץגפטףּßךזגעו־ִ־ם׀ִנבß‏סבז‏ֽמ־ִÊיףצ•ךÝמסבזִעךÝמ–יהוםֽע—יֽךÞבÞ‏ֹםֽע—יÝ‏Ýךִֿנבץצֽמֽע—יִֽ—מÞמאבץצֱזץ‏ןיה‏ֽמֿעעבß‏ÿבֽךÞיְבִךÞָגהצמֹדֿ‎הך־װְםßּףםß׀ץדֳÊיÝצָהצָּדוּֽןÝמÊן־מײםֿמםיßװֻא”וםל”זּטצ׀פלפֳא־זוךÞָזְגהמומֲםֽג•גßִָגßּ־דßֳצפךװעֽצ“לֽ׀הםוגֿםדגֶאץצÿםה׀ֽדץעלאßֶםץ‎ִקבװֽ‎ֽ‏ÿגß“ְםוזזזךזםׁˆÞז׃מה׳זזכזוָזטזואצה—ֵכה—“יֻצ׀ם׀–עמד‏יסזךÿהסצצהצ—דההװ“כפ׀װטגָֽיז–זטוװטפצ‏ףדעּךזז—ױלÞװױגךצצÝץג’זדױלÞװױגּֽ’טףּßךזגעו־ך־םֽע—יֽךÞבְִ—םÞ‏ֽמְ‏סבוִנךÝמ”י־ִןוְִאמÞמÊיףצ”יֽךÞבß‏ֳזפךׂזפך־ו׀‏סבדךÞי׀כפ׀’אפßװֶפִּך”עבי‘ֲ‘‎ףסן׳“סבב“גזצ•לß’ִֿעמנץָיץגגקפ–אםוקעÞ‏ופ׳ןןß׳לפÞךÊץֲ–ִֻ׃ןßנב׃ִנפ‎אגזװם‎ÊוÿיÝךםהßיאכה—ÝכעÊ•סְזהזהגזמצןץזֶזזגזזֿזז•–א׀׳זזְָטזהװצßדג׀םץצֽמ־ִÊםÝ‏”יֽךÞבץצןבß‏ןבהך־םÞ‏ֹיִֽ•ךÝמסבזִÿבְןץה׀צנסאסÊÿצ—דהָומטֳמכוו‎ע‎נ‎ֳדצךלְגְ’כזװנעֻ׳‎נז׀כה‘ֶֻפֿגכבֻםֶנסְךה׀ׂ׳נָּזזׁˆׂˆˆָוֵ׀לעזוָזמצוÝצגִדןוװפגץיעזוָםזֿ׀ףגסצִגצ–עהßװיסזצאהצצמזזְזאִֿבמזװִוֿמףאֿ‏ÿזץװִוּ׀ואְֻםדפזיפצךלהּ׀דוְ׳םןזךיפצגÿדפװױלÞװױלßגפטץגפטץג’טץגפטץמ’גץמ’זדˆלÞװױגך—צßהװץגּֽץגּֽßךזעֽגפךץמÝעÞיÝ‏זפמ–ידִ•ט׀גסמְ‏סגץצנך׀ךץמְִאבץצוֵ”—׀ֱףזיה׳“װם–ֽנכו׀ִכטךבְאזָֽֲומףדֽכ“׳בעּמזֳכֱ“ֵכו“וÿצג‎לץ–הּצזזזצזזךְז”זב׳זזװזדױֳ‏ז׀ּיףז‏זדפװזלÝג׀גßצאמÞמÊיףצ•ךÝמנ”ה“־מ־“ׁמפגׁזץּ־כÞ־מפׁזזמזמ׀זֿזֳךוָזזצזהגזדֵעֲדעזגדצ“זלßדגךףזֻוְִאמÞמ–ידוםֽע—ךÝמÿבְִאו׀‏ֽמֽע—ק׀גÊיףצÝךִֿנזֳך’ֵÞִגהÝֻמְזָגדג׳‎טנֹוזװ’פמזלוזßל“Ýם׳ם׀װפפסײָדזװךפאּÞֶפִכגֶֻּײז׀כדגְזוזזֻˆˆמהÝְלּזזָזדְזֲזהגזßְֵזטהׂ‘זו׀זג׀זלְזןוה‘זזמזז׀זלְזזֿה“זזֽצְׂזכזזךזזֿגפטֵָזדצזףזו׀ץגֽÊ“זזךצׂזזט—כְזד־“זוךצׂזזנ—כְזב־“זזךצׂזזֱ—כָזמזזנזזמץגֽÊ‘זהגזבְזהגץמ’זכְזהÞ“זוָׁׂזזךכָזהְזזזדװױׂזזלגכָזןְזקזדװױׂזזֲגכְזזוה“זזףצׂזזֲגכְזגֳה‘זוְזדזזכגץמ’ׂזזלגכְזןה‘זהזזדזזכגץמ’ְׂזֿזז׀זהßגפטףזßםפךסמÝעֽיץךÝגףךדזפךםזפך–ךֽעץיהך־וÝע”בßגעך׀ע–ו׀כטי—ֶ—ÞÞ”עֱ“ךצןבˆ׳נˆיצִבם”‏טטצב׃ֿ–׳ֶנֽגוהׁזֿןףְלÞˆÊָ‏מזגדאְ—ÿי׀קײפפףװכזזזזךזןˆˆÞזָׂה׳זז‏זו׀זכזהפצבמהזץָככו—נבצג‏ןצז‎ןהְ׳ןֿ—זם־צקלפְֹספצָדפָםסו—ֱהסצֳכז—זבסעובצֻסהציאְְוהזמדדוע‎וֿװֿןצ‏ײמ־גּכז‏ײםגָֿלְ—‏זץםלוֿמילßדגßהׁגגץמ’גץמ’גץמ’גּֽפטףּ’טףּזקÝױלßדגלÞװצßהׁגגךצץגּֽץגּֽץגּֽ’גץמ’גץמ’גץמ’גץמ’ךףזֻוÞך–יÝ‏–יה‏ֽמְִֹקְגÝךֿ‏סבזוךÝמ”ז׀גֽהצגֽיףמ–גףצֽמְִ–יßִץבדךה‘־ÿ‏ֻגײןֳָֽאץיאקÝיםסב‎’מßהוˆֽ“ßזִÿ׃כ–ו׀עְֳֹ“’ססעÿֶ–ְ׀ןÞ’אדֽ“’טֽםוע–עֵזּֽףְלÞˆÊָ‏מזגדאְ—ÿי׀קײפצזוזזקˆˆמהÝְלּזזָזדְז—זדִזְזטהׂ“זדְְׁׂזהזזךזטÞׂ“זזמצׂזזמ—כָזה׀זדזזמץגֽÊ“זזךצׂזזט—כְזד־“זדְצׂזזֳ—כְזןפ“זזˆִצץװזוְזקזו‏זד׀זÊזזזיְזקזג‏זד׀ונזזז‎ְזקזן‏זד׀האזזזְֻזקזל‏זד׀ה•זזזßְזקזז–ֳצצעז–צזקזטעזד׀זהÿְֵזןץה“זוןצׂזזץכְזןץה“זדקצׂזזÝכְזזßה“זדÿצְׂז•זדךזזֿגפטֵָזי׀זÝזזמץגּֽזׂזזךכָזכצזÊזדװױׂזז׃גכָזהְזזזדװױׂזזלגכָזא׀זףזדװױׂזזֵגכְזזוה“זזףצׂזז׃גכְזהה“זזָצׂזז–—דזßםפךסמÝעֽיץךÝגףךדזפךםזץצןו־ך־יףצ•ךÝמנךÝמ–יה‏ֽוÞִ•יףצֽמְִאוÞִ•ךÝמÿבֿעעוß‏ויצִהÝֳֽא׃ךװׁי–ןקֽגוßֱעףדםלףוצקדָֽקפףךײב׀בְטץ—סדֿ‏‎כסִ’ןּֿסְגֿׂ–׳ֶנֽגוהׁזֿןףְלÞˆׂסהםßָÝדßעֹצ־ּׂזß—ֳידמצהß“פÿß—‏ןהװ׳ןׁ‘Þװכזזזצוכˆˆו”זאץזזװזז׀זßךזגןב׀ִֹוÞִ”םÝִÿי׀ןִּ׳ג”ּ‎מ•ּ׳מ•ּ׳ךונ’טץי׳אףי’לףי׳לפזזזדזוˆְמנזְצזה׀זקזוװזכעזִדץּטד׀ßÿגßּםסצ׀קדסִדהצ—ףהגװנגזּנפ׀‏זדפׁגל׀זˆלÞװױגץמ’גּֽßךזגעו־ך־םֽע—יֽךÞבֿךֿיפגןבז‏ֽמ־‏–יד‏Ýךֿ‏וע־מנבÞזְבßִֿßק“מזֱֽגמֿ‏ÿמהזÿבÞגוÞß‏ְןßִÿמ־כּכÞב־זֱבßִ־מְזזזצז“זןזוÞְמדזזװזדױֳזז׀ּטצז‏זד־װזלÝג׀זץצאמÞמÊיףצ•ךÝמנזִ׳–סבץ–ֳסץעֳצג‘סן‎•סבץ–ֳצזזזְז“זזגהֲצמָזז׀זאצו’צגעבוְמו׀ךכדומאדצ“זגßמאבועןבִֿפבצֳנגִֿיד׀‏זדֻ‏דו׀ֻ‏דְ‏יז׀ְבווךךזזָ‎דצ’לבֿךיב׀ֳלדְ—יפְצןדעָלזז—ױלÞװצßהװץגּֽץגּֽץגּֽזקÞװױגךצצßהװצ