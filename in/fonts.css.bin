עצךÝמ”יְןן•ןָ’כÞְ–ְÝבסאפִיו–צˆפסָ”ָֿ‏׃יזגעˆׂ‎ִףמאקץֻ—ֳאפֳÿךםהבֲפסדˆִׁדוזזוזאׁˆְבÿזֻעזבצזׁצוָמהֿזקס׀ָקדצגךהֿזצזזְופֿךגהֿךזפְגזדפװצßהװצßודגגך—זקÞװצßוג’ךףזֻוÝצ•יףצֹםֽעאמÝִ•יÝ‏”בßצאבץצנזסֳׁהזךדסÞְץךועֹאסעאו׀ּףלֶך׳לעֿקמץׂד׀ּקג׀Þßֽמׂׂצזוזז—זזזאÞזּװזאזזׁצו׀ÿבצגפסְװךהצװםסְ“םהֿעזס׀גזהצ“גזצßלוץמיל׀זˆקÞװצßהװצßהׁגגץמ’ךףזֻוÞג”זדע—םÞ‏ֽמְִ”יֽךÞבß‏סבזובֽךÞזֵמֵˆֹ‏לזץזֿאפוץטֿ׳מי—ִßטּ‘עִזװÝִ”יאזץסטןז—לגא—פןÞץדףבÞׂהצזזזצזיˆˆִוßצםכזוזיּז־וßגםבֿםנבßצלסßְפהֻ‏ץןז–סוזּםא׀צ‏ווִגוז׀ֵפְ—זדפװ’זדˆקÝױלÞװױגףּץגּֽßךהעעו׀‏ֽמ־ִ”בֽךÞיÝ‏–יהִÊמÝִÊמÞמןק׀גÞבִֿןבִֿנזִסלצב׳ְֳדבּץÝגְםסצײÿמצ“ך־ִÞםםְךֵץ•ןÿהְ׀ײב‏ßל־בִיֿצÿכÝסה׃ּמוֹךןהְכ׀ההגÊזזמזדֱˆ•זֳזהףזזפזועזץעזױבז׀ססֿךבהֿךזסְגזדצ׀גה׀צגדזךיפֿךפהץךבפֿצצהץצגפְךגהְךהפְעהדפװצßהװצßהװצßהװזקÝˆקÞװצßהװ’גּֽßךהעןמßִןיÞג”יִֽ•יßִאו׀‏סבוִֽם׀ִו—ז׃כז–“בˆּׂמ‎גיןמֻּדזְמהסְט׀–Ê‎׀הֹ׳ֱֿב–ֽק׀‏קטעז“ב‎ׁÞְזוזז”ˆזא–זּ‏זן׀וזצהּןגצּנאב‏סאְ׳ÿבץִלסֿגֵדסעגהצּסוזציבְוםאֿעלאֿ׃לגֿװיפְ—זדפװױגךצױגךצזקÝױלÞװױטףּץגּֽßךהעעו׀‏ֽמ־ִ”בֽךÞיÝ‏–יהִÊםÞך—יֽעֿוÞ‏קזִֿנבß‏ו׃ע׃גÿבֻּד–׃טיפ‏׃לוְֲֿצָוִץ‏•עמִאֽב‏ֻלכ–‎טדצֶ‏ֽמ‎ןףמÝגזָהי““ִצ‏וזָזדזֿֽזזמזדקˆ“ז‎הסְזקזוָזיגזֱה׀—ףסְך‎הסעףדצ—לוצּגז׀—כהזָצהוסלוֿעיפֿזזדפװױגךצצßוג’זדˆקÞװױגץמ’ךףזֻבז‏ֽמ־‏–ידהוÝ‏Ýךֿ‏ןיה‏ֽמֿעעבß‏Ýךְאֱֱבםלֲ”םֳִל—ֹמסיÊעÊֿוטדצׁפדֶ•ץֹֿÝפסֶßּזׁׁהÊֿצאךץ־ּÊזזזוזז”ˆְןוזּ‏זה׀זֲצוגמה׀סÿזזָלס׀זבהְצךז׀—זוזזˆקÝױלßמ’טףג׀זצךאד׀גףמ־‏ֽמְִ”זִבץ־ֻ׃”וץץבב׃־ןצםאˆׂלֱּ׀ו•׀צמֲצזזז׀זלˆˆ‏וֹ׀םפזוִזמְזװזדֿזםס‏דל׀ֻסםפגיסץזִהֿזבז׀׀נפץְעדעֲּדצֲָה׀װֹפצִֹדעּֽזז—ױלßדגגךצױלצזקÝױלÞװßךהעעו־ך־םÞ‏–ידִ•יÞ‏–יד‏Ýךִֿנבץצןב־ִ—םÞ‏ֽמֿעעבִֿ•בÝצֹוֿעעבß‏Ýךְאֱֲּ’פקדְאÞםג‏ּֿמךףßכֶאְÞםֻֽזצ•ג׃ליך•צףץןףֵץיִףמ–עהמײמß‏“ך—ֿ׃ןהידץÝ׀סִףצ‎בהװיץךֳ•ָּאףסומß׀זזזמזדֱˆ”ז‎הסזזצזוװזךגזֳוץָןסְ“סהֻעןאְ—טוצצךז׀—גוצםלהִֿיזָּץזז—ױßהװץטףּזקÝˆלÞװץגּֽßךזגעד׀מ”ו־ך־םֽע—יÝ‏Ýךֿ‏ןיהִÊמÞמסבו‏Ýךְאֱִֻßßױפִֿענֳוקּ’לֲ•ז—כ—ְ–‎—ג“ז‎ֿנװ‏כצ׳׳עע—‘טÿטבץ־ּÊךּוְזזזהזז”ˆ‘צדלזֱָזז׀זןזזךזךףזףוÞִ”ג׀ִֹי׳ְנֻ׳ְ‏ב–ֳז‎׃־‏אןעÊיֿ‏זזזזְזיˆְז•זמֽזזךזה׀זט׃—זןהז’להְעיל׀זױךףזףוÞִ”ג׀ִאוÞִ•ק׀ן‏ףּ’טףדךֶֽצָ–דßּו׃•׳׃ֱֶ‘‘ֹ•—‎בֿ׃טְ׀זוזז—זֻזאיזֳּזוְזנצזָזז׀עווז‎זזצ‏טלßדגגּֽ’טצזßךה—ויפעסדצגוֱֽ‘זז‏ד–ְגײֻן‎ֳִּ׃ÿסְזהזז—ז׀זאבזֵמזז׀זןזה’זאצגןזְךזוֻעגו׀–סזזךיז׀צןוְגןזגזוזז“ױגךצצßוג’טצזױלÝּץגּֽפטףג׀זפג–מץעֿיפגוֱֿ‘מזÿֽ־זב“זנםצֻגזזזגזדצהִז‏—ו—׀זאזהבזבבעגוצ–עז׀‏יסצגהדצךאזזסזזְזטלצץטףּזלÞװױךףזווףע׃זףעבז‏”ְזבהˆױ“וְזגלֵּסנסעֳװזזמזדצזזזףה׃זזֻזהּזלּזÿהּזכא׀“Êג׀ָֹלפּלןזװכפז—לדעּףזז—ױלצצßץדגגךצץגּֽזלצßךזגעד׀גאו׀‏ןוְהםֽע—יÝ‏”יֽע—םÞ‏ֹכְגֹק׀געבß‏ÿבִֿנבß‏דוÞִ”זףבןצװׂםפ‏ÿוצֲִדÝךְקÞמßוב‎באצִ”אדִטןה‏Êכְ‏הּֽ“ˆט׀ן“בצ’צןֿװעבז“ÿםזֳצופװÿדץ׀צןץ—צזץִףגץיׁהדךסוצּךדץצְהˆ’יע–ֿפזזמזדׁזװצהיְוזזגזֵגוגוßעִבֳֿבךְֻעיפ“יסהךדץִץסגעץדסצםפְּםסזעִדףךְךֳֿםטפְימ—עבפוֿוהְֶֿפץ‏ÿהץ‏ֶץצֳםה—ְיפצִֶדעְְזז—ױלÞװצßודגלßדגלצצßהװצßוג’זהׁגלÞװצßהװױגףּץגּֽפטףּßךזגעוְִאמÞמֹו־ך־יףצ”יִֽ•ךÝמÿבִֿ”ך׀ךאוßצÝךִֽ•יףצÊמÞמאו׀‏סבוִנבß‏Ýךִֽ•יßִאמÞמֹםֽע—יÝ“וךÝמנוÝצֹם־ך־וֿעעךÝמ”יִֽ•זװץגלוÝץßגÝצ•ְֿמה“ֹן־ְץבֿזכפעעוזפװׁםףֶטֳבְׂלהגװכסמ׀כג—ױטףעקנ’ם‘ֵןָָךװָֿ־‘ןÝהְ—נלס“ׁםÞגֵדו‏והֽלמאץיגץ‏מ–קדּֿןזּלמפֹצװןמד‎טץןפץֶסםבÿ–׳גץÞזפהצ׀־ב—יֶ‎׳ֳזפס–ָÿך‎בוֻ“נבמָמ־׃פזזזוזז”ˆÝצהזֹזדצזװצוּדזְציזזצהגזזפזזךמפ׀גיהעװווזֻםזצְילÞװױגףּ’זדˆÝץדיגץמ’ךףזÿמßגÝבפך־בצךעבß‏זֵ‘ßװעֹּזצּכלדעÝזױמסלˆ”ֽם׀װטזזגזדצזזזטצהצצזדזזֲßזזְזקÝג׀ךÞךדךצß׳ֽגהצצזזזצזיˆ—זְׁםˆזז׀זכגז‎דזָכזְזכגזזפו׀ָךוּװזהְ׳כזזמלפצ‏זדפװױלßמ’גףּזקÝצÝץדיטףג׀בÞך–ךÝמ•יץג—ל׀ג–ך‘ßיÞִףלגÊßךßע‏לזמֳלßעזזזגזדצדץזÿּהןצזאזוא”זְעאוגזווְ“זלצץטףּßךהעֽה׀גֽגÝךוֲסֳֻÿסÊב‏יגוןקּזע׀זזזגזזקדז‎ֵˆ׀ְזדזויזהְםסזזךיז—זוזז“ױטצזױטףג׀ופג–מצאנˆÊָוֹֻ—ˆזזזוזז”ˆßזדפזָ—זאְזְצוךזבזְטדßגזג—ּפהְָפבßץםוץִילצצßהװזקÝױךףזÿמÞמֹםֽ—ויהִ•קצג—יÝ‏Ýוֿ—ובזִנןצגעבßֵפג—מ‎בּבוןß׃לץּ‎אדוזמץ–גִּֽטדג‘פפוּÿדס‘ÿעץמךנםצׂבß“זזצזיזזזזקזלÞזזךזדױ‏זהזימזצזילÝּזקÝג׀ךÞךץךÝ׀ׁכ׀לÞזזזוזז”ˆßזדפזָ—זב׀זּצועץגזזכזז“צגצ‏ףפועיהֿעכזְּםזְ—ױגךףגל׀זˆקÞװץטףג׀ג׀‏ֳזץצאמÝ‏זףצ”םֽ—ויהִÝךֿ‏סבßצנ—ֽÝעּֿבץעּקצףעוא׀ג׳דֲּטץÝװיÿ’ץÿדץיצֻ–ךי—אפםÞָזזזגזדצד—זÿ‏וְֱזÿזדסזןְזצג׀װךבצצÿג–עםגזּםג׀ִףבסעגבצ–מדזװיפוִזדפװױזהװצßךצצßהװץטץגפטףּץגּֽßךזגעו׀‏ֽמ־ום־ך־בפך•יÝ‏ÝךֿובֽךÞיצב•אוָװבֻֿÊד׀ָÊי׀ע‏ןהָ‏גב“ףדפךו‎פ—ְםז—•הדצ׃מה‏םיְװßזזזוזגזלצבּזְְזגְזםװ—זהה׀“זלÝג׀םץצֽמ־ִÊםÝ‏ˆזף‏Ýךֿעעוß‏ÿבְבּדצץןב‘‏ױסגְוזÞְכפ’אי׀’אב׳ִֻפּצ’דֿןצטףֵֻזזגזÿזאזקצהß׀זפזוֳזדז‏יסְךידצ—כפז‏כדפװצßזזױגךצßךוךעו־ך־םֽע—יßעאבץצÝךֽ‏Ýךֵֿ—םֿװÊך‏בףג׀‏‏וֿ‏ֳזֱִָמד“ֳֹדזניד‏ְההזזזזגז‏זאזקְהß׀זפזובזהס‏ןגז—ןפזעזדפׁגזהװßךוךעוÝע•יףצֽמְ‏ֽמ־‏–יד‏Ýךֵֿ“ְסמפוְֿאבץ“ÊאÞ‏ßזÊםÞךְֿÞיßממו‏ֵמד“זזזמזמצאˆזְֶהß׀זנזהװזך—זֳןצ‎נםָֿלםְ‏ץסְךץדץִֿמְ‏Êםגְֳםז—ץד—ְאד׀—ױגךצױגךצץטףּ’זהװצßךצױגךצßךזגעו־ך־םֽע—יÝ‏”בצ‏ןוֿעעךÝמ•ךÝמנוßצאמÞמÊיףצ”יִֽסוֿעעךÝמ•ךÝמנזְֶָא־‏׀םפמ’לץז‎גצ‏‎וßעֲÞִ‎םֽמÊמÝֿץגז‏‏וßעֲזֱ—ֵמÝ“ָט־׀ײגץצ‏גֿ׀ֹןזְֱבßָ־צהִ‘כהְףבפ׀מזְְזזזהזהגוׁ׀אָזװִזג׀זײזה–זאֻ‏ָן׀ָָגץץנהוגיז׀צטהוצֱפו—עדצֿמוְזילצױßוגפטףּ’זהׁגגךצױךףזובז‏ןיף‏–יהך־ו־ך־םֽע—יֽךÞבְִעו׀‏ןיף‏”יֽע—מÞמאמÞמÊיףצ•ךÝמנזֶֿםטבמצוßְןבץ“ֹאפ‏ÞÞע־טפּצאץגאאצִסן־ְֶםֽזה‏ד׳סגֿעװקפזממו‏ֶמּזֹט־—׳גץע‏גֿ׀Êןצְֱבָֽֿק׀זוזדְזִזןלזְךזה׀זט׃—זדהצ’זוְזטל׀זױךףזובז‏ֽמ־‏–יד‏Ýךֿ‏וÞֹסעסןס–סבץ–זף׳עֳֹ‎עסןס–זזזוזזזזÝצןאזק—זז׀זףצזָהסזזדדציזזצזטלÝּזלÝּßךהעֿיפגוßׁ“‘זִֵיךזזזזצזזזךדֽזדˆזזךזג—זלזֻצזז׀—דצזגזד־װ’זהװ’ךףזֻמףעֿז“ÝֳזטךÝÝזזזזגזקזז׳זסמההזזפזזÊÝצזעקדְזױךףזווְִאד׀ג־יףצ”ם־ִÊיףצÝךִֿנזסמױסה׃‎וצ•ְכפßמדְץןמצגנםעָױעְגטדמ“טס׀סדּ‏ְזזזהזדÿˆְֳןזזּךזן׀זָזדבזאß‏‏ןÞְְאץ׃סזֿװםמהמטדבצ־דז—גזְְאפצּÊדפװ’זדˆגלßדגגךצױגךצץטףּ’טףג׀םצ‏ֽמ־ִןמÝִÊיףצ•ךÝמÿיÝךןבֿעעו־ך־ם׀ךנךÝמ”יִֽדם־ך־ו׀‏סבוִו׀ג׃•בהמßמֽי—ְאװאן־׀ֽכ—װÿג־עÿ‎פמÿך־‏ִמÿָÿאעךּמגפִ׳צÊלֻֽׂצֵ‏ְבֱמִ‎טßמֵיקֳדו—נךצגוהף‏ׁץנָ“זזזהזזÝˆזןײזײצזק׀ולזםֻזÿצ‎אפה‏װךֽ–ד–צמפזֻאט–‏גט׀ּ’גסצ–ךְּ–בֻצװן׀–עבּֿיגצעץזיהזְגהומ’גץִ‏הÝך”ידסזגץ‏קאÝװ—פֿ‏–הףץללהךיפֿװ׀הץ׃לאףמםאץ‏‏הß‎מגףּיפז׃אדפװױßודגגךצױßהװױßהװצßודגגץמ’גץמ’טץגפטץגפטצזˆקÞװצßהװױגךצױגךצױגךצױגץמ’גץמ’גץמ’ךףזֻבזִאמÞמֹו־ך־םֽע—יÝ‏Ýךִֿ”יהִÊםÞך–ךÞ‏–ידִ•ךÝמÿבֿעעו־ך־םÞ‏ֹם־ך־ו׀‏סבוִÝבפךנבץצןבֽךÞיÝ‏”וףצֹם־ך־בץצÝךֽ‏ו‘ְ׀׀ֳֵֽÿיהֳםֿ׀‎לוזִז׀ְאו•ßױוÞ“—‏ףגֻכוװנמצעהז׀ָױךּֿעה”–‘זץֿיפפּֿהÝכײּֿעדהָבÞÊמהß׳ײקף“ֿןה‏סגְעץםףְׁכ־—־מנסזץß‏‎כֿ‏ֱןß׀ֳןÞ—ּיÝוִכץךִךְֹֽג׀‏ָצזִבופ‏ּמְזזזְז’ˆˆזוÿזלץזגמזעזו׳צגזהבז‏ֶםדצÊטÞ’זץ־‏טצז—ֶדְ‎זוע“טכֿגאב־‏•צג“’צג‎מךּֽלךּימק־ָלקּ‏‏פגְֿהּֿמגץְיפזִָהְ׳מצ׀זילצױלצױגךףגלßדגלßדגגךצץטףּ’טצזˆלצױלßדיגףּ’גץמ’טףג׀זץצאםÞמֹוß‏ÿבֿעעו־ך־םÞ‏–יד‏ÝךֿעעוßצÝךֽע—כ׀גÊיףצ•ךÝמÿם־ִÊיףצ”יֽךÞבß‏סבהך־יףצ•יÝצֽמְ‏סבוובְִ—ם־ך־בץצÿבִֿנךÝמ•זס׀Ýלְצםז־ִטבּמÞלÞזֹאץךֹןד–גי•‏”יהְםהפְךאפךֱך־‏ֲמ־ָÊגְּ”אÞעִֵגּױִהצ’דומ׳כß—ֶמזגÝלֽ—הזצמְגֿ“Êךף‏ףבÞְףאפמקןß–ומÞßפידְײקזמּגפגּךץָ‎בוִּכהךיבצֵָןßָֻבֻ׀נÞיÊיִֿףן־זּן׀זזז׀זÊˆˆמה—ְלּזזװזאְז“זג‎זכץװװכףְ•צדזֹדּזְיְ’עזßִםסוזםדצךמלÝְ׃כה׀“פפך—דעז“א׀’מוֿךיפז׀זדפװױלÞװצßודיגףּזקÞװױלÞװפטףּ’טףג׀זץצאמÞמÊיףצ•ךÝמנוÝצֹם־ך־וֿעעבß‏Ýךִֽ•ם׀ִאו׀‏ֽמ־‏–ידִ•ךÝמÿבֿ—ומÞ“ומÞמןוֿעעךÝמ”ז׃כדּ‎כאß׳לץ׀Ýֳצע”׳׳ֻיעֲֹֿעעÿְצוד‏ױןÊבßצֽ’‎ןÞְ–גצצכע‏ּן“ףםְבלֱִּאּ׳כמÞ‎בנסÞ—ֱן׃‏נ–ß‎םּ‏צה׀ֻÊ‏בִ”ך׀ּכג—‏װכףך׃פֵ‎נזזמזמצזֿזֳגוָזזצזהגזדֵעֵהּזההְ“זלßדגךףזֻבהך־םÞ‏ֹיִֽ•ךÝמסבזִÿבְִעמÞמֹם־ִ•יÝ‏Ýךֿעעוßִנזֳגכוו‎ע‎נ‎ֳדצךלְגְ’—ְװגבֻץֻ‎ֻ—יז׀ײזפדּװהß‎פנֻֻ‏דזװכײס׳לגצװנעֻ׳‎נז׀כה‘ֶֻפְזהˆˆְבׁז׳צזאְזֿזאזצְךִאßמץגßָזזֿ׀ףגעזִגצ’זהßװטוְצמזזְזאִֿבמזװִוֿמףאֿ‏ÿזץװִוּװואְֻםדפזיפזךלהּװדוְ׳מןזךיפזגÿדפװױלÞװױלßגפטץגפטץג’טץגפטץמ’גץמ’זדˆÝפװױגך—צßודיגץמ’גץמ’ךףזבמßגֽגפך–ךִֽ•קצג־יףצ”יֽװובפמאבץגעבֽךדגפמןוֿעעזנךן—׀דצײֲכהֳ‏–־׀ִןהÝֽטß‏קוְלמˆÿְפג׀“Þלץסםהזקןפ”אÞ׀ֲזס—ואפֳּצ׳גזזזגזקזדמזי׀וֶצזכזז‘”ס׀ךםדעװאזז—ױזהװßךוךעו־ך־םֽע—יֽךÞב׃׀ׂמ־מׂכÞגֿכ׀ג‎מ־ׁמ־גׁכ׀זהזהךזמצןףזֶזזגזזֿזז•–ןְ–זוז—טזהװצßדג׀םצ‏ןו־ך־יףצˆזפ‏–ידךÞבß‏ןוְִאמÞמ–ידוםֽע—ךÝמÿבְןףטנֹוזװ’פמזלוזßלנףֻׁם׀צכטע־זהְצךפׂךÞֶפִכגֶֻּײז׀כדגֿ׳ךÊֹּהßםםנײְךה׀ßמזזצזבקˆÞזװ“ה—׀זצזוצזלזזױזי•“זדְױְׂזּזוּזטÞׂ“זהצצְׂזצזהָזטÞׂ“זוזצׂזזה—כְזז־“זהָצׂזזג—כְזוה“זהָצׂזזכ—כְזהÞ“זוזצׂזזך—כְזדה“זוזצׂזזט—כְזד־‘זוגזלְזצגץמ’ׂזזּגכְזבֳה“זועׁׂזז‎גכְזב׃ה“זו‏ׁׂזז‎גכְזןיה“זו׀ׁׂזזּגכְזם׃ה“זה‏ׁזכְזמÞ“זומְׁׂזזזזגזטÞׂ“זזזצׂזזוגכְזוֳה‘זוגזגְזֽגץמ’ְׂזִזומזמßגפטְֵזזוה“זהֹצְׂזײזומזמßגפטֵָזל׀זפזהךץגּֽ׀ךפעןמßִןיÞך”יִֽ•יßִאבץצÿז׀גֽהצגןיד‏–יה‏–ו־ך”יִֽ•יßִאבץצנופִןזװ“םי׀םבוך—אץÞצˆןּגבזפקֽגוßֱ‘צעצעגצץ׀ךםזֲגף“גוצאטז“אּףבמןנעֳ‎כ–ע‘וץֿײבןִהזק–טזױכֱ׀“ֲֲו“ִִוּÿעצ׀אדצ׀כ“׀ְֲּ’•ßװצזדזוףˆְכֳז׃ךזאזזִזדזזֲ—ומזָֿÿבצג‎ןה׀Êןֿמזםה‏װל–ִÊל׀—פה–עךה׀ָךדֻעםדְ—סזב‏וזזֶּהזגמזְװסאצעֳאß’ככה‏לכו—ּןּּׂמצָׂןעֲּןצ–םוץמילÞװצßהװצßודגלßג’גץמ’טףּ’זדˆלßדגלßדגלßדגלßדגגףּץגּֽץגּֽ’גץמ’גּֽßךהעןמףִ•יףצֹם־ך־וÝִ•ךÝמÿבֿעעד׀גנךÝמדזפךםזצִ—יֽע—םֽעאמÝִ•יÝ‏”ב׀‏סבו‏ה”ץף”ְֱמאץמÿיףגףטה‏—םהָ’ֵסעםבֻÿקֽגוßֱ‘–עצעגצץ׀ךםזֲגף“גוסֳעך׀’בזָמדסגיבßװßטגטזוְםנˆע“הװׁ’ˆדֿ’“ןֿß׀אץֳץדז‏ידזֽׁהפוזזצזגˆˆÞז׃ְהׁזזצזוצזך׀ז•זעÊ“זדְױׂזז”כָזגזז–זדװױׂזזצגכְזז׃ה“זזמׁׂזז–גכְזויה“זזצׁׂזז–גכְזהה“זזװׁׂזזצגכְזדיה“זז׀ׁׂזזצגכ