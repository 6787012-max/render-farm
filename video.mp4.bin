งงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงฐงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงงงกงง”ิำฤศงงงงงงซUงฅm_งฅiงฅvงฅt{งฅzงฅEงฅBcงฅN๕งฅI[งฅTwงฅRงฅPังคฅฑงคกkงคญนงคซงคดะงคฟญงคผคงคนฮงค…งคกงค9งคจงค‘฿งคงค'งคๅลงค๏หงค๋งค้;งค๖uงคÿพงค๛งค๙@งควงคฬlงคึไงคำงค฿…งคÛiงคุPงค&Xงค"ํงค1มงค<Þงค9Iงค␀งฃธงฃ4-งฃHศงขÝงข&งขภqงขอ6งขห1งข[งขpcงขxไงขCBงขNงขTโงกดงก’nงก;งก๗Zงก๒4งกýษงก/งก,งกนงกIถงกR)งก^งกXธง ฌง ืง ๎กง ๐…ง ร๋ง อ9ง ศ>ง 	—งฏÜ-งฎฦoงฎอsงญฝงญtaงฌ็งฌgงฌzงฌฟงฌ{งฌx=งฌFDงฌLwงซคงซ ฤงซญฝงซซ(งซฝzงซ␀งซhงซ๗บงซ๔–งซýฒงซ๙งซฦÜงซรณงซื|งซิงซูÝ